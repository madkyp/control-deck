#!/usr/bin/env bash
# control-deck — backend of Control Deck, a one-click app installer/manager
# for Arch / CachyOS. Every GUI action maps to a subcommand here, so the whole
# thing is usable (and debuggable) from a terminal: `control-deck help`.
#
# Supported: .AppImage  .pkg.tar.{zst,xz,gz,-}  .flatpak  tarballs  .deb (debtap)
# Progress protocol: plain human-readable lines on stdout/stderr, plus
# KEY=VALUE / JSON outputs for the GUI where noted.
# Exit codes: 0 ok · 2 usage · 3 unsupported / refused · 4 operation failed
#
# The file can be sourced (tests do) without running main.

set -o pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
APPS_DIR="${CONTROL_DECK_APPS_DIR:-${INSTALL_ANY_APPS_DIR:-$HOME/Applications}}"
DESKTOP_DIR="$DATA_HOME/applications"
ICON_DIR="$DATA_HOME/icons"
AUTOSTART_DIR="$CONFIG_HOME/autostart"
UNIT_DIR="$CONFIG_HOME/systemd/user"
STATE_DIR="$DATA_HOME/control-deck"
HISTORY_FILE="$STATE_DIR/history.tsv"
TRASH_DIR="$STATE_DIR/trash"
DL_DIR="$CACHE_HOME/control-deck/downloads"
AUR_URL="${CONTROL_DECK_AUR_URL:-https://aur.archlinux.org}"
NEWS_URL="${CONTROL_DECK_NEWS_URL:-https://archlinux.org/feeds/news/}"
PACMAN_LOG="${CONTROL_DECK_PACMAN_LOG:-/var/log/pacman.log}"
PACMAN_DB="${CONTROL_DECK_PACMAN_DB:-/var/lib/pacman/local}"
SNAPPER_CONFIG="${CONTROL_DECK_SNAPPER_CONFIG:-root}"
SNAPPER_CONFIG_DIR="${CONTROL_DECK_SNAPPER_DIR:-/etc/snapper/configs}"
SNAPSHOTS_DIR="${CONTROL_DECK_SNAPSHOTS_DIR:-/.snapshots}"
INSTALL_INFO="$STATE_DIR/install.env"     # written by install.sh
MARK="control-deck"      # X-Created-By of our launchers ("install-any" = legacy)
SEP=$'\x1f'              # field separator for internal records (never collapses)

# GitHub origin of the file being installed (set by ghinstall / updates) and,
# when updating, the launcher being replaced.
GH_REPO="" GH_TAG="" GH_ASSET="" UPDATE_TARGET=""

log()  { printf '%s\n' "$*"; }
err()  { printf 'ERROR: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
human() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }
# desktop notification (no-op if notify-send is missing)
# the app's own logo (installed by install.sh), by path: more reliable than a theme lookup
deck_icon() {
    local f="$DATA_HOME/icons/hicolor/scalable/apps/control-deck.svg"
    if [[ -f "$f" ]]; then echo "$f"; else echo control-deck; fi
}
notify() {
    have notify-send || return 0
    notify-send -a "Control Deck" -i "$(deck_icon)" "$1" "$2" 2>/dev/null || true
}
# history_add <action> <source> <target> <rc>
history_add() {
    mkdir -p "$STATE_DIR"
    local res=ok; [[ "${4:-0}" -ne 0 ]] && res="error"
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$1" "$2" "${3//$'\t'/ }" "$res" >> "$HISTORY_FILE"
}
# run a command string in a new terminal window (interactive AUR builds, …)
term_cmd() {
    local t
    for t in "$TERMINAL" kitty alacritty foot wezterm konsole gnome-terminal xterm; do
        [[ -n "$t" ]] && have "$t" && { echo "$t"; return; }
    done
}
run_in_terminal() {
    local term; term="$(term_cmd)"
    [[ -z "$term" ]] && { err "no terminal emulator found"; return 4; }
    setsid "$term" -e bash -c "$1; echo; read -n1 -rp 'Done. Press any key to close…'" \
        >/dev/null 2>&1 &
    disown 2>/dev/null || true
}
aur_helper() { command -v paru || command -v yay; }

# ---------------------------------------------------------------------------
# Snapshots before pacman changes. snap-pac already takes pre/post snapshots
# of every pacman transaction; only when it's missing (and snapper has a
# config) does the deck take one itself — inside the same pkexec call, so
# there's still a single password prompt.
# ---------------------------------------------------------------------------
snapper_ready()      { have snapper && [[ -f "$SNAPPER_CONFIG_DIR/$SNAPPER_CONFIG" ]]; }
snap_pac_installed() { pacman -Q snap-pac >/dev/null 2>&1; }
needs_snapshot()     { [[ -z "${CONTROL_DECK_NO_SNAPSHOT:-}" ]] && snapper_ready && ! snap_pac_installed; }

pk_pacman() {
    if needs_snapshot; then
        log "→ taking a snapshot first (snap-pac is not installed)"
        # shellcheck disable=SC2016
        pkexec sh -c 'snapper -c "$1" create -c number -d "$2" -u important=yes \
                          || echo "⚠ snapshot failed, continuing" >&2
                      shift 2; exec pacman "$@"' \
            sh "$SNAPPER_CONFIG" "Control Deck: before pacman $*" "$@"
    else
        pkexec pacman "$@"
    fi
}

# ---------------------------------------------------------------------------
# Format detection — returns a type keyword on stdout.
# Order matters: .pkg.tar.* must win over the generic .tar.* rule.
# ---------------------------------------------------------------------------
detect_type() {
    local f="${1,,}"   # lowercase copy for matching
    case "$f" in
        *.appimage)                                 echo appimage ;;
        *.pkg.tar.zst|*.pkg.tar.xz|*.pkg.tar.gz|*.pkg.tar) echo pacman ;;
        *.flatpak)                                  echo flatpak ;;
        *.deb)                                      echo deb ;;
        *.rpm)                                      echo rpm ;;
        *.tar|*.tar.gz|*.tgz|*.tar.xz|*.tar.zst|*.tar.bz2) echo tar ;;
        *)                                          echo unknown ;;
    esac
}

type_label() {
    case "$1" in
        appimage) echo "AppImage" ;;
        pacman)   echo "Arch package (pacman)" ;;
        flatpak)  echo "Flatpak bundle" ;;
        deb)      echo "Debian (.deb)" ;;
        rpm)      echo "RPM (.rpm)" ;;
        tar)      echo "Tar archive" ;;
        *)        echo "Unknown" ;;
    esac
}

is_supported() {
    case "$1" in
        appimage|pacman|flatpak|tar) return 0 ;;
        deb) have debtap ;;
        *) return 1 ;;
    esac
}

type_desc() {
    case "$1" in
        appimage) echo "Copied to ~/Applications with its real name, icon and categories." ;;
        pacman)   echo "Installed with pacman -U (asks for the admin password)." ;;
        flatpak)  echo "Installed as a user bundle with flatpak." ;;
        tar)      echo "Extracted to ~/Applications/<name>, with a launcher if an executable is found." ;;
        deb)      if have debtap; then echo "Converted to an Arch package with debtap, then installed with pacman."
                  else echo "Debian format: install debtap (AUR) to convert it."; fi ;;
        rpm)      echo "RPM format: not native to Arch, it won't be installed." ;;
        *)        echo "Unrecognised format." ;;
    esac
}

# ---------------------------------------------------------------------------
# detect subcommand — machine-readable KEY=VALUE lines for the GUI
# ---------------------------------------------------------------------------
cmd_detect() {
    local file="$1" t
    t="$(detect_type "$file")"
    printf 'TYPE=%s\n'      "$t"
    printf 'LABEL=%s\n'     "$(type_label "$t")"
    printf 'NAME=%s\n'      "$(basename "$file")"
    printf 'SUPPORTED=%s\n' "$(is_supported "$t" && echo yes || echo no)"
    printf 'DESC=%s\n'      "$(type_desc "$t")"
}

# ===========================================================================
# .desktop helpers
# ===========================================================================

# read a key from the [Desktop Entry] group (first match, unlocalized)
dget() {
    local file="$1" key="$2"
    awk -F= -v k="$key" '
        /^\[/{ ent = ($0 ~ /^\[Desktop Entry\]/) ? 1 : 0; next }
        ent && $1 == k { sub(/^[^=]*=/, ""); print; exit }
    ' "$file" 2>/dev/null
}

# desktop_set <src> <dst> KEY=VAL…  — set keys in [Desktop Entry]; an empty
# VAL removes the key. Setting a key also drops its localized variants
# (Name[es]=…), which would otherwise keep showing the old value in menus.
desktop_set() {
    local src="$1" dst="$2"; shift 2
    local sets tmp kv
    sets="$(mktemp)"; tmp="$(mktemp)"
    for kv in "$@"; do printf '%s\t%s\n' "${kv%%=*}" "${kv#*=}"; done > "$sets"
    awk -v SETS="$sets" '
        BEGIN {
            while ((getline l < SETS) > 0) {
                i = index(l, "\t"); k = substr(l, 1, i - 1)
                val[k] = substr(l, i + 1); ord[++n] = k
            }
        }
        function flush(   j, k) {
            for (j = 1; j <= n; j++) {
                k = ord[j]
                if (!(k in done) && val[k] != "") print k "=" val[k]
                done[k] = 1
            }
        }
        /^\[/ { if (ent) flush(); ent = ($0 ~ /^\[Desktop Entry\]/); print; next }
        ent {
            eq = index($0, "=")
            if (eq > 0) {
                key = substr($0, 1, eq - 1); sub(/[ \t]+$/, "", key)
                base = key; sub(/\[.*$/, "", base)
                if (base in val) {
                    if (key == base && !(key in done)) {
                        if (val[key] != "") print key "=" val[key]
                        done[key] = 1
                    }
                    next
                }
            }
        }
        { print }
        END { if (ent) flush() }
    ' "$src" > "$tmp" || { rm -f "$sets" "$tmp"; return 1; }
    rm -f "$sets"
    mkdir -p "$(dirname "$dst")"
    mv -f "$tmp" "$dst" && chmod 755 "$dst"
}

# write_launcher <file> KEY=VAL…  — new [Desktop Entry]; empty values are skipped
write_launcher() {
    local out="$1" kv; shift
    mkdir -p "$(dirname "$out")"
    {
        echo "[Desktop Entry]"
        for kv in "$@"; do [[ -n "${kv#*=}" ]] && printf '%s\n' "$kv"; done
    } > "$out"
    chmod 755 "$out"
}

refresh_menu() { update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1; true; }

# The meaningful program invoked by an Exec line, unwrapping `env`,
# leading VAR=value assignments, field codes and quotes.
exec_bin() {
    local e="$1" t
    read -ra _toks <<< "$e"
    local i=0
    while [[ $i -lt ${#_toks[@]} ]]; do
        t="${_toks[$i]//\"/}"
        case "$t" in
            env)  ((i++)); continue ;;   # skip the env wrapper
            *=*)  ((i++)); continue ;;   # skip VAR=value assignments
            %*)   ((i++)); continue ;;   # skip field codes
            *)    break ;;
        esac
    done
    echo "${_toks[$i]//\"/}"
}

# absolute path of the program run by an Exec line (empty if not found)
exec_path() {
    local bin; bin="$(exec_bin "$1")"
    [[ -z "$bin" ]] && return
    [[ "$bin" != /* ]] && bin="$(command -v "$bin" 2>/dev/null)"
    echo "$bin"
}

# package owning the program of an Exec line. `pacman -Qo` costs ~70 ms per
# call, so bulk callers prefill PKG_CACHE with one batched lookup.
declare -A PKG_CACHE=()
pkg_cache_fill() {   # absolute paths…
    local line p
    [[ $# -gt 0 ]] || return 0
    while IFS= read -r line; do
        [[ "$line" =~ ^(.+)\ is\ owned\ by\ ([^ ]+)\  ]] && PKG_CACHE["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
    done < <(LC_ALL=C pacman -Qo "$@" 2>/dev/null)
    for p in "$@"; do [[ -v "PKG_CACHE[$p]" ]] || PKG_CACHE["$p"]=""; done
}
pkg_of() {
    local bin; bin="$(exec_path "$1")"
    [[ -z "$bin" ]] && return 1
    if [[ -v "PKG_CACHE[$bin]" ]]; then
        [[ -n "${PKG_CACHE[$bin]}" ]] && echo "${PKG_CACHE[$bin]}"; return 0
    fi
    pacman -Qoq "$bin" 2>/dev/null
}

# packages that are generic wrappers, never the "app" itself
is_wrapper_pkg() {
    case "$1" in
        coreutils|bash|sh|dash|zsh|filesystem|glibc|systemd|util-linux|\
        which|env|sudo|wine|wine-staging|wine-stable|proton|dosbox|dosbox-staging|dosbox-x)
            return 0 ;;
        *) return 1 ;;
    esac
}

# resolve an Icon= value (name or path) to an actual file, or empty
resolve_icon() {
    local ic="$1"
    [[ -z "$ic" ]] && return
    local r; r="$(resolve_icon_fast "$ic")"
    [[ -n "$r" ]] && { echo "$r"; return; }
    [[ "$ic" = /* ]] && return
    # last resort: first hit anywhere in hicolor
    find /usr/share/icons/hicolor -type f -name "$ic.*" 2>/dev/null | head -1
}

# fast icon resolver for the list — direct dir/ext checks only, no find fallback
resolve_icon_fast() {
    local ic="$1"; [[ -z "$ic" ]] && return
    if [[ "$ic" = /* ]]; then [[ -f "$ic" ]] && echo "$ic"; return; fi
    local d s
    for d in "$ICON_DIR" \
             "$ICON_DIR/hicolor/scalable/apps" \
             "$ICON_DIR/hicolor/256x256/apps" \
             "$ICON_DIR/hicolor/128x128/apps" \
             "$DATA_HOME/flatpak/exports/share/icons/hicolor/scalable/apps" \
             "$DATA_HOME/flatpak/exports/share/icons/hicolor/256x256/apps" \
             "$DATA_HOME/flatpak/exports/share/icons/hicolor/128x128/apps" \
             /var/lib/flatpak/exports/share/icons/hicolor/scalable/apps \
             /var/lib/flatpak/exports/share/icons/hicolor/256x256/apps \
             /var/lib/flatpak/exports/share/icons/hicolor/128x128/apps \
             /usr/share/icons/hicolor/scalable/apps \
             /usr/share/icons/hicolor/256x256/apps \
             /usr/share/icons/hicolor/128x128/apps \
             /usr/share/icons/hicolor/64x64/apps \
             /usr/share/icons/hicolor/48x48/apps \
             /usr/share/pixmaps; do
        for s in png svg xpm; do
            [[ -f "$d/$ic.$s" ]] && { echo "$d/$ic.$s"; return; }
        done
    done
}

# coarse source for the list (no pacman lookup — kept fast)
# coarse_source <path> <exec> [X-ControlDeck-Type] [X-Created-By]
coarse_source() {
    local path="$1" exec="$2" cdt="${3-__read}" cby="${4-__read}"
    case "$path" in
        *"/flatpak/exports/share/applications/"*) echo flatpak; return ;;
    esac
    [[ "$exec" == *"flatpak run"* ]] && { echo flatpak; return; }
    [[ "$cdt" == __read ]] && cdt="$(dget "$path" X-ControlDeck-Type)"
    [[ -n "$cdt" ]] && { echo "$cdt"; return; }
    [[ "$cby" == __read ]] && cby="$(dget "$path" X-Created-By)"
    [[ "$cby" == install-any ]] && { echo appimage; return; }
    case "$path" in
        "$HOME/"*|"$DESKTOP_DIR/"*) echo user ;;
        *)                          echo system ;;
    esac
}

is_game_shortcut() {
    case "$1" in *steam://*|*lutris:*|*heroic://*|*com.heroicgameslauncher*) return 0 ;; esac
    return 1
}

# refined source (used on selection / uninstall) — may hit pacman
refine_source() {
    local path="$1" exec="$2" cs
    cs="$(coarse_source "$path" "$exec")"
    case "$cs" in flatpak|appimage|tar) echo "$cs"; return ;; esac
    # game/store shortcuts launch a shared client — don't map them to that package
    is_game_shortcut "$exec" && { echo user; return; }
    local bin; bin="$(exec_bin "$exec")"
    # Wine / Proton / DOSBox launchers → not a native package
    case "$exec" in *WINEPREFIX=*|*.exe*|*.lnk*) echo wine; return ;; esac
    case "$bin" in wine|wine64|*/wine|*/wine64) echo wine; return ;; esac
    case "$bin" in dosbox|dosbox-x|*/dosbox|*/dosbox-x) echo dosbox; return ;; esac
    # native binary → owning package (ignoring generic wrappers like coreutils/bash)
    local pkg; pkg="$(pkg_of "$exec")"
    if [[ -n "$pkg" ]] && ! is_wrapper_pkg "$pkg"; then echo pacman; return; fi
    echo "$cs"
}

flatpak_appid() {
    local path="$1" exec="$2"
    # try the appid embedded in the Exec line
    local id; id="$(grep -oE 'flatpak run [^ ]*[[:space:]-]*([A-Za-z0-9_]+\.[A-Za-z0-9_.]+)' <<<"$exec" \
                    | grep -oE '[A-Za-z0-9_]+\.[A-Za-z0-9_.]+' | tail -1)"
    [[ -n "$id" ]] && { echo "$id"; return; }
    # fall back to the .desktop basename (flatpak names them by appid)
    basename "$path" .desktop
}

# "user" or "system" installation of a flatpak app (empty if not installed)
flatpak_installation() {
    flatpak list --app --columns=application,installation 2>/dev/null \
        | awk -F'\t' -v id="$1" '$1 == id { print $2; exit }'
}

# ===========================================================================
# Install from file
# ===========================================================================

# "Obsidian-1.6.7-x86_64" → "Obsidian" · "curseforge-latest-linux" → "curseforge"
clean_base_name() {
    local n
    n="$(sed -E 's/[-_. ](x86[-_]64|amd64|x64|aarch64|arm64|i[3-6]86|linux(64)?)//Ig
                s/[-_ ]v?[0-9]+([._][0-9]+)+.*$//
                s/[-_ ](latest|release|stable|portable)$//I' <<<"$1")"
    case "$n" in ""|.|..) n="$1" ;; esac
    echo "$n"
}

slugify() {
    local s="${1,,}"
    s="${s// /-}"
    s="$(printf '%s' "$s" | tr -cd 'a-z0-9._-')"
    s="${s##[-.]}"
    echo "${s:-app}"
}

# file extension of an image, sniffing the content when the name has none
img_ext() {
    local f="$1" b="${1##*/}"
    if [[ "$b" == *.* ]]; then echo "${b##*.}"; return; fi
    case "$(head -c 8 "$f" 2>/dev/null | tr -d '\0')" in
        $'\x89PNG'*) echo png ;;
        *)           echo svg ;;
    esac
}

# save an icon file as the managed icon of a launcher slug; prints its path
store_icon() {
    local file="$1" slug="$2" ext
    [[ -f "$file" ]] || return
    ext="$(img_ext "$file")"
    mkdir -p "$ICON_DIR"
    rm -f "$ICON_DIR/control-deck-$slug".*
    cp -fL "$file" "$ICON_DIR/control-deck-$slug.$ext" 2>/dev/null && echo "$ICON_DIR/control-deck-$slug.$ext"
}

appimage_extract() { (cd "$2" && "$1" --appimage-extract "$3" >/dev/null 2>&1); }

# old AppImage runtimes dlopen() libfuse.so.2; the newer static ones don't
appimage_needs_fuse2() { head -c 1048576 "$1" 2>/dev/null | grep -aq 'libfuse\.so\.2'; }
have_fuse2() { ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2 '; }

# keys a user edited on an existing launcher, kept across reinstalls/updates
# prints KEY=VAL lines (Name, Icon, Categories, NoDisplay, Terminal)
preserved_keys() {
    local f="$1" k
    [[ -f "$f" && "$(dget "$f" X-ControlDeck-Edited)" == true ]] || return
    for k in Name Icon Categories NoDisplay Terminal; do printf '%s=%s\n' "$k" "$(dget "$f" "$k")"; done
}

# ---------------------------------------------------------------------------
# AppImage: reads the embedded .desktop so the launcher gets the real name,
# icon, categories, WM class and mime types; stored under a stable name
# (~/Applications/<app>.AppImage) so a new version replaces the old one.
# ---------------------------------------------------------------------------
install_appimage() {
    local src="$1"
    local base; base="$(basename "$src")"
    mkdir -p "$APPS_DIR" "$DESKTOP_DIR" "$ICON_DIR"

    # stage inside APPS_DIR (same filesystem → atomic mv later). Files already
    # in our managed dirs are moved, anything else is copied.
    local stage="$APPS_DIR/.control-deck-staging-$$.AppImage"
    case "$src" in
        "$APPS_DIR/"*|"$DL_DIR/"*) mv -f "$src" "$stage" ;;
        *) log "→ Copying $base…"; cp -f "$src" "$stage" ;;
    esac || { err "could not copy the file"; rm -f "$stage"; return 4; }
    chmod +x "$stage"

    log "→ Reading AppImage metadata…"
    local tmp; tmp="$(mktemp -d)"
    local root="$tmp/squashfs-root"
    appimage_extract "$stage" "$tmp" '*.desktop'
    local dsk; dsk="$(find "$root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -1)"
    if [[ -L "$dsk" ]]; then   # usually a link into usr/share/applications
        appimage_extract "$stage" "$tmp" "$(readlink "$dsk" | sed 's|^\./||')"
        [[ -f "$dsk" ]] || dsk=""
    fi

    local e_name="" e_comment="" e_cats="" e_wm="" e_icon="" e_exec="" e_term="" e_mime="" e_ver=""
    if [[ -n "$dsk" ]]; then
        e_name="$(dget "$dsk" Name)";      e_comment="$(dget "$dsk" Comment)"
        e_cats="$(dget "$dsk" Categories)"; e_wm="$(dget "$dsk" StartupWMClass)"
        e_icon="$(dget "$dsk" Icon)";      e_exec="$(dget "$dsk" Exec)"
        e_term="$(dget "$dsk" Terminal)";  e_mime="$(dget "$dsk" MimeType)"
        e_ver="$(dget "$dsk" X-AppImage-Version)"
        log "→ Embedded .desktop: $(basename "$dsk") (${e_name:-no name})"
    else
        log "⚠ The AppImage has no .desktop: using the file name"
    fi

    local name="$e_name"
    [[ -z "$name" ]] && name="$(clean_base_name "${base%.[Aa]pp[Ii]mage}")"
    local slug; slug="$(slugify "$name")"
    if [[ -n "$UPDATE_TARGET" ]]; then
        slug="$(basename "$UPDATE_TARGET" .desktop)"; slug="${slug#appimage-}"
    fi
    local dest="$APPS_DIR/$slug.AppImage"
    local desk="$DESKTOP_DIR/appimage-$slug.desktop"

    # icon: the one named by Icon= (svg, else the largest png), else .DirIcon
    local icon_file=""
    if [[ -n "$e_icon" ]]; then
        appimage_extract "$stage" "$tmp" "$e_icon.*"
        appimage_extract "$stage" "$tmp" "usr/share/icons/hicolor/*/apps/$e_icon.*"
        appimage_extract "$stage" "$tmp" "usr/share/pixmaps/$e_icon.*"
        icon_file="$(find "$root" -type f -name "$e_icon.svg" 2>/dev/null | head -1)"
        [[ -z "$icon_file" ]] && icon_file="$(find "$root" -type f -name "$e_icon.png" -printf '%s %p\n' 2>/dev/null \
                                             | sort -rn | head -1 | cut -d' ' -f2-)"
    fi
    if [[ -z "$icon_file" ]]; then
        appimage_extract "$stage" "$tmp" '.DirIcon'
        if [[ -L "$root/.DirIcon" ]]; then
            local t; t="$(readlink "$root/.DirIcon")"
            appimage_extract "$stage" "$tmp" "${t#./}"
        fi
        icon_file="$(readlink -f "$root/.DirIcon" 2>/dev/null)"
        [[ -f "$icon_file" ]] || icon_file=""
    fi
    local icon_val; icon_val="$(store_icon "$icon_file" "$slug")"
    [[ -n "$icon_val" ]] && log "→ Icon saved to $icon_val"
    [[ -z "$icon_val" ]] && icon_val="${e_icon:-application-x-executable}"

    # keep the embedded Exec arguments (e.g. --no-sandbox %U), swap the program
    local args=""
    [[ -n "$e_exec" ]] && args="$(sed -E 's/^[[:space:]]*("[^"]*"|[^[:space:]]+)//' <<<"$e_exec")"
    [[ -z "${args// /}" ]] && args=" %U"
    # …unless the user edited the launcher: then their prefix (env VAR=…) and
    # arguments win; only the quoted AppImage path is swapped
    local prefix=""
    if [[ -f "$desk" && "$(dget "$desk" X-ControlDeck-Edited)" == true ]]; then
        local oe; oe="$(dget "$desk" Exec)"
        if [[ "$oe" =~ ^([^\"]*)\"[^\"]*\"(.*)$ ]]; then
            prefix="${BASH_REMATCH[1]}"; args="${BASH_REMATCH[2]}"
        fi
    fi

    # a previous version of this app (other file name) or a legacy install-any
    # launcher pointing at the same AppImage is replaced, not duplicated
    local old lf lbin
    if [[ -f "$desk" ]]; then
        old="$(dget "$desk" X-ControlDeck-File)"
        [[ -n "$old" && "$old" != "$dest" && -f "$old" ]] && { rm -f "$old"; log "→ Removed previous version $(basename "$old")"; }
    fi
    for lf in "$DESKTOP_DIR"/*.desktop; do
        [[ -f "$lf" && "$lf" != "$desk" ]] || continue
        [[ "$(dget "$lf" X-Created-By)" == install-any ]] || continue
        lbin="$(exec_bin "$(dget "$lf" Exec)")"
        [[ "$lbin" == "$APPS_DIR/$base" || "$lbin" == "$src" ]] || continue
        old="$(dget "$lf" Icon)"
        [[ "$old" == "$ICON_DIR/install-any-"* ]] && rm -f "$old"
        [[ -f "$lbin" && "$lbin" != "$dest" && "$lbin" == "$APPS_DIR/"* ]] && rm -f "$lbin"
        rm -f "$lf"; log "→ Migrated old launcher $(basename "$lf")"
    done

    mv -f "$stage" "$dest" || { err "could not move it to $dest"; rm -rf "$tmp"; return 4; }
    rm -rf "$tmp"
    log "→ AppImage at $dest"
    if appimage_needs_fuse2 "$dest" && ! have_fuse2; then
        log "⚠ This AppImage needs FUSE 2 and it isn't installed: install «fuse2» (MANAGE → select it → FIX)."
    fi

    # user edits (name/icon/…) survive reinstalls and updates
    local keep=() edited=""
    mapfile -t keep < <(preserved_keys "$desk")
    [[ ${#keep[@]} -gt 0 ]] && { edited=true; log "→ Keeping your changes (name/icon/categories)"; }

    log "→ Creating launcher $(basename "$desk")"
    write_launcher "$desk" \
        "Type=Application" "Name=$name" "Comment=$e_comment" \
        "Exec=$prefix\"$dest\"$args" "Icon=$icon_val" "Terminal=${e_term:-false}" \
        "Categories=${e_cats:-Utility;}" "StartupWMClass=$e_wm" "MimeType=$e_mime" \
        "X-AppImage-Version=$e_ver" "X-Created-By=$MARK" "X-ControlDeck-Type=appimage" \
        "X-ControlDeck-File=$dest" "X-ControlDeck-Github=$GH_REPO" \
        "X-ControlDeck-Version=$GH_TAG" "X-ControlDeck-Asset=$GH_ASSET" \
        "X-ControlDeck-Edited=$edited"
    [[ ${#keep[@]} -gt 0 ]] && desktop_set "$desk" "$desk" "${keep[@]}"

    refresh_menu
    log "✔ AppImage installed. Find it as \"$(dget "$desk" Name)\" in your launcher."
}

# ---------------------------------------------------------------------------
# Arch package via pacman (root through polkit)
# ---------------------------------------------------------------------------
install_pacman() {
    local src="$1"
    log "→ Installing with pacman (admin authorization required)…"
    if pk_pacman -U --noconfirm -- "$src"; then
        log "✔ Package installed with pacman."
    else
        err "pacman failed (missing dependencies or authorization cancelled)."
        return 4
    fi
}

# ---------------------------------------------------------------------------
# Debian package → converted with debtap, then installed with pacman
# ---------------------------------------------------------------------------
install_deb() {
    local src="$1"
    have debtap || { err "debtap (AUR) is needed to install .deb files"; return 3; }
    [[ -d /var/cache/debtap ]] || { err "debtap has no database yet: run  sudo debtap -u  first"; return 4; }
    local tmp; tmp="$(mktemp -d)"
    cp -f "$src" "$tmp/" || { rm -rf "$tmp"; return 4; }
    log "→ Converting with debtap (this can take a while)…"
    if ! (cd "$tmp" && debtap -Q "$(basename "$src")"); then
        err "debtap could not convert the package."; rm -rf "$tmp"; return 4
    fi
    local pkg; pkg="$(find "$tmp" -maxdepth 1 -name '*.pkg.tar.*' | head -1)"
    [[ -z "$pkg" ]] && { err "debtap produced no package."; rm -rf "$tmp"; return 4; }
    log "→ Built $(basename "$pkg")"
    install_pacman "$pkg"; local rc=$?
    rm -rf "$tmp"
    return $rc
}

# ---------------------------------------------------------------------------
# Flatpak single-file bundle (user scope, no root)
# ---------------------------------------------------------------------------
install_flatpak() {
    local src="$1"
    log "→ Installing Flatpak bundle (user)…"
    if flatpak install --user -y "$src"; then
        log "✔ Flatpak installed."
    else
        err "flatpak install failed (missing runtime? try adding Flathub)."
        return 4
    fi
}

# ---------------------------------------------------------------------------
# Generic tarball: extract to ~/Applications/<name> and, when a main
# executable can be identified, create a launcher with an icon for it.
# ---------------------------------------------------------------------------
is_elf() { [[ "$(head -c4 "$1" 2>/dev/null | tr -d '\0')" == $'\x7fELF' ]]; }

# best candidate for the main program of an extracted app
tar_find_exec() {
    local dir="$1" slug="$2" f b bn score best="" bestscore=-1
    while IFS= read -r f; do
        b="${f##*/}"; b="${b,,}"
        case "$b" in
            *.so|*.so.*|*.dll|*.txt|*.md|*.json|*.png|*.svg|*.desktop|*.py|*.pak) continue ;;
            *sandbox*|*crashpad*|*crash*handler*|*uninstall*|*updater*|*helper*) continue ;;
        esac
        if is_elf "$f"; then score=5
        elif [[ "$(head -c2 "$f" 2>/dev/null)" == '#!' ]]; then score=3
        else continue; fi
        bn="${b%.sh}"; bn="${bn%.x86_64}"; bn="${bn%.bin}"
        [[ "$bn" == "$slug" || "$bn" == "${slug//-/}" ]] && score=$((score + 100))
        [[ ${#bn} -ge 3 && ( "$bn" == "$slug"* || "$slug" == "$bn"* ) ]] && score=$((score + 40))
        [[ "${f%/*}" == "$dir" ]] && score=$((score + 10))
        [[ "${f%/*}" == "$dir/bin" ]] && score=$((score + 8))
        (( score > bestscore )) && { best="$f"; bestscore=$score; }
    done < <(find "$dir" -maxdepth 2 -type f -perm -u+x 2>/dev/null)
    echo "$best"
}

# best icon inside an extracted app: named like the app, or *icon*/*logo*
tar_find_icon() {
    find "$1" -maxdepth 4 -type f \( -iname '*.png' -o -iname '*.svg' \) -printf '%s\t%p\n' 2>/dev/null |
    awk -F'\t' -v s="$2" '{
        n = tolower($2); sub(/.*\//, "", n); sc = 0
        if (index(n, s)) sc += 50
        if (n ~ /icon|logo/) sc += 20
        if (sc == 0) next
        if (n ~ /\.svg$/) sc += 5
        sc = sc * 1e10 + $1
        if (sc > best) { best = sc; p = $2 }
    } END { if (p != "") print p }'
}

install_tar() {
    local src="$1"
    local base; base="$(basename "$src")"
    local raw="$base"
    raw="${raw%.tar.gz}"; raw="${raw%.tar.xz}"; raw="${raw%.tar.zst}"
    raw="${raw%.tar.bz2}"; raw="${raw%.tgz}"; raw="${raw%.tar}"
    local name; name="$(clean_base_name "$raw")"
    local slug; slug="$(slugify "$name")"
    if [[ -n "$UPDATE_TARGET" ]]; then
        slug="$(basename "$UPDATE_TARGET" .desktop)"; slug="${slug#tar-}"
    fi
    local dest="$APPS_DIR/$slug"
    local desk="$DESKTOP_DIR/tar-$slug.desktop"

    mkdir -p "$APPS_DIR"
    local stage; stage="$(mktemp -d "$APPS_DIR/.control-deck-staging-XXXXXX")"
    log "→ Extracting $base…"
    if ! bsdtar -xf "$src" -C "$stage"; then
        err "could not extract the archive."; rm -rf "$stage"; return 4
    fi
    # a single top-level folder is flattened into ~/Applications/<name>
    local items root="$stage"
    shopt -s nullglob dotglob; items=("$stage"/*); shopt -u nullglob dotglob
    [[ ${#items[@]} -eq 1 && -d "${items[0]}" ]] && root="${items[0]}"

    if [[ -d "$dest" ]]; then rm -rf "$dest"; log "→ Replaced the previous version at $dest"; fi
    mv "$root" "$dest" || { err "could not move it to $dest"; rm -rf "$stage"; return 4; }
    rm -rf "$stage"
    [[ "$src" == "$DL_DIR/"* ]] && rm -f "$src"
    log "→ Extracted to $dest"

    local exe; exe="$(tar_find_exec "$dest" "$slug")"
    if [[ -z "$exe" ]]; then
        log "✔ Extracted. No obvious executable found: have a look in $dest"
        return 0
    fi
    log "→ Main executable: ${exe#"$dest"/}"
    local icon_val; icon_val="$(store_icon "$(tar_find_icon "$dest" "$slug")" "$slug")"
    [[ -n "$icon_val" ]] && log "→ Icon saved to $icon_val"

    local keep=() edited=""
    mapfile -t keep < <(preserved_keys "$desk")
    [[ ${#keep[@]} -gt 0 ]] && edited=true
    write_launcher "$desk" \
        "Type=Application" "Name=$name" "Exec=\"$exe\"" "Path=${exe%/*}" \
        "Icon=${icon_val:-application-x-executable}" "Terminal=false" "Categories=Utility;" \
        "X-Created-By=$MARK" "X-ControlDeck-Type=tar" "X-ControlDeck-Dir=$dest" \
        "X-ControlDeck-Github=$GH_REPO" "X-ControlDeck-Version=$GH_TAG" \
        "X-ControlDeck-Asset=$GH_ASSET" "X-ControlDeck-Edited=$edited"
    [[ ${#keep[@]} -gt 0 ]] && desktop_set "$desk" "$desk" "${keep[@]}"
    refresh_menu
    log "✔ Installed with launcher \"$(dget "$desk" Name)\"."
}

# ---------------------------------------------------------------------------
# install subcommand
# ---------------------------------------------------------------------------
install_file() {
    local file="$1" t
    [[ -f "$file" ]] || { err "file not found: $file"; return 2; }
    t="$(detect_type "$file")"
    log "File:    $(basename "$file")"
    log "Format:  $(type_label "$t")"
    log "─────────────────────────────────────────"

    case "$t" in
        appimage) install_appimage "$file" ;;
        pacman)   install_pacman   "$file" ;;
        flatpak)  install_flatpak  "$file" ;;
        tar)      install_tar      "$file" ;;
        deb)      install_deb      "$file" ;;
        rpm)
            err "$(type_label "$t") is not a native Arch/CachyOS format."
            err "Look for a .pkg.tar.zst (AUR), Flatpak or AppImage of this app."
            return 3 ;;
        *)
            err "Unrecognised format. Supported: AppImage, pkg.tar.*, flatpak, tar.*, deb"
            return 3 ;;
    esac
}

cmd_install() {
    local name; name="$(basename "$1")"
    install_file "$1"; local rc=$?
    history_add install "$(detect_type "$1")" "$name" $rc
    return $rc
}

# --- detectmany / installmany: batch queue ---------------------------------
cmd_detectmany() {
    local f t
    for f in "$@"; do
        t="$(detect_type "$f")"
        printf '%s\n' "$f" "$(basename "$f")" "$t" "$(type_label "$t")" \
                      "$(is_supported "$t" && echo yes || echo no)"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 5) as $i |
        {path:$l[$i], name:$l[$i+1], type:$l[$i+2], label:$l[$i+3], supported:$l[$i+4]}]'
}

cmd_installmany() {
    local total=$# ok=0 fail=0 f
    log "Install queue: $total file(s)"
    log "═════════════════════════════════════════"
    for f in "$@"; do
        log ""
        log "▶ $(basename "$f")"
        if cmd_install "$f"; then ((ok++)); else ((fail++)); fi
    done
    log ""
    log "═════════════════════════════════════════"
    log "Summary: $ok ok, $fail failed."
    notify "Batch install" "$ok ok, $fail failed"
    [[ $fail -eq 0 ]]
}

# --- fetch: download a URL into the cache, prints FILE=<path> ---------------
urldecode() { local s="${1//+/ }"; printf '%b' "${s//%/\\x}"; }

download() {
    local url="$1" name
    name="${url%%[?#]*}"; name="$(urldecode "${name##*/}")"
    [[ -z "$name" ]] && name="download"
    mkdir -p "$DL_DIR"
    log "→ Downloading $name…" >&2
    if curl -fL --retry 2 -sS -o "$DL_DIR/$name.part" "$url"; then
        mv -f "$DL_DIR/$name.part" "$DL_DIR/$name"
        log "→ Downloaded ($(human "$(stat -c %s "$DL_DIR/$name")"))" >&2
        echo "$DL_DIR/$name"
    else
        rm -f "$DL_DIR/$name.part"; err "could not download $url"; return 4
    fi
}

cmd_fetch() {
    local f; f="$(download "$1")" || return 4
    printf 'FILE=%s\n' "$f"
}

# ===========================================================================
# App management over .desktop entries
# ===========================================================================
APP_DIRS=(
    "$DESKTOP_DIR"
    "$DATA_HOME/flatpak/exports/share/applications"
    "/var/lib/flatpak/exports/share/applications"
    "/usr/share/applications"
    "/usr/local/share/applications"
)

# visible .desktop files, user entries overriding system ones with the same name
app_files() {
    local seen=" " dir f bn
    for dir in "${APP_DIRS[@]}"; do
        [[ -d "$dir" ]] || continue
        for f in "$dir"/*.desktop; do
            [[ -f "$f" ]] || continue
            bn="${f##*/}"
            [[ "$seen" == *" $bn "* ]] && continue
            seen+="$bn "; echo "$f"
        done
    done
}

# --- list: JSON array of visible application entries -----------------------
cmd_list() {
    local files=()
    mapfile -t files < <(app_files)
    [[ ${#files[@]} -eq 0 ]] && { echo "[]"; return; }

    # one awk pass over every file; \037-separated so empty fields survive `read`
    local name path exec icon type nodisp hidden cdt cby edited src hid
    awk '
        function out() {
            printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", prev,
                v["Type"], v["NoDisplay"], v["Hidden"], v["Name"], v["Exec"], v["Icon"],
                v["X-ControlDeck-Type"], v["X-Created-By"], v["X-ControlDeck-Edited"]
        }
        FNR == 1 { if (prev != "") out(); prev = FILENAME; ent = 0; delete v }
        /^\[/ { ent = ($0 ~ /^\[Desktop Entry\]/); next }
        ent { eq = index($0, "="); if (eq > 0) { k = substr($0, 1, eq - 1); if (!(k in v)) v[k] = substr($0, eq + 1) } }
        END { if (prev != "") out() }
    ' "${files[@]}" |
    while IFS="$SEP" read -r path type nodisp hidden name exec icon cdt cby edited; do
        [[ "$type" == "Application" || -z "$type" ]] || continue
        [[ "${hidden,,}" == "true" ]] && continue
        hid=0
        if [[ "${nodisp,,}" == "true" ]]; then
            # only apps the user hid through the deck stay listed (to unhide them)
            [[ "$path" == "$DESKTOP_DIR/"* && "$edited" == true ]] || continue
            hid=1
        fi
        [[ -z "$name" ]] && name="${path##*/}"
        src="$(coarse_source "$path" "$exec" "$cdt" "$cby")"
        printf '%s\n' "$name" "$path" "$icon" "$exec" "$src" "$(resolve_icon_fast "$icon")" "$hid"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 7) as $i |
        {name:$l[$i], path:$l[$i+1], icon:$l[$i+2], exec:$l[$i+3], source:$l[$i+4],
         resolved:$l[$i+5], hidden:($l[$i+6] == "1")}] | sort_by(.name | ascii_downcase)'
}

# --- sizes: disk usage per app (program + user data), JSON {path:{app,data}} --
# Slow-ish (du over data folders), so the GUI runs it after the list is shown.
flatpak_sizes() {   # appid<TAB>bytes
    have flatpak || return
    LC_ALL=C flatpak list --app --columns=application,size 2>/dev/null |
    awk -F'\t' '{
        s = $2; gsub(/\xc2\xa0/, " ", s); split(s, a, " "); m = 1
        if (a[2] ~ /^k/) m = 1000; else if (a[2] ~ /^M/) m = 1e6; else if (a[2] ~ /^G/) m = 1e9
        printf "%s\t%d\n", $1, a[1] * m
    }'
}

cmd_sizes() {
    local f exec src fsz pksz d total app p file dir i
    local pkgs=() paths=() apps=() pk=() datas=() files=() bins=()
    fsz="$(flatpak_sizes)"
    # only what the list shows; owners of every program looked up in one go
    mapfile -t files < <(cmd_list | jq -r '.[].path')
    for f in "${files[@]}"; do
        p="$(exec_path "$(dget "$f" Exec)")"; [[ "$p" == /* ]] && bins+=("$p")
    done
    pkg_cache_fill "${bins[@]}"
    for f in "${files[@]}"; do
        exec="$(dget "$f" Exec)"; src="$(coarse_source "$f" "$exec")"
        app=0; p=""
        case "$src" in
            appimage)
                file="$(dget "$f" X-ControlDeck-File)"; [[ -z "$file" ]] && file="$(exec_bin "$exec")"
                [[ -f "$file" ]] && app="$(stat -c %s "$file")" ;;
            tar)
                dir="$(dget "$f" X-ControlDeck-Dir)"; [[ -d "$dir" ]] && app="$(dir_bytes "$dir")" ;;
            flatpak)
                app="$(awk -F'\t' -v id="$(flatpak_appid "$f" "$exec")" '$1 == id { print $2; exit }' <<<"$fsz")" ;;
            *)
                is_game_shortcut "$exec" || p="$(pkg_of "$exec")"
                is_wrapper_pkg "$p" && p=""
                [[ -n "$p" ]] && pkgs+=("$p") ;;
        esac
        total=0
        while IFS= read -r d; do [[ -n "$d" ]] && total=$(( total + $(dir_bytes "$d") )); done < <(find_leftovers "$f")
        paths+=("$f"); apps+=("${app:-0}"); pk+=("$p"); datas+=("$total")
    done

    # one pacman call for every package size
    pksz=""
    if [[ ${#pkgs[@]} -gt 0 ]]; then
        pksz="$(LC_ALL=C pacman -Qi "${pkgs[@]}" 2>/dev/null | awk -F': ' '
            /^Name/ { n = $2 }
            /^Installed Size/ { split($2, a, " "); m = 1
                if (a[2] ~ /^KiB/) m = 1024; else if (a[2] ~ /^MiB/) m = 1048576; else if (a[2] ~ /^GiB/) m = 1073741824
                printf "%s\t%d\n", n, a[1] * m }')"
    fi
    for i in "${!paths[@]}"; do
        [[ -n "${pk[$i]}" ]] && apps[i]="$(awk -F'\t' -v n="${pk[$i]}" '$1 == n { print $2; exit }' <<<"$pksz")"
        printf '%s\n%s\n%s\n' "${paths[$i]}" "${apps[$i]:-0}" "${datas[$i]:-0}"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 3) as $i |
        {key:$l[$i], value:{app:($l[$i+1]|tonumber), data:($l[$i+2]|tonumber)}}] | from_entries'
}

# --- appinfo: KEY=VALUE detail for one .desktop ----------------------------
cmd_appinfo() {
    local f="$1"
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    local name exec icon src pkg
    name="$(dget "$f" Name)"
    exec="$(dget "$f" Exec)"
    icon="$(dget "$f" Icon)"
    src="$(refine_source "$f" "$exec")"
    printf 'NAME=%s\n' "$name"
    printf 'EXEC=%s\n' "$exec"
    printf 'ICON=%s\n' "$icon"
    printf 'RESOLVED_ICON=%s\n' "$(resolve_icon "$icon")"
    printf 'CATEGORIES=%s\n' "$(dget "$f" Categories)"
    printf 'NODISPLAY=%s\n' "$(dget "$f" NoDisplay)"
    printf 'TERMINAL=%s\n' "$(dget "$f" Terminal)"
    printf 'SOURCE=%s\n' "$src"
    printf 'GITHUB=%s\n' "$(dget "$f" X-ControlDeck-Github)"
    printf 'AUTOSTART=%s\n' "$(autostart_enabled "$f" && echo true || echo false)"
    case "$src" in
        pacman)
            pkg="$(pkg_of "$exec")"
            printf 'PKG=%s\n' "$pkg"
            printf 'ACTION=Removes the package %s with pacman -Rns (asks for the password).\n' "$pkg" ;;
        flatpak)
            printf 'APPID=%s\n' "$(flatpak_appid "$f" "$exec")"
            printf 'ACTION=Uninstalls the Flatpak app.\n' ;;
        appimage)
            printf 'APPIMAGE=%s\n' "$(exec_bin "$exec")"
            printf 'ACTION=Deletes the AppImage, its icon and the launcher.\n' ;;
        tar)
            printf 'ACTION=Deletes the folder %s, its icon and the launcher.\n' "$(dget "$f" X-ControlDeck-Dir)" ;;
        wine)
            printf 'ACTION=Wine app: removes the menu shortcut. The program stays in its WINEPREFIX (use «wine uninstaller» to remove it).\n' ;;
        dosbox)
            printf 'ACTION=DOSBox game: removes the launcher and, if its files live in your home, the executable.\n' ;;
        user)
            printf 'ACTION=Removes your .desktop launcher.\n' ;;
        system)
            printf 'ACTION=System entry with no owning package: it cannot be uninstalled safely.\n' ;;
    esac
    static_problems "$f"
}

# Make an icon persistent: copy a chosen file into our managed icon dir so
# it survives even if the original source file is later moved/deleted.
# Prints the value to store in Icon= on stdout; progress goes to stderr.
persist_icon() {
    local target="$1" icon="$2"
    [[ -z "$icon" ]] && { echo ""; return; }
    # themed icon name (not a path) → already persistent via the icon theme
    [[ "$icon" != /* ]] && { echo "$icon"; return; }
    # already inside our managed dir → nothing to do
    case "$icon" in "$ICON_DIR/"*) echo "$icon"; return ;; esac
    if [[ ! -f "$icon" ]]; then
        printf '⚠ icon not found: %s (keeping the path as is)\n' "$icon" >&2
        echo "$icon"; return
    fi
    mkdir -p "$ICON_DIR"
    local slug ext dest
    slug="$(basename "$target" .desktop | tr ' /:' '___')"
    ext="${icon##*.}"; [[ "$ext" == "$icon" ]] && ext="png"
    dest="$ICON_DIR/control-deck-$slug.$ext"
    if cp -f "$icon" "$dest" 2>/dev/null; then
        printf '→ icon copied to %s (persistent)\n' "$dest" >&2
        echo "$dest"
    else
        printf '⚠ could not copy the icon; keeping the original path\n' >&2
        echo "$icon"
    fi
}

# --- edit: change launcher fields (writes to the user dir, overriding system)
#   control-deck edit <file.desktop> NAME=… ICON=… EXEC=… CATEGORIES=… COMMENT=…
#                                    NODISPLAY=true|false TERMINAL=true|false
#   Empty values leave the field untouched. Legacy form: edit <file> <name> <icon>
cmd_edit() {
    local f="$1"; shift
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    if [[ $# -gt 0 && ! "$1" =~ ^[A-Z]+= ]]; then set -- "NAME=$1" "ICON=${2:-}"; fi

    local target="$f"
    case "$f" in
        "$DESKTOP_DIR/"*|"$HOME/"*) : ;;  # already writable by user
        *) target="$DESKTOP_DIR/$(basename "$f")"
           log "→ System entry: creating an editable copy at $target" ;;
    esac

    local sets=() kv k v
    for kv in "$@"; do
        k="${kv%%=*}"; v="${kv#*=}"
        case "$k" in
            NAME)       [[ -n "$v" ]] && sets+=("Name=$v") ;;
            ICON)       [[ -n "$v" ]] && sets+=("Icon=$(persist_icon "$target" "$v")") ;;
            EXEC)       [[ -n "$v" ]] && sets+=("Exec=$v") ;;
            COMMENT)    [[ -n "$v" ]] && sets+=("Comment=$v") ;;
            CATEGORIES) if [[ -n "$v" ]]; then [[ "$v" == *";" ]] || v+=";"; sets+=("Categories=$v"); fi ;;
            NODISPLAY)  case "$v" in true) sets+=("NoDisplay=true") ;; false) sets+=("NoDisplay=") ;; esac ;;
            TERMINAL)   case "$v" in true|false) sets+=("Terminal=$v") ;; esac ;;
            *) err "unknown field: $k"; return 2 ;;
        esac
    done
    sets+=("X-ControlDeck-Edited=true")

    desktop_set "$f" "$target" "${sets[@]}" || { err "could not process the file"; return 4; }
    refresh_menu
    log "✔ Saved: $(basename "$target")"
    for kv in "${sets[@]}"; do
        [[ "$kv" == X-* ]] && continue
        log "  ${kv%%=*}: ${kv#*=}"
    done
    history_add edit "$(coarse_source "$target" "$(dget "$target" Exec)")" "$(dget "$target" Name)" 0
}

# --- leftovers: user data/config/cache folders that belong to an app --------
# Matched by exact (case-insensitive) folder name against the app id, name,
# WM class, binary and package; generic/shared folders are never proposed.
LEFTOVER_SKIP=" applications icons fonts flatpak themes mime systemd autostart trash keyrings gnupg
 pulse pipewire wireplumber dconf gtk-2.0 gtk-3.0 gtk-4.0 fontconfig hypr hyde kitty control-deck
 install-any quickshell nvim zsh fish bash git ssh menus desktop-directories xdg-desktop-portal
 environment.d sounds color-schemes kde qt5ct qt6ct kvantum wine lutris steam heroic bottles yay
 paru pacman mesa_shader_cache nvidia thumbnails electron python python3 java node mono dotnet
 env sh app apprun appimage chromium google-chrome mozilla flatpak-run "

leftover_keys() {
    local f="$1" exec="$2" src="$3" k v
    local raw=("$(basename "$f" .desktop)" "$(dget "$f" Name)" "$(dget "$f" StartupWMClass)"
               "$(basename "$(exec_bin "$exec")")")
    [[ "$src" == pacman ]] && raw+=("$(pkg_of "$exec")")
    for k in "${raw[@]}"; do
        k="${k,,}"; k="${k#appimage-}"; k="${k#tar-}"; k="${k%.appimage}"
        for v in "$k" "${k// /}" "${k// /-}" "${k// /_}"; do
            [[ ${#v} -ge 3 && "$LEFTOVER_SKIP" != *[[:space:]]"$v"[[:space:]]* ]] && echo "$v"
        done
    done | sort -u
}

# "lowercase-name<TAB>path" of every data/config/cache folder, built once per
# run (sizes checks every app against it)
LEFTOVER_INDEX=""
leftover_index() {
    [[ -n "$LEFTOVER_INDEX" ]] && return
    local p d
    LEFTOVER_INDEX="$(for p in "$CONFIG_HOME" "$DATA_HOME" "$CACHE_HOME" "$HOME/.local/state"; do
        [[ -d "$p" ]] || continue
        for d in "$p"/*/; do
            d="${d%/}"; [[ -d "$d" && ! -L "$d" ]] || continue
            n="${d##*/}"; printf '%s\t%s\n' "${n,,}" "$d"
        done
    done)"
    [[ -z "$LEFTOVER_INDEX" ]] && LEFTOVER_INDEX=$'\t'
}

find_leftovers() {
    local f="$1" exec src keys d
    exec="$(dget "$f" Exec)"
    is_game_shortcut "$exec" && return      # never touch game saves/clients
    src="$(refine_source "$f" "$exec")"
    case "$src" in wine|system) return ;; esac
    keys="$(leftover_keys "$f" "$exec" "$src")"
    [[ -z "$keys" ]] && return
    leftover_index
    awk -F'\t' 'NR == FNR { k[$0] = 1; next } ($1 in k) { print $2 }' \
        <(printf '%s\n' "$keys") <(printf '%s\n' "$LEFTOVER_INDEX")
    if [[ "$src" == flatpak ]]; then
        d="$HOME/.var/app/$(flatpak_appid "$f" "$exec")"
        [[ -d "$d" ]] && echo "$d"
    fi
}

cmd_leftovers() {
    local f="$1" d n=0
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    while IFS= read -r d; do
        [[ -z "$d" ]] && continue
        [[ $n -eq 0 ]] && echo "User data that will also be deleted:"
        printf '  • %s  (%s)\n' "${d/#$HOME/\~}" "$(du -sh "$d" 2>/dev/null | cut -f1)"
        ((n++))
    done < <(find_leftovers "$f")
    [[ $n -eq 0 ]] && echo "No data/config of this app found in your home folder."
    return 0
}

# remove a leftover folder, only if it is strictly inside $HOME
purge_dir() {
    local d="$1"
    case "$d" in
        "$HOME"|"$HOME/"|"$CONFIG_HOME"|"$DATA_HOME"|"$CACHE_HOME") return ;;
        "$HOME/"*) rm -rf -- "$d" && log "→ deleted ${d/#$HOME/\~}" ;;
    esac
}

# Manual removal fallback: launcher + icon + (home-local) executable
manual_remove() {
    local f="$1" exec bin icon
    exec="$(dget "$f" Exec)"; bin="$(exec_path "$exec")"; icon="$(dget "$f" Icon)"
    # only launchers of your own: a system one belongs to a package
    [[ "$f" == "$HOME/"* ]] || { err "$(basename "$f") is a system launcher: not touched"; return 4; }
    rm -f "$f" || { err "could not delete $(basename "$f")"; return 4; }
    log "→ deleted launcher $(basename "$f")"
    [[ "$icon" = "$ICON_DIR/"* && -f "$icon" ]] && { rm -f "$icon"; log "→ deleted icon"; }
    if [[ "$bin" = "$HOME/"* && -f "$bin" ]]; then
        rm -f "$bin"; log "→ deleted executable $bin"
    fi
    refresh_menu
    log "✔ Manual clean-up done."
}

# installed packages whose dependencies would break without <pkg> (no root:
# pacman -R --print only resolves the transaction)
pkg_required_by() {
    LC_ALL=C pacman -R --print "$1" 2>&1 \
        | sed -nE "s/.*breaks dependency '[^']*' required by (.*)$/\1/p" | sort -u | paste -sd ' '
}

# how to remove a package that a bundle (meta-package) pulls in, keeping the
# bundle's other apps: mark them as explicitly installed first, so dropping
# the bundle doesn't turn them into orphans
pkg_blocked_help() {
    local pkg="$1" need="$2" n deps=()
    for n in $need; do
        while IFS= read -r d; do
            [[ -n "$d" && "$d" != "$pkg" ]] && pacman -Qq "$d" >/dev/null 2>&1 && deps+=("$d")
        done < <(LC_ALL=C pacman -Qi "$n" 2>/dev/null | awk -F': ' '/^Depends On/ { print $2 }' \
                   | tr ' ' '\n' | sed -E 's/[<>=].*//' | grep -v '^None$')
    done
    log "  If you still want it gone (the other apps of $need stay installed):"
    ((${#deps[@]})) && log "    sudo pacman -D --asexplicit ${deps[*]}"
    log "    sudo pacman -R $need"
    log "    sudo pacman -Rns $pkg"
}

# --- uninstall: remove the app according to its source ---------------------
#   control-deck uninstall <file.desktop> [--purge]
uninstall_app() {
    local f="$1" purge="$2"
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    local exec src; exec="$(dget "$f" Exec)"; src="$(refine_source "$f" "$exec")"
    log "Uninstalling: $(basename "$f")"
    log "Source: $src"
    log "─────────────────────────────────────────"

    # leftovers are resolved before the launcher disappears
    local leftovers=()
    [[ "$purge" == --purge ]] && mapfile -t leftovers < <(find_leftovers "$f")
    local auto; auto="$(autostart_file "$f")"

    case "$src" in
        flatpak)
            local id inst flags=(-y)
            id="$(flatpak_appid "$f" "$exec")"; inst="$(flatpak_installation "$id")"
            [[ -n "$inst" ]] && flags+=("--$inst")
            [[ "$purge" == --purge ]] && flags+=(--delete-data)
            log "→ flatpak uninstall ${flags[*]} $id"
            flatpak uninstall "${flags[@]}" "$id" || { err "flatpak uninstall failed"; return 4; }
            log "✔ Flatpak uninstalled." ;;
        appimage)
            local img icon
            img="$(dget "$f" X-ControlDeck-File)"; [[ -z "$img" ]] && img="$(exec_bin "$exec")"
            icon="$(dget "$f" Icon)"
            [[ -f "$img" ]] && { rm -f "$img"; log "→ deleted $img"; }
            [[ "$icon" = "$ICON_DIR/"* && -f "$icon" ]] && \
                { rm -f "$icon"; log "→ deleted icon $icon"; }
            rm -f "$f"; log "→ deleted launcher $(basename "$f")"
            log "✔ AppImage uninstalled." ;;
        tar)
            local dir icon; dir="$(dget "$f" X-ControlDeck-Dir)"; icon="$(dget "$f" Icon)"
            if [[ -n "$dir" && "$dir" == "$APPS_DIR/"* && -d "$dir" ]]; then
                rm -rf -- "$dir"; log "→ deleted folder $dir"
            fi
            [[ "$icon" = "$ICON_DIR/"* && -f "$icon" ]] && { rm -f "$icon"; log "→ deleted icon"; }
            rm -f "$f"; log "→ deleted launcher $(basename "$f")"
            log "✔ App uninstalled." ;;
        pacman)
            local pkg; pkg="$(pkg_of "$exec")"
            if [[ -z "$pkg" ]]; then
                err "could not determine the package; trying a manual clean-up…"
                manual_remove "$f" || return 4
            else
                # other packages that need it: asked before any password prompt
                local need; need="$(pkg_required_by "$pkg")"
                if [[ -n "$need" ]]; then
                    err "$pkg is needed by: $need — pacman won't remove it on its own."
                    pkg_blocked_help "$pkg" "$need"
                    return 5
                fi
                log "→ pkexec pacman -Rns $pkg (authorization required)"
                if pk_pacman -Rns --noconfirm "$pkg"; then
                    log "✔ Package $pkg removed."
                    # a user copy made by `edit` would keep a dead entry in the menu
                    [[ "$f" == "$DESKTOP_DIR/"* && -f "$f" ]] && rm -f "$f"
                else
                    err "pacman -Rns failed or was cancelled: $pkg is still installed."
                    return 4
                fi
            fi ;;
        wine)
            rm -f "$f"; log "→ deleted shortcut $(basename "$f")"
            log "✔ Removed from the menu. The Windows program is still installed in its WINEPREFIX."
            log "  To remove it completely:  wine uninstaller   (or WINEPREFIX=<path> wine uninstaller)" ;;
        dosbox|user)
            manual_remove "$f" ;;
        system)
            err "System entry with no owning package: not uninstalled, for safety."
            return 3 ;;
        *) err "unknown source"; return 4 ;;
    esac

    # an autostart entry of a removed app would fail at every login
    [[ -f "$auto" ]] && { rm -f "$auto"; log "→ removed its autostart entry"; }
    local d
    for d in "${leftovers[@]}"; do [[ -e "$d" ]] && purge_dir "$d"; done
    [[ ${#leftovers[@]} -gt 0 ]] && log "✔ User data deleted."
    refresh_menu
}

cmd_uninstall() {
    local name; name="$(dget "$1" Name)"; [[ -z "$name" ]] && name="$(basename "$1" .desktop)"
    local src; src="$(coarse_source "$1" "$(dget "$1" Exec)")"
    uninstall_app "$@"; local rc=$?
    history_add "uninstall${2:+ purge}" "$src" "$name" $rc
    return $rc
}

# --- rmpreview: show what `pacman -Rns` would remove ------------------------
cmd_rmpreview() {
    local f="$1"
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    local exec src; exec="$(dget "$f" Exec)"; src="$(refine_source "$f" "$exec")"
    if [[ "$src" != pacman ]]; then
        echo "Not a pacman package — nothing to preview."
        return 0
    fi
    local pkg; pkg="$(pkg_of "$exec")"
    [[ -z "$pkg" ]] && { echo "Could not determine the package."; return 0; }
    echo "Will run:  pacman -Rns $pkg"
    echo "Packages that would be removed:"
    # -Rs (recursive) for the preview; real removal uses -Rns
    local out
    if out="$(pacman -Rs --print --print-format '  • %n %v' "$pkg" 2>&1)"; then
        printf '%s\n' "$out"
        echo "Total: $(grep -c '•' <<<"$out") package(s)."
    else
        echo "⚠ pacman can't remove it directly:"
        printf '%s\n' "$out"
    fi
}

# ===========================================================================
# Autostart (opt-in, per app) — XDG autostart entries in ~/.config/autostart
# ===========================================================================
autostart_file() { echo "$AUTOSTART_DIR/$(basename "$1")"; }

autostart_enabled() {
    local a; a="$(autostart_file "$1")"
    [[ -f "$a" && "$(dget "$a" Hidden)" != true ]]
}

# does the session actually run XDG autostart entries?
session_runs_autostart() {
    systemctl --user is-active --quiet xdg-desktop-autostart.target 2>/dev/null && return 0
    pgrep -x dex >/dev/null 2>&1
}

cmd_autostart() {
    local f="$1" mode="$2" a
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    a="$(autostart_file "$f")"
    case "$mode" in
        on)
            mkdir -p "$AUTOSTART_DIR"
            if [[ -f "$a" && "$(dget "$a" X-ControlDeck-Autostart)" != true ]]; then
                # the app's own autostart entry, disabled before: just re-enable it
                desktop_set "$a" "$a" "Hidden="
            else
                desktop_set "$f" "$a" "NoDisplay=" "Hidden=" "X-ControlDeck-Autostart=true"
            fi
            log "✔ $(dget "$f" Name) will start when you log in."
            session_runs_autostart || \
                log "⚠ Your session doesn't seem to run XDG autostart entries (no xdg-desktop-autostart.target or dex). With Hyprland add:  exec-once = dex -a" ;;
        off)
            if [[ -f "$a" && "$(dget "$a" X-ControlDeck-Autostart)" == true ]]; then
                rm -f "$a"
            elif [[ -f "$a" ]]; then
                # an entry the app created itself: disable it the standard, reversible way
                desktop_set "$a" "$a" "Hidden=true"
            fi
            log "✔ $(dget "$f" Name) won't start at login any more." ;;
        status) autostart_enabled "$f" && echo on || echo off; return 0 ;;
        *) err "use: autostart <file.desktop> on|off|status"; return 2 ;;
    esac
    history_add "autostart $mode" "$(coarse_source "$f" "$(dget "$f" Exec)")" "$(dget "$f" Name)" 0
}

# ===========================================================================
# Flatpak permissions (a tiny Flatseal): user overrides via `flatpak override`
# ===========================================================================
# key|label|[Context] field|token(s) that grant it|grant flags|revoke flags
FP_PERMS=(
    "network|Network|shared|network|--share=network|--unshare=network"
    "wayland|Wayland|sockets|wayland|--socket=wayland|--nosocket=wayland"
    "x11|X11|sockets|x11 fallback-x11|--socket=x11|--nosocket=x11 --nosocket=fallback-x11"
    "audio|Audio|sockets|pulseaudio|--socket=pulseaudio|--nosocket=pulseaudio"
    "bluetooth|Bluetooth|features|bluetooth|--allow=bluetooth|--disallow=bluetooth"
    "devices|All devices|devices|all|--device=all|--nodevice=all"
    "home|Home folder|filesystems|home ~|--filesystem=home|--nofilesystem=home"
    "host|Whole filesystem|filesystems|host|--filesystem=host|--nofilesystem=host"
    "downloads|Downloads|filesystems|xdg-download|--filesystem=xdg-download|--nofilesystem=xdg-download"
)

# effective [Context] of an app (metadata + overrides), from stdin in the
# `flatpak info --show-permissions` format → "field<TAB>token" lines
fp_parse() {
    awk '
        /^\[/ { ctx = ($0 == "[Context]"); next }
        ctx && index($0, "=") {
            k = substr($0, 1, index($0, "=") - 1); v = substr($0, index($0, "=") + 1)
            n = split(v, t, ";")
            for (i = 1; i <= n; i++) if (t[i] != "") { sub(/:(ro|rw|create)$/, "", t[i]); print k "\t" t[i] }
        }'
}

# JSON [{key,label,granted}] from the parsed context on stdin
fp_perms_json() {
    local ctx; ctx="$(cat)"
    local spec key label field toks tok granted
    for spec in "${FP_PERMS[@]}"; do
        IFS='|' read -r key label field toks _ _ <<<"$spec"
        granted=false
        for tok in $toks; do
            grep -qxF "$field"$'\t'"$tok" <<<"$ctx" && granted=true
        done
        printf '%s\n%s\n%s\n' "$key" "$label" "$granted"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 3) as $i |
        {key:$l[$i], label:$l[$i+1], granted:($l[$i+2] == "true")}]'
}

cmd_fpperms() {
    [[ -n "$1" ]] || { err "missing app id"; return 2; }
    flatpak info --show-permissions "$1" 2>/dev/null | fp_parse | fp_perms_json
}

cmd_fpset() {
    local id="$1" key="$2" mode="$3" spec k="" grant revoke
    for spec in "${FP_PERMS[@]}"; do
        IFS='|' read -r k _ _ _ grant revoke <<<"$spec"
        [[ "$k" == "$key" ]] && break
        k=""
    done
    [[ -z "$k" ]] && { err "unknown permission: $key"; return 2; }
    local flags
    case "$mode" in on) flags="$grant" ;; off) flags="$revoke" ;; *) err "use on|off"; return 2 ;; esac
    log "→ flatpak override --user $flags $id"
    # shellcheck disable=SC2086
    flatpak override --user $flags "$id" || { err "flatpak override failed"; return 4; }
    log "✔ Permission updated. Restart the app for it to take effect."
    history_add "permission $key $mode" flatpak "$id" 0
}

cmd_fpreset() {
    [[ -n "$1" ]] || { err "missing app id"; return 2; }
    flatpak override --user --reset "$1" || return 4
    log "✔ Your permission overrides for $1 were reset."
    history_add "permission reset" flatpak "$1" 0
}

# ===========================================================================
# Launch diagnostics — why an app doesn't start, and how to fix it
# Output protocol: ISSUE=<text> and FIX=<kind>|<LABEL> lines (for the GUI)
# ===========================================================================
issue() { printf 'ISSUE=%s\n' "$*"; }
fix()   { printf 'FIX=%s|%s\n' "$1" "$2"; }

# problems detectable without running the app
static_problems() {
    local f="$1" exec src file bin
    exec="$(dget "$f" Exec)"; src="$(coarse_source "$f" "$exec")"
    if [[ "$src" == appimage ]]; then
        file="$(dget "$f" X-ControlDeck-File)"; [[ -z "$file" ]] && file="$(exec_bin "$exec")"
        if [[ ! -f "$file" ]]; then issue "The AppImage no longer exists: $file"; return; fi
        [[ -x "$file" ]] || { issue "The AppImage is not executable."; fix chmod "MAKE EXECUTABLE"; }
        if appimage_needs_fuse2 "$file" && ! have_fuse2 && [[ "$exec" != *APPIMAGE_EXTRACT_AND_RUN* ]]; then
            issue "This AppImage needs FUSE 2 (libfuse.so.2), which is not installed: it won't start."
            fix repo:fuse2 "INSTALL fuse2"
            fix extractrun "RUN WITHOUT FUSE"
        fi
        return
    fi
    [[ "$src" == flatpak ]] && return
    bin="$(exec_bin "$exec")"
    [[ -z "$bin" ]] && return
    if [[ "$bin" == /* ]]; then [[ -e "$bin" ]] || issue "The program doesn't exist: $bin (broken launcher)."
    else have "$bin" || issue "The program «$bin» is not installed (broken launcher)."; fi
}

# package that ships a file (needs the pacman files db: pacman -Fy)
pkg_for_file() { pacman -Fq "$1" 2>/dev/null | head -1 | sed 's|.*/||'; }

# read a crash log and explain it (app output may be localized: match both)
diagnose() {
    local logf="$1" lib pkg mod qt
    if grep -qiE 'libfuse\.so\.2|AppImages require FUSE|Cannot mount AppImage|fusermount' "$logf"; then
        issue "FUSE 2 (libfuse.so.2) is missing; it's needed to mount this AppImage."
        fix repo:fuse2 "INSTALL fuse2"
        fix extractrun "RUN WITHOUT FUSE"
        return
    fi
    lib="$(grep -oE 'error while loading shared libraries: [^:]+' "$logf" | head -1 | sed 's/.*: //')"
    if [[ -n "$lib" ]]; then
        pkg="$(pkg_for_file "$lib")"
        if [[ -n "$pkg" ]]; then
            issue "The library $lib is missing (it comes with the package $pkg)."
            fix "repo:$pkg" "INSTALL $pkg"
        else
            issue "The library $lib is missing. To find which package ships it: sudo pacman -Fy && pacman -F $lib"
        fi
        return
    fi
    if grep -qE "GLIBC_[0-9.]+' not found" "$logf"; then
        issue "The app needs a newer glibc: update the system (UPDATES)."; return
    fi
    if grep -qiE 'SUID sandbox helper|No usable sandbox|--no-sandbox|sandbox.*(namespace|not configured)' "$logf"; then
        issue "The Chromium/Electron sandbox can't start."
        fix nosandbox "ADD --no-sandbox"; return
    fi
    if grep -qiE 'Qt platform plugin "?wayland|qt\.qpa\.plugin' "$logf"; then
        qt=qt6-wayland; grep -qiE 'qt5|libQt5' "$logf" && qt=qt5-wayland
        issue "The Wayland plugin for Qt is missing."
        fix "repo:$qt" "INSTALL $qt"; return
    fi
    mod="$(grep -oE "No module named '[^'.]+" "$logf" | head -1 | sed "s/.*'//")"
    if [[ -n "$mod" ]]; then
        pkg="python-${mod,,}"; pkg="${pkg//_/-}"
        if pacman -Si "$pkg" >/dev/null 2>&1; then
            issue "The Python module «$mod» is missing."; fix "repo:$pkg" "INSTALL $pkg"
        else issue "The Python module «$mod» is missing (search for it in STORE)."; fi
        return
    fi
    if grep -qiE 'Exec format error|cannot execute binary file|Formato de ejecutable incorrecto|no se puede ejecutar el fichero binario' "$logf"; then
        issue "The executable is not built for this architecture ($(uname -m))."; return
    fi
    if grep -qiE 'Permission denied|Permiso denegado' "$logf"; then
        issue "Permission denied when running the program."; fix chmod "MAKE EXECUTABLE"; return
    fi
    if grep -qiE 'command not found|No such file or directory|orden no encontrada|No existe el fichero' "$logf"; then
        issue "The program, or a file it needs, can't be found (check the log)."; return
    fi
    issue "The app closed on start-up for no recognisable reason: check the log."
}

# --- quick actions: launch · open folder · copy Exec ------------------------
# Launch the app ourselves (not via gio) so its output lands in a log: if it
# dies within a few seconds with an error, explain why and offer a fix.
cmd_launch() {
    local f="$1"
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    local name; name="$(dget "$f" Name)"
    if [[ "$(dget "$f" Terminal)" == true ]]; then
        setsid -f gio launch "$f" >/dev/null 2>&1; log "▶ Launched in a terminal: $name"; return 0
    fi
    local problems; problems="$(static_problems "$f")"
    if grep -q '^ISSUE=' <<<"$problems" && grep -q '^FIX=' <<<"$problems"; then
        log "✗ $name can't start yet:"; printf '%s\n' "$problems"; return 4
    fi

    local cmd dir logf pid rc i
    cmd="$(dget "$f" Exec | sed -E 's/(^|[[:space:]])%[fFuUdDnNickvm]//g; s/%%/%/g')"
    dir="$(dget "$f" Path)"; [[ -d "$dir" ]] || dir="$HOME"
    mkdir -p "$STATE_DIR/logs"
    logf="$STATE_DIR/logs/$(basename "$f" .desktop).log"
    # the subshell is not a process-group leader, so setsid execs in place and
    # $! is the app itself
    ( cd "$dir" && exec setsid bash -c "exec $cmd" ) >"$logf" 2>&1 </dev/null &
    pid=$!
    for ((i = 0; i < 10; i++)); do sleep 0.4; kill -0 "$pid" 2>/dev/null || break; done
    if kill -0 "$pid" 2>/dev/null; then
        disown "$pid" 2>/dev/null; log "▶ Launched: $name"; return 0
    fi
    wait "$pid"; rc=$?
    # exit 0 right away = it handed off to a running instance or daemonized
    [[ $rc -eq 0 ]] && { log "▶ Launched: $name"; return 0; }

    log "✗ $name closed on start-up (exit code $rc)"
    if [[ -n "$problems" ]]; then printf '%s\n' "$problems"; else diagnose "$logf"; fi
    log "── last lines of the log ──"
    tail -n 12 "$logf"
    log "Full log: ${logf/#$HOME/\~}"
    history_add launch "$(coarse_source "$f" "")" "$name" $rc
    return 4
}

# --- fix: apply a fix proposed by the diagnostics ----------------------------
#   control-deck fix <file.desktop> <repo:pkg|chmod|extractrun|nosandbox>
cmd_fix() {
    local f="$1" kind="$2" exec file target="$1" rc=0
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    exec="$(dget "$f" Exec)"
    [[ "$f" == "$DESKTOP_DIR/"* ]] || target="$DESKTOP_DIR/$(basename "$f")"
    case "$kind" in
        repo:*)
            log "→ pkexec pacman -S ${kind#repo:}"
            pk_pacman -S --needed --noconfirm -- "${kind#repo:}" || { err "pacman -S failed"; rc=4; } ;;
        chmod)
            file="$(dget "$f" X-ControlDeck-File)"; [[ -z "$file" ]] && file="$(exec_path "$exec")"
            if chmod +x "$file"; then log "→ chmod +x $file"; else rc=4; fi ;;
        extractrun)
            # the AppImage unpacks itself to /tmp on each start: no FUSE, slower startup
            [[ "$exec" == *APPIMAGE_EXTRACT_AND_RUN* ]] || exec="env APPIMAGE_EXTRACT_AND_RUN=1 $exec"
            desktop_set "$f" "$target" "Exec=$exec" "X-ControlDeck-Edited=true" || rc=4
            log "→ Exec: $exec" ;;
        nosandbox)
            if [[ "$exec" != *--no-sandbox* ]]; then
                exec="$(sed -E 's/^(([^"[:space:]]*=[^[:space:]]*[[:space:]]+|env[[:space:]]+)*("[^"]*"|[^[:space:]]+))/\1 --no-sandbox/' <<<"$exec")"
            fi
            desktop_set "$f" "$target" "Exec=$exec" "X-ControlDeck-Edited=true" || rc=4
            log "→ Exec: $exec" ;;
        *) err "unknown fix: $kind"; return 2 ;;
    esac
    refresh_menu
    [[ $rc -eq 0 ]] && log "✔ Fix applied. Try launching it again."
    history_add fix "$kind" "$(dget "$target" Name)" $rc
    return $rc
}

# folder where the app actually lives
app_dir() {
    local f="$1" exec src d="" id
    exec="$(dget "$f" Exec)"; src="$(refine_source "$f" "$exec")"
    d="$(dget "$f" X-ControlDeck-Dir)"
    [[ -z "$d" ]] && d="$(dget "$f" Path)"
    if [[ -z "$d" ]]; then
        case "$src" in
            flatpak)
                id="$(flatpak_appid "$f" "$exec")"
                for d in "$HOME/.var/app/$id" "$DATA_HOME/flatpak/app/$id" "/var/lib/flatpak/app/$id" ""; do
                    [[ -d "$d" ]] && break
                done ;;
            wine)
                d="$(grep -oE 'WINEPREFIX="?[^" ]+' <<<"$exec" | head -1)"
                d="${d#WINEPREFIX=}"; d="${d#\"}"; d="${d:-$HOME/.wine}" ;;
            *)
                local bin; bin="$(exec_path "$exec")"
                [[ -n "$bin" ]] && d="$(dirname "$(readlink -f "$bin")")" ;;
        esac
    fi
    [[ -d "$d" ]] || d="$(dirname "$f")"
    echo "$d"
}

cmd_opendir() {
    local d; d="$(app_dir "$1")"
    setsid -f xdg-open "$d" >/dev/null 2>&1
    log "📂 $d"
}

cmd_copyexec() {
    local e; e="$(dget "$1" Exec)"
    if have wl-copy; then printf '%s' "$e" | wl-copy
    elif have xclip; then printf '%s' "$e" | xclip -selection clipboard
    else err "no clipboard tool (install wl-clipboard)"; return 4; fi
    log "📋 Copied: $e"
}

# --- pickfile: native file chooser (zenity), prints chosen path ------------
cmd_pickfile() {
    local title="${1:-Choose a file}" dir="${2:-$HOME}" filter="${3:-}"
    [[ "$dir" == @downloads ]] && dir="$(xdg-user-dir DOWNLOAD 2>/dev/null)"
    [[ -d "$dir" ]] || dir="$HOME"
    if have zenity; then
        zenity --file-selection --title="$title" --filename="$dir/" ${filter:+--file-filter="$filter"} 2>/dev/null
    elif have kdialog; then
        kdialog --getopenfilename "$dir" ${filter:+"${filter#*|}"} 2>/dev/null
    else
        err "no file chooser available (install zenity)"; return 1
    fi
}

# ===========================================================================
# GitHub releases
# ===========================================================================

# "https://github.com/o/r/releases" · "github.com/o/r" · "o/r"  →  "o/r"
gh_repo_from() {
    local s="$1" o r
    s="${s#*://}"; s="${s#www.}"; s="${s#github.com/}"; s="${s%%[?#]*}"
    IFS=/ read -r o r _ <<<"$s"; r="${r%.git}"
    [[ "$o" =~ ^[A-Za-z0-9_.-]+$ && "$r" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    echo "$o/$r"
}

is_gh_spec() {
    [[ "$1" == *github.com/* || "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
}

gh_api() {
    local h=(-H 'Accept: application/vnd.github+json')
    [[ -n "$GITHUB_TOKEN" ]] && h+=(-H "Authorization: Bearer $GITHUB_TOKEN")
    curl -fsSL --max-time 15 "${h[@]}" "https://api.github.com/$1"
}

# newest release that ships something installable here (stable ones first;
# e.g. a project whose latest release only carries an .apk is skipped)
gh_latest() {
    gh_api "repos/$1/releases?per_page=15" 2>/dev/null | jq -e '
        def fits: .name | ascii_downcase |
            test("\\.(appimage|flatpak|deb|tar|tgz|tar\\.(gz|xz|zst|bz2))$|\\.pkg\\.tar")
            and (test("darwin|macos|osx|windows|win32|win64|-src\\.|source") | not);
        map(select((.draft | not) and any(.assets[]?; fits))) |
        (map(select(.prerelease | not)) + .) | .[0]'
}

# does an asset name fit this machine (arch + OS)?
asset_fits() {
    local n="${1,,}"
    [[ "$n" =~ (darwin|macos|osx|windows|win32|win64|\.exe$|\.dmg$|\.msi$|-src\.|source) ]] && return 1
    case "$(uname -m)" in
        x86_64)  [[ "$n" =~ (aarch64|arm64|armv7|armhf|armv6|i[3-6]86|ppc64|s390x|riscv) ]] && return 1 ;;
        aarch64) [[ "$n" =~ (x86_64|amd64|x64|i[3-6]86) ]] && return 1 ;;
    esac
    return 0
}

# launcher installed from a GitHub repo (empty if none)
gh_launcher() {
    grep -lxF "X-ControlDeck-Github=$1" "$DESKTOP_DIR"/*.desktop 2>/dev/null | head -1
}

# --- ghreleases: installable assets of the latest release (STORE format) ----
cmd_ghreleases() {
    local repo rel tag installed_tag="" lf
    repo="$(gh_repo_from "$1")" || { err "not a valid GitHub repo: $1"; echo "[]"; return 2; }
    rel="$(gh_latest "$repo")" || { err "$repo has no installable releases (or doesn't exist)"; echo "[]"; return 4; }
    tag="$(jq -r '.tag_name // ""' <<<"$rel")"
    lf="$(gh_launcher "$repo")"; [[ -n "$lf" ]] && installed_tag="$(dget "$lf" X-ControlDeck-Version)"

    local n url size t prio
    jq -r '.assets[]? | .name, .browser_download_url, (.size | tostring)' <<<"$rel" |
    while IFS= read -r n && IFS= read -r url && IFS= read -r size; do
        t="$(detect_type "$n")"
        is_supported "$t" || continue
        asset_fits "$n" || continue
        case "$t" in appimage) prio=1 ;; pacman) prio=2 ;; flatpak) prio=3 ;; tar) prio=4 ;; *) prio=5 ;; esac
        printf '%s\n' "$prio" "$n" "$url" "$(type_label "$t")" "$(human "$size")"
    done | jq -Rn --arg repo "$repo" --arg tag "$tag" --arg itag "$installed_tag" '
        [inputs] as $l | [range(0; $l|length; 5) as $i |
         {prio:($l[$i]|tonumber), source:"github", name:$l[$i+1], id:$l[$i+2], version:$tag,
          desc:($l[$i+3] + " · " + $l[$i+4] + " · " + $repo), remote:($repo + "@" + $tag),
          installed:($itag == $tag)}] | sort_by(.prio) | map(del(.prio))'
}

# --- ghinstall: download a release asset and install it, tracking its origin
cmd_ghinstall() {
    local url="$1" spec="$2" file
    GH_REPO="${spec%@*}"; GH_TAG="${spec#*@}"
    GH_ASSET="$(urldecode "${url##*/}")"
    log "→ GitHub $GH_REPO · $GH_TAG · $GH_ASSET"
    file="$(download "$url")" || return 4
    cmd_install "$file"
}

# pick the asset of a new release that corresponds to the installed one:
# same name with the digits masked, else the first of the same type that fits
gh_pick_asset() {
    local rel="$1" old="$2" type="$3" mask n url fallback=""
    mask="$(sed -E 's/[0-9]+/#/g' <<<"$old")"
    while IFS= read -r n && IFS= read -r url; do
        [[ "$(sed -E 's/[0-9]+/#/g' <<<"$n")" == "$mask" ]] && { echo "$url"; return; }
        [[ -z "$fallback" && "$(detect_type "$n")" == "$type" ]] && asset_fits "$n" && fallback="$url"
    done < <(jq -r '.assets[]? | .name, .browser_download_url' <<<"$rel")
    [[ -n "$fallback" ]] && echo "$fallback"
}

gh_update_launcher() {
    local f="$1" repo rel tag url type
    repo="$(dget "$f" X-ControlDeck-Github)"
    [[ -z "$repo" ]] && { err "this launcher doesn't come from GitHub"; return 3; }
    rel="$(gh_latest "$repo")" || { err "could not query $repo"; return 4; }
    tag="$(jq -r '.tag_name' <<<"$rel")"
    type="$(dget "$f" X-ControlDeck-Type)"
    url="$(gh_pick_asset "$rel" "$(dget "$f" X-ControlDeck-Asset)" "$type")"
    [[ -z "$url" ]] && { err "release $tag has no matching file"; return 4; }
    UPDATE_TARGET="$f"
    cmd_ghinstall "$url" "$repo@$tag"
}

# ===========================================================================
# AUR review — look at a package before building it
# ===========================================================================

# level|regex|explanation — "install" rules only apply to the .install file
AUR_RULES=(
    'high|(curl|wget)[^|#]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh\b|Downloads a script and pipes it straight into a shell'
    'high|base64[[:space:]]+(-d|--decode)|Decodes base64 data (a common way to hide code)'
    'high|/dev/(tcp|udp)/|(^|[^a-z])nc[[:space:]].*-e[[:space:]]|ncat[[:space:]].*-e|socat[[:space:]].*exec|Raw network connection / reverse-shell pattern'
    'high|(^|[;&|[:space:]])sudo[[:space:]]|Uses sudo inside the build (makepkg never needs it)'
    'high|eval[[:space:]].*(curl|wget)|Evaluates code downloaded at build time'
    'high|(\\x[0-9a-fA-F]{2}){8,}|Long hex-escaped string (possible obfuscation)'
    'high|rm[[:space:]]+-[a-zA-Z]*[rR][a-zA-Z]*[[:space:]]+("?/"?|~/?|"?\$HOME"?/?)([[:space:]]|$)|Deletes system or home directories'
    'high|python[0-9.]*[[:space:]]+-c.*(urllib|requests|socket)|Inline Python that talks to the network'
    'install|(curl|wget|git[[:space:]]+clone)|The .install script downloads things at install time (it runs as root)'
    'medium|chmod[[:space:]]+(-R[[:space:]]+)?[0-7]?777|Makes files world-writable'
    'medium|systemctl[[:space:]]+(--now[[:space:]]+)?enable|Enables a service on install'
    'medium|crontab|/etc/cron|Touches cron (scheduled tasks)'
    'medium|\.bashrc|\.zshrc|\.profile|/etc/profile|Modifies shell start-up files'
)

# flag lines of a PKGBUILD (+ optional .install) that deserve a look.
# Output: level<US>text<US>where  (level = high|medium|low)
aur_scan_file() {   # file label
    local f="$1" label="$2" n=0 line rule level pat text
    [[ -f "$f" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        ((n++))
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        for rule in "${AUR_RULES[@]}"; do
            level="${rule%%|*}"; text="${rule##*|}"
            pat="${rule#*|}"; pat="${pat%|*}"
            [[ "$level" == install && "$label" != .install ]] && continue
            [[ "$level" == install ]] && level=high
            if grep -qiE -- "$pat" <<<"$line"; then
                printf '%s%s%s%s%s\n' "$level" "$SEP" "$text" "$SEP" "$label:$n"
            fi
        done
    done < "$f"
}

aur_scan() {
    local pkgbuild="$1" install="$2" srcs
    aur_scan_file "$pkgbuild" PKGBUILD
    aur_scan_file "$install" .install

    # sources: plain http, raw IPs, paste/file-sharing hosts, skipped checksums
    srcs="$(grep -oE '(https?|ftp)://[^"'"'"' )]+' "$pkgbuild" 2>/dev/null)"
    if grep -qE '^http://' <<<"$srcs"; then
        printf 'medium%sDownloads over plain HTTP (not encrypted)%ssource\n' "$SEP" "$SEP"; fi
    if grep -qE '^(https?|ftp)://[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' <<<"$srcs"; then
        printf 'high%sDownloads from a raw IP address%ssource\n' "$SEP" "$SEP"; fi
    if grep -qiE '(pastebin\.|transfer\.sh|discord(app)?\.(com|net)/attachments|bit\.ly|tinyurl|gofile\.|mega\.nz|anonfiles|file\.io|0x0\.st)' <<<"$srcs"; then
        printf 'high%sDownloads from a paste / file-sharing / URL-shortener site%ssource\n' "$SEP" "$SEP"; fi
    if grep -qE "^[[:space:]]*(b2|sha(1|224|256|384|512)|md5)sums(_[a-z0-9_]+)?=.*SKIP" "$pkgbuild" 2>/dev/null \
       && ! grep -qE "(git|svn|hg|bzr)\+|\.git(#|$|['\"])" "$pkgbuild"; then
        printf 'medium%sChecksums are skipped (SKIP) for a non-VCS source%ssums\n' "$SEP" "$SEP"
    fi
    return 0
}

cmd_aurscan() {
    [[ -f "$1" ]] || { err "PKGBUILD not found: $1"; return 2; }
    aur_scan "$1" "$2" | jq -Rn '[inputs | split("\u001f") | {level:.[0], text:.[1], where:.[2]}]'
}

# --- aurreview: metadata + PKGBUILD + findings, JSON ---------------------------
cmd_aurreview() {
    local pkg="$1" info base tmp flags now inst
    [[ -n "$pkg" ]] || { err "missing package name"; return 2; }
    info="$(curl -fsS --max-time 10 "$AUR_URL/rpc/v5/info?arg[]=$pkg" | jq -c '.results[0] // empty')"
    [[ -z "$info" ]] && { err "$pkg not found in the AUR"; return 4; }
    base="$(jq -r '.PackageBase' <<<"$info")"
    tmp="$(mktemp -d)"
    curl -fsS --max-time 10 -o "$tmp/PKGBUILD" "$AUR_URL/cgit/aur.git/plain/PKGBUILD?h=$base" \
        || { err "could not download the PKGBUILD"; rm -rf "$tmp"; return 4; }
    inst="$(curl -fsS --max-time 10 "$AUR_URL/cgit/aur.git/plain/.SRCINFO?h=$base" \
            | awk -F' = ' '/^[[:space:]]*install = / { print $2; exit }')"
    [[ -n "$inst" ]] && curl -fsS --max-time 10 -o "$tmp/install" "$AUR_URL/cgit/aur.git/plain/$inst?h=$base"

    flags="$(aur_scan "$tmp/PKGBUILD" "$tmp/install")"
    now="$(date +%s)"
    # metadata red flags
    if [[ "$(jq -r '.Maintainer // ""' <<<"$info")" == "" ]]; then
        flags+=$'\n'"medium${SEP}Orphaned package: nobody maintains it${SEP}AUR"; fi
    if (( now - $(jq -r '.FirstSubmitted' <<<"$info") < 30 * 86400 )) && (( $(jq -r '.NumVotes' <<<"$info") < 5 )); then
        flags+=$'\n'"medium${SEP}Brand-new package (under 30 days) with very few votes${SEP}AUR"; fi
    if [[ "$(jq -r '.OutOfDate // ""' <<<"$info")" != "" ]]; then
        flags+=$'\n'"low${SEP}Flagged out of date by users${SEP}AUR"; fi

    jq -n --argjson info "$info" --rawfile pb "$tmp/PKGBUILD" \
          --arg inst "$( [[ -f "$tmp/install" ]] && cat "$tmp/install" )" --arg flags "$flags" '
        ($flags | split("\n") | map(select(. != "") | split("\u001f") | {level:.[0], text:.[1], where:.[2]})) as $f |
        {name:$info.Name, base:$info.PackageBase, version:$info.Version,
         maintainer:($info.Maintainer // ""), votes:$info.NumVotes, popularity:$info.Popularity,
         submitted:$info.FirstSubmitted, modified:$info.LastModified, outofdate:($info.OutOfDate != null),
         url:($info.URL // ""), pkgbuild:$pb, install:$inst, flags:$f,
         risk:(if any($f[]; .level == "high") then "high"
               elif any($f[]; .level == "medium") then "medium" else "low" end)}'
    rm -rf "$tmp"
}

# ===========================================================================
# Search & install by name — repos (pacman) · AUR · Flatpak · GitHub
# ===========================================================================
search_repo() {
    local q="$1" ipkgs="$2" count=0 header="" line first repo name ver inst desc seen=" "
    while IFS= read -r line; do
        if [[ "$line" == [!$' \t']* ]]; then
            header="$line"
        else
            [[ -z "$header" ]] && continue
            desc="${line#"${line%%[![:space:]]*}"}"
            first="${header%% *}"; repo="${first%%/*}"; name="${first#*/}"
            [[ "$seen" == *" $name "* ]] && { header=""; continue; }   # dedup across repos
            seen+="$name "
            ver="$(awk '{print $2}' <<<"$header")"
            inst=false; grep -qxF "$name" <<<"$ipkgs" && inst=true
            jq -c -n --arg s repo --arg n "$name" --arg id "$name" \
               --arg v "$ver" --arg d "$desc" --arg r "$repo" --argjson inst "$inst" \
               '{source:$s,name:$n,id:$id,version:$v,desc:$d,remote:$r,installed:$inst}'
            header=""
            ((count++)); [[ $count -ge 30 ]] && break
        fi
    done < <(pacman -Ss -- "$q" 2>/dev/null)
}

search_aur() {
    local q="$1" ipkgs="$2" names uri
    names="$(printf '%s' "$ipkgs" | jq -R . | jq -s .)"
    uri="$(jq -rn --arg x "$q" '$x|@uri')"
    curl -s --max-time 8 "$AUR_URL/rpc/v5/search?arg=$uri" 2>/dev/null \
    | jq -c --arg s aur --argjson names "$names" '
        (.results // []) | sort_by(-(.Popularity // 0))[:30][] | .Name as $n |
        {source:$s, name:$n, id:$n, version:.Version,
         desc:(.Description // ""), remote:"aur",
         installed: (($names | index($n)) != null)}' 2>/dev/null
}

# columns come tab-separated and may be empty, so they are split with jq
# (bash `read` would collapse consecutive tabs and shift the fields)
search_flatpak() {
    local q="$1" iflat="$2"
    have flatpak || return 0
    flatpak search --columns=name,application,version,description,remotes "$q" 2>/dev/null \
    | jq -Rc --arg inst "$iflat" '
        split("\t") | select(length >= 2 and .[1] != "" and .[1] != "Application ID") |
        {source:"flatpak", name:.[0], id:.[1], version:(.[2] // ""), desc:(.[3] // ""),
         remote:((.[4] // "") | split(",")[0]),
         installed:(.[1] as $id | $inst | split("\n") | index($id) != null)}' \
    | head -30
}

cmd_search() {
    local q="$1"
    [[ -z "$q" ]] && { echo "[]"; return 0; }
    if is_gh_spec "$q"; then cmd_ghreleases "$q"; return; fi
    local ipkgs iflat
    ipkgs="$(pacman -Qq 2>/dev/null)"
    iflat="$(flatpak list --columns=application 2>/dev/null)"
    {
        search_repo    "$q" "$ipkgs"
        search_aur     "$q" "$ipkgs"
        search_flatpak "$q" "$iflat"
    } | jq -s '.'
}

install_aur() {
    local helper; helper="$(aur_helper)"
    [[ -z "$helper" ]] && { err "no AUR helper found (install paru or yay)"; return 4; }
    log "→ Opening a terminal to build from the AUR with $(basename "$helper"): $*"
    run_in_terminal "$helper -S --needed -- $(printf '%q ' "$@")" || return 4
    log "✔ Terminal opened. Follow the progress there (it will ask for your sudo password)."
}

installpkg() {
    local src="$1" id="$2" remote="$3"
    [[ -n "$id" ]] || { err "missing package name"; return 2; }
    case "$src" in
        repo)
            log "→ pkexec pacman -S $id (authorization required)"
            if pk_pacman -S --needed --noconfirm -- "$id"; then
                log "✔ $id installed from the repos."
            else err "pacman -S failed (cancelled or conflict)."; return 4; fi ;;
        aur)
            install_aur "$id" ;;
        flatpak)
            log "→ flatpak install --user $remote $id"
            local ok=1
            if [[ -n "$remote" && "$remote" != "aur" ]]; then
                flatpak install --user -y --noninteractive "$remote" "$id" && ok=0
            else
                flatpak install --user -y --noninteractive "$id" && ok=0
            fi
            if [[ $ok -eq 0 ]]; then log "✔ $id installed (Flatpak)."
            else err "flatpak install failed."; return 4; fi ;;
        github)
            cmd_ghinstall "$id" "$remote" ;;
        *) err "unknown source: $src"; return 2 ;;
    esac
}

cmd_installpkg() {
    installpkg "$@"; local rc=$?
    [[ "$1" != github ]] && history_add install "$1" "$2" $rc   # github logs via cmd_install
    return $rc
}

# ===========================================================================
# Updates — repos · AUR · Flatpak · AppImage/tar (GitHub or appimageupdatetool)
# Records: source, id, name, old, new (one field per line, 5 lines each)
# ===========================================================================
upd_repo() {
    local out n o v
    if have checkupdates; then out="$(checkupdates 2>/dev/null)"; else out="$(pacman -Qu 2>/dev/null)"; fi
    while read -r n o _ v; do
        [[ -n "$v" ]] && printf '%s\n' repo "$n" "$n" "$o" "$v"
    done <<<"$out"
}

upd_aur() {
    local helper n o v; helper="$(aur_helper)"
    [[ -z "$helper" ]] && return
    while read -r n o _ v; do
        [[ -n "$v" ]] && printf '%s\n' aur "$n" "$n" "$o" "$v"
    done < <("$helper" -Qua 2>/dev/null | grep -- ' -> ')
}

upd_flatpak() {
    have flatpak || return
    local cur; cur="$(flatpak list --columns=application,version 2>/dev/null)"
    flatpak remote-ls --updates --columns=application,version,name 2>/dev/null \
    | jq -Rr --arg cur "$cur" '
        split("\t") | select(length >= 1 and .[0] != "" and .[0] != "Application ID") | .[0] as $id |
        ($cur | split("\n") | map(split("\t")) | map(select(.[0] == $id)) | .[0][1] // "") as $old |
        "flatpak", $id, ((.[2] // "") | if . == "" then $id else . end), $old,
        ((.[1] // "") | if . == "" then "new" else . end)'
}

our_launchers() {
    grep -lE '^X-ControlDeck-Type=(appimage|tar)$|^X-Created-By=install-any$' "$DESKTOP_DIR"/*.desktop 2>/dev/null
}

upd_appimage() {
    local f repo tag latest file name
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        name="$(dget "$f" Name)"
        repo="$(dget "$f" X-ControlDeck-Github)"
        if [[ -n "$repo" ]]; then
            tag="$(dget "$f" X-ControlDeck-Version)"
            latest="$(gh_latest "$repo" | jq -r '.tag_name // empty')"
            [[ -n "$latest" && "$latest" != "$tag" ]] && printf '%s\n' github "$f" "$name" "$tag" "$latest"
        elif [[ "$(dget "$f" X-ControlDeck-Type)" != tar ]] && have appimageupdatetool; then
            file="$(dget "$f" X-ControlDeck-File)"; [[ -z "$file" ]] && file="$(exec_bin "$(dget "$f" Exec)")"
            [[ -f "$file" ]] || continue
            appimageupdatetool -j "$file" >/dev/null 2>&1
            [[ $? -eq 1 ]] && printf '%s\n' appimage "$f" "$name" "$(dget "$f" X-AppImage-Version)" "available"
        fi
    done < <(our_launchers)
}

cmd_updates() {
    local tmp; tmp="$(mktemp -d)"
    upd_repo     > "$tmp/1" &
    upd_aur      > "$tmp/2" &
    upd_flatpak  > "$tmp/3" &
    upd_appimage > "$tmp/4" &
    upd_self     > "$tmp/5" &
    wait
    cat "$tmp"/[1-5] | jq -Rn '[inputs] as $l | [range(0; $l|length; 5) as $i |
        {source:$l[$i], id:$l[$i+1], name:$l[$i+2], old:$l[$i+3], new:$l[$i+4]}]'
    rm -rf "$tmp"
}

system_upgrade() {
    log "→ pkexec pacman -Syu (full system upgrade)"
    if pk_pacman -Syu --noconfirm; then log "✔ System upgraded."
    else err "pacman -Syu failed (cancelled or conflict: try it in a terminal)."; return 4; fi
}

# update one item: control-deck update <source> <id>
update_one() {
    local src="$1" id="$2" file
    case "$src" in
        repo)    system_upgrade ;;   # Arch doesn't support partial upgrades
        aur)     install_aur "$id" ;;
        flatpak)
            log "→ flatpak update $id"
            flatpak update -y --noninteractive "$id" || { err "flatpak update failed"; return 4; }
            log "✔ $id updated." ;;
        github)  gh_update_launcher "$id" ;;
        deck)    cmd_selfupdate ;;
        appimage)
            have appimageupdatetool || { err "appimageupdatetool is not installed"; return 4; }
            file="$(dget "$id" X-ControlDeck-File)"; [[ -z "$file" ]] && file="$(exec_bin "$(dget "$id" Exec)")"
            log "→ appimageupdatetool $(basename "$file")"
            appimageupdatetool -O "$file" || { err "appimageupdatetool failed"; return 4; }
            log "✔ AppImage updated." ;;
        *) err "unknown source: $src"; return 2 ;;
    esac
}

cmd_update() {
    local name="$2"; [[ -f "$2" ]] && name="$(dget "$2" Name)"
    update_one "$@"; local rc=$?
    history_add update "$1" "$name" $rc
    return $rc
}

cmd_updateall() {
    log "→ Checking for updates…"
    local list; list="$(cmd_updates)"
    local n; n="$(jq length <<<"$list")"
    [[ "$n" -eq 0 ]] && { log "✔ Everything is up to date."; return 0; }
    log "  $n pending update(s)"
    local fail=0 src id news
    if [[ "$(jq '[.[] | select(.source == "repo")] | length' <<<"$list")" -gt 0 ]]; then
        news="$(cmd_news 2>/dev/null | jq -r '.[] | select(.unread) | "  · \(.date)  \(.title)"')"
        [[ -n "$news" ]] && { log "⚠ Arch news since your last upgrade:"; log "$news"; }
        cmd_update repo system || ((fail++))
    fi
    if [[ "$(jq '[.[] | select(.source == "flatpak")] | length' <<<"$list")" -gt 0 ]]; then
        log "→ flatpak update"
        flatpak update -y --noninteractive || ((fail++))
        history_add update flatpak "all" $?
    fi
    while IFS=$'\t' read -r src id; do
        cmd_update "$src" "$id" || ((fail++))
    done < <(jq -r '.[] | select(.source == "github" or .source == "appimage") | [.source, .id] | @tsv' <<<"$list")
    # the deck itself goes last: installing it reloads the GUI
    if [[ "$(jq '[.[] | select(.source == "deck")] | length' <<<"$list")" -gt 0 ]]; then
        cmd_update deck control-deck || ((fail++))
    fi
    local aur; aur="$(jq -r '.[] | select(.source == "aur") | .id' <<<"$list")"
    if [[ -n "$aur" ]]; then
        # shellcheck disable=SC2086
        install_aur $aur || ((fail++))
        history_add update aur "$(tr '\n' ' ' <<<"$aur")" 0
    fi
    log "═════════════════════════════════════════"
    if [[ $fail -eq 0 ]]; then log "✔ Update complete."; notify "Updated ✓" "$n update(s)"
    else log "⚠ Finished with $fail error(s)."; notify "Update finished with errors ✗" "$fail failure(s)"; fi
    [[ $fail -eq 0 ]]
}

# ---------------------------------------------------------------------------
# Background update check (opt-in): a systemd user timer runs
# `control-deck notify-updates`; the GUI doesn't need to be open.
# ---------------------------------------------------------------------------
TIMER_NAME="control-deck-updates"

open_deck() {   # open the GUI on a given tab
    CONTROL_DECK_VIEW="$1" setsid -f qs -c control-deck >/dev/null 2>&1
}

cmd_notify_updates() {
    local list n sig summary action
    list="$(cmd_updates)"; n="$(jq length <<<"$list")"
    mkdir -p "$STATE_DIR"
    [[ "$n" -eq 0 ]] && { rm -f "$STATE_DIR/last-notified"; return 0; }
    # don't nag twice about exactly the same set of updates
    sig="$(jq -r '.[] | .source + ":" + .id + ":" + .new' <<<"$list" | sort | md5sum | cut -d' ' -f1)"
    [[ -f "$STATE_DIR/last-notified" && "$(cat "$STATE_DIR/last-notified")" == "$sig" ]] && return 0
    echo "$sig" > "$STATE_DIR/last-notified"
    summary="$(jq -r 'group_by(.source) | map("\(length) \(.[0].source)") | join(" · ")' <<<"$list")"
    have notify-send || return 0
    # waits for a click (bounded, so the service never hangs)
    action="$(timeout 15m notify-send -a "Control Deck" -i "$(deck_icon)" \
              -A "open=Open Control Deck" "$n update(s) available" "$summary" 2>/dev/null)"
    [[ "$action" == open ]] && open_deck updates
    return 0
}

cmd_timer() {
    local self; self="$(readlink -f "$0")"
    case "$1" in
        on)
            local hours="${2:-6}"
            [[ "$hours" =~ ^[0-9]+$ && "$hours" -ge 1 ]] || { err "hours must be a positive number"; return 2; }
            mkdir -p "$UNIT_DIR"
            cat > "$UNIT_DIR/$TIMER_NAME.service" <<EOF
[Unit]
Description=Control Deck: check for updates

[Service]
Type=oneshot
ExecStart=$self notify-updates
TimeoutStartSec=20min
EOF
            cat > "$UNIT_DIR/$TIMER_NAME.timer" <<EOF
[Unit]
Description=Control Deck: check for updates every $hours hours

[Timer]
OnBootSec=15min
OnUnitActiveSec=${hours}h
Persistent=true

[Install]
WantedBy=timers.target
EOF
            systemctl --user daemon-reload && systemctl --user enable --now "$TIMER_NAME.timer" \
                || { err "could not enable the timer"; return 4; }
            log "✔ Background update check enabled (every ${hours}h). You'll get a notification when there are updates."
            history_add "auto-check on" updates "timer" 0 ;;
        off)
            systemctl --user disable --now "$TIMER_NAME.timer" >/dev/null 2>&1
            rm -f "$UNIT_DIR/$TIMER_NAME.service" "$UNIT_DIR/$TIMER_NAME.timer"
            systemctl --user daemon-reload 2>/dev/null
            log "✔ Background update check disabled."
            history_add "auto-check off" updates "timer" 0 ;;
        status|"")
            if systemctl --user is-enabled --quiet "$TIMER_NAME.timer" 2>/dev/null; then echo on; else echo off; fi ;;
        *) err "use: timer on [hours]|off|status"; return 2 ;;
    esac
}

# ===========================================================================
# Arch news — read them before a system upgrade
# ===========================================================================
last_upgrade_epoch() {
    local l; l="$(grep -F 'starting full system upgrade' "$PACMAN_LOG" 2>/dev/null | tail -1)"
    l="${l#\[}"; l="${l%%\]*}"
    [[ -n "$l" ]] && date -d "$l" +%s 2>/dev/null || echo 0
}

html_decode() { sed -e 's/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&#39;/'"'"'/g; s/&#x27;/'"'"'/g; s/&amp;/\&/g'; }

# JSON [{title, link, date, epoch, summary, unread}] — unread = published
# after the last full system upgrade recorded in pacman.log
cmd_news() {
    local rss last it title link pub desc epoch
    rss="$(curl -fsS --max-time 10 "$NEWS_URL")" || { err "could not fetch the Arch news"; echo "[]"; return 4; }
    last="$(last_upgrade_epoch)"
    tr '\n' ' ' <<<"$rss" | sed 's/<item>/\n<item>/g' | grep '^<item>' | head -10 |
    while IFS= read -r it; do
        title="$(sed -nE 's|.*<title>([^<]*)</title>.*|\1|p' <<<"$it" | html_decode)"
        link="$(sed -nE 's|.*<link>([^<]*)</link>.*|\1|p' <<<"$it")"
        pub="$(sed -nE 's|.*<pubDate>([^<]*)</pubDate>.*|\1|p' <<<"$it")"
        desc="$(sed -nE 's|.*<description>([^<]*)</description>.*|\1|p' <<<"$it" | html_decode \
                | sed -E 's/<[^>]*>//g' | html_decode | tr -s ' ' | cut -c1-280)"
        epoch="$(date -d "$pub" +%s 2>/dev/null || echo 0)"
        printf '%s\n' "$title" "$link" "$(date -d "@$epoch" +%F)" "$epoch" "$desc" "$(( epoch > last ))"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 6) as $i |
        {title:$l[$i], link:$l[$i+1], date:$l[$i+2], epoch:($l[$i+3]|tonumber),
         summary:$l[$i+4], unread:($l[$i+5] == "1")}]'
}

# ===========================================================================
# Self-update — the deck checks GitHub for a newer version of itself.
# install.sh records where it was installed from (repo, branch, commit).
# ===========================================================================
install_info() { [[ -f "$INSTALL_INFO" ]] && sed -n "s/^$1=//p" "$INSTALL_INFO" | head -1; }

cmd_version() {
    local c; c="$(install_info COMMIT)"
    printf 'COMMIT=%s\nSHORT=%s\nREPO=%s\nSRC=%s\nDATE=%s\n' "$c" "${c:0:7}" \
        "$(install_info REPO)" "$(install_info SRC)" "$(install_info DATE)"
}

# pending self-update as an update record (same 5-line format as upd_*)
upd_self() {
    local repo commit branch cmp
    repo="$(install_info REPO)"; commit="$(install_info COMMIT)"; branch="$(install_info BRANCH)"
    [[ -n "$repo" && -n "$commit" ]] || return 0
    cmp="$(gh_api "repos/$repo/compare/$commit...${branch:-main}" 2>/dev/null)" || return 0
    # "ahead": GitHub has commits the installed version doesn't
    jq -e '.status == "ahead" or .status == "diverged"' <<<"$cmp" >/dev/null 2>&1 || return 0
    printf '%s\n' deck control-deck "Control Deck" "${commit:0:7}" \
        "$(jq -r '"\(.commits | last | .sha[0:7]) (+\(.ahead_by))"' <<<"$cmp")"
}

cmd_selfupdate() {
    local src repo branch tmp sha
    src="$(install_info SRC)"; repo="$(install_info REPO)"; branch="$(install_info BRANCH)"
    repo="${repo:-madkyp/control-deck}"; branch="${branch:-main}"
    if [[ -n "$src" ]] && git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
        log "→ git pull in $src"
        git -C "$src" pull --ff-only || { err "git pull failed (local changes?): update $src by hand"; return 4; }
        log "→ reinstalling"
        "$src/install.sh" --no-deps || return 4
    else
        # installed from a copy that isn't a git clone: fetch the branch tarball
        sha="$(gh_api "repos/$repo/commits/$branch" | jq -r '.sha // empty')"
        tmp="$(mktemp -d)"
        log "→ downloading $repo@$branch"
        curl -fsSL --max-time 60 "https://codeload.github.com/$repo/tar.gz/refs/heads/$branch" \
            | tar xz -C "$tmp" --strip-components=1 || { err "download failed"; rm -rf "$tmp"; return 4; }
        CONTROL_DECK_COMMIT="$sha" CONTROL_DECK_REPO="$repo" "$tmp/install.sh" --no-deps || { rm -rf "$tmp"; return 4; }
        rm -rf "$tmp"
    fi
    history_add update deck "control-deck $(install_info COMMIT | cut -c1-7)" 0
    log "✔ Control Deck updated to $(install_info COMMIT | cut -c1-7). The window reloads by itself."
}

# ===========================================================================
# Snapshots (snapper) — list, create, package diff, permission helper
# ===========================================================================
snapper_can_list() { snapper -c "$SNAPPER_CONFIG" --jsonout list >/dev/null 2>&1; }

cmd_snapstatus() {
    local ready=false canlist=false pac=false grub=false assist=false
    snapper_ready && ready=true
    [[ $ready == true ]] && snapper_can_list && canlist=true
    snap_pac_installed && pac=true
    pacman -Q grub-btrfs >/dev/null 2>&1 && grub=true
    have btrfs-assistant && assist=true
    jq -n --argjson r "$ready" --argjson c "$canlist" --argjson p "$pac" --argjson g "$grub" \
          --argjson a "$assist" --arg cfg "$SNAPPER_CONFIG" \
        '{snapper:$r, config:$cfg, canlist:$c, snappac:$p, grubbtrfs:$g, assistant:$a}'
}

# snapper's JSON → [{num,type,pre,date,user,cleanup,desc,important}], newest first
snap_json() {
    jq --arg c "$SNAPPER_CONFIG" '(.[$c] // []) | map(select(.number != 0)) | reverse | map({
        num:.number, type:(.type // "single"), pre:(.["pre-number"] // null), date:(.date // ""),
        user:(.user // ""), cleanup:(.cleanup // ""), desc:(.description // ""),
        important:((.userdata // {}).important == "yes")})'
}

cmd_snaplist() {
    local out
    snapper_ready || { err "snapper has no '$SNAPPER_CONFIG' config"; echo "[]"; return 3; }
    if [[ "$1" == --root ]]; then
        out="$(pkexec snapper -c "$SNAPPER_CONFIG" --jsonout list)" || { echo "[]"; return 4; }
    else
        out="$(snapper -c "$SNAPPER_CONFIG" --jsonout list 2>/dev/null)" \
            || { err "listing snapshots needs root (or ALLOW_USERS)"; echo "[]"; return 3; }
    fi
    snap_json <<<"$out"
}

cmd_snapcreate() {
    local desc="${1:-manual snapshot}" n
    snapper_ready || { err "snapper has no '$SNAPPER_CONFIG' config"; return 3; }
    log "→ pkexec snapper create \"Control Deck: $desc\""
    n="$(pkexec snapper -c "$SNAPPER_CONFIG" create -c number -p -d "Control Deck: $desc" -u important=yes)" \
        || { err "could not create the snapshot"; return 4; }
    log "✔ Snapshot #$n created."
    history_add snapshot "$SNAPPER_CONFIG" "#$n $desc" 0
}

# let the current user list snapshots without a password (opt-in, one-time)
cmd_snapallow() {
    local cur users
    snapper_ready || { err "snapper has no '$SNAPPER_CONFIG' config"; return 3; }
    cur="$(sed -n 's/^ALLOW_USERS="\(.*\)"/\1/p' "$SNAPPER_CONFIG_DIR/$SNAPPER_CONFIG")"
    users="$(tr ' ' '\n' <<<"$cur $USER" | awk 'NF && !seen[$0]++' | paste -sd' ')"
    log "→ pkexec snapper set-config ALLOW_USERS=\"$users\" SYNC_ACL=yes"
    pkexec snapper -c "$SNAPPER_CONFIG" set-config "ALLOW_USERS=$users" "SYNC_ACL=yes" \
        || { err "snapper set-config failed"; return 4; }
    log "✔ $USER can now list snapshots without a password."
    history_add "snapshots allow" "$SNAPPER_CONFIG" "$USER" 0
}

# delete snapshots: numbers and/or ranges (41 42 30-35), one password prompt
cmd_snapdelete() {
    local a lo hi
    snapper_ready || { err "snapper has no '$SNAPPER_CONFIG' config"; return 3; }
    [[ $# -gt 0 ]] || { err "use: snapdelete <number|from-to>…"; return 2; }
    for a in "$@"; do
        [[ "$a" =~ ^([0-9]+)(-([0-9]+))?$ ]] || { err "not a snapshot number or range: $a"; return 2; }
        lo="${BASH_REMATCH[1]}"; hi="${BASH_REMATCH[3]:-$lo}"
        (( lo >= 1 && hi >= lo )) || { err "invalid snapshot number/range: $a (0 is the live system)"; return 2; }
    done
    log "→ pkexec snapper -c $SNAPPER_CONFIG delete $*"
    pkexec snapper -c "$SNAPPER_CONFIG" delete "$@" || { err "snapper delete failed"; return 4; }
    log "✔ Deleted snapshot(s) $*. Btrfs frees the space in the background."
    history_add "snapshot delete" "$SNAPPER_CONFIG" "$*" 0
}

# apply snapper's cleanup rules now (what snapper-cleanup.timer does hourly)
cmd_snapcleanup() {
    snapper_ready || { err "snapper has no '$SNAPPER_CONFIG' config"; return 3; }
    log "→ pkexec snapper cleanup number · timeline · empty-pre-post"
    # shellcheck disable=SC2016
    pkexec sh -c 'for a in number timeline empty-pre-post; do snapper -c "$1" cleanup "$a" || exit 1; done' \
        sh "$SNAPPER_CONFIG" || { err "snapper cleanup failed"; return 4; }
    log "✔ Cleanup done (limits from /etc/snapper/configs/$SNAPPER_CONFIG: NUMBER_LIMIT, NUMBER_LIMIT_IMPORTANT, TIMELINE_LIMIT_*)."
    history_add "snapshot cleanup" "$SNAPPER_CONFIG" "cleanup" 0
}

# cleanup limits of the config, for the GUI (KEY=VALUE)
cmd_snaplimits() {
    snapper_ready || return 3
    grep -E '^(NUMBER_CLEANUP|NUMBER_LIMIT|NUMBER_LIMIT_IMPORTANT|NUMBER_MIN_AGE|TIMELINE_CREATE|TIMELINE_CLEANUP|QGROUP)=' \
        "$SNAPPER_CONFIG_DIR/$SNAPPER_CONFIG" | tr -d '"'
    printf 'CLEANUP_TIMER=%s\n' "$(systemctl is-enabled snapper-cleanup.timer 2>/dev/null || echo disabled)"
}

# packages (name<TAB>version) from a pacman local db listing on stdin
db_pkgs() { awk 'NF { n = $0; sub(/-[^-]+-[^-]+$/, "", n); print n "\t" substr($0, length(n) + 2) }' | sort; }

# which packages changed between a snapshot and now
cmd_snapdiff() {
    local n="$1" db old new
    [[ "$n" =~ ^[0-9]+$ ]] || { err "use: snapdiff <snapshot number>"; return 2; }
    db="$SNAPSHOTS_DIR/$n/snapshot${PACMAN_DB}"
    if [[ -r "$db" ]]; then old="$(ls "$db")"
    else old="$(pkexec ls "$db")" || { err "could not read snapshot #$n"; return 4; }; fi
    new="$(ls "$PACMAN_DB")"
    log "Packages changed since snapshot #$n:"
    join -t $'\t' -a1 -a2 -e '' -o 0,1.2,2.2 <(db_pkgs <<<"$old") <(db_pkgs <<<"$new") |
    awk -F'\t' '
        $2 == ""  { a++; print "  + " $1 " " $3; next }
        $3 == ""  { r++; print "  - " $1 " " $2; next }
        $2 != $3  { c++; print "  ~ " $1 "  " $2 " → " $3 }
        END { printf "Total: %d added, %d removed, %d changed.\n", a, r, c }'
}

# ===========================================================================
# System clean-up
# ===========================================================================
dir_bytes() { du -sb "$@" 2>/dev/null | awk '{s += $1} END {print s + 0}'; }

# launchers in the user dir whose program no longer exists
broken_launchers() {
    local f exec bin
    for f in "$DESKTOP_DIR"/*.desktop; do
        [[ -f "$f" ]] || continue
        [[ "$(dget "$f" Type)" == "Application" ]] || continue
        exec="$(dget "$f" Exec)"; [[ -z "$exec" ]] && continue
        bin="$(exec_bin "$exec")"; [[ -z "$bin" ]] && continue
        if [[ "$bin" == /* ]]; then [[ -e "$bin" ]] && continue
        else have "$bin" && continue; fi
        echo "$f"
    done
}

# --- unused Proton versions (SYSTEM → CLEAN) ---------------------------------
# internal name of a compatibility tool (first block inside "compat_tools";
# lines may carry // comments)
compat_tool_name() {
    sed 's|//.*||' "$1" | awk '/"compat_tools"/ { f = 1; next }
        f && /"[^"]+"/ { match($0, /"[^"]*"/); print substr($0, RSTART + 1, RLENGTH - 2); exit }'
}

# every tool name Steam has assigned (per game, and "0" = the default)
steam_compat_used() {
    local cfg; cfg="$(steam_root)/config/config.vdf"; [[ -f "$cfg" ]] || return 0
    awk -v P="$COMPAT_MAPPING" '
        BEGIN { n = split(tolower(P), want, "/") }
        function under(   i) { if (d != n + 1) return 0; for (i = 1; i <= n; i++) if (st[i] != want[i]) return 0; return 1 }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ { match($0, /"[^"]*"/); pend = tolower(substr($0, RSTART + 1, RLENGTH - 2)); next }
        /^[ \t]*\{/ { st[++d] = pend; next }
        /^[ \t]*\}/ { d--; next }
        under() && match($0, /^[ \t]*"name"[ \t]+"/) {
            v = substr($0, RLENGTH + 1); sub(/"[ \t]*$/, "", v); if (v != "") print v }' "$cfg" | sort -u
}

# user-installed tools: dir <TAB> internal name <TAB> version (from its `version` file)
user_compat_tools() {
    local r d seen="" real
    for r in "$(steam_root)/compatibilitytools.d" "$HOME/.steam/root/compatibilitytools.d"; do
        for d in "$r"/*/; do
            d="${d%/}"; [[ -f "$d/compatibilitytool.vdf" ]] || continue
            real="$(readlink -f "$d")"; [[ "$seen" == *$'\n'"$real"$'\n'* ]] && continue
            seen+=$'\n'"$real"$'\n'
            printf '%s\t%s\t%s\n' "$real" "$(compat_tool_name "$d/compatibilitytool.vdf")" \
                "$(awk '{ print $2; exit }' "$d/version" 2>/dev/null)"
        done
    done
}

# tools nothing uses: not assigned in Steam, not a runner in Umbral's config
# ("GE-Proton" there = the newest GE it finds, which can be one of Steam's),
# no non-Steam prefix made by them (Umbral/umu keep using the prefix's Proton),
# and not running. Proton that comes with Steam or a package isn't listed.
unused_compat_tools() {
    local pfx="${1:-}" steam_used umbral_used pfx_vers ge d g name ver
    [[ -n "$pfx" ]] || pfx="$(cmd_prefixes)"
    steam_used="$(steam_compat_used)"
    umbral_used="$(umbral_json | jq -r '[.. | objects | .runner? | strings] | unique[]' 2>/dev/null)"
    if grep -qx GE-Proton <<<"$umbral_used"; then
        ge="$(for d in "$DATA_HOME/umbral/runners" "$(steam_root)/compatibilitytools.d" \
                       "$HOME/.steam/root/compatibilitytools.d" /usr/share/steam/compatibilitytools.d; do
                  for g in "$d"/GE-Proton*/; do [[ -f "$g/proton" ]] && basename "$g"; done
              done | sort -V | tail -1)"
        umbral_used+=$'\n'"$ge"
    fi
    pfx_vers="$(jq -r '.prefixes[] | select(.owner != "steam") | .version | strings' <<<"$pfx")"
    while IFS=$'\t' read -r d name ver; do
        [[ -n "$d" ]] || continue
        grep -qxF -- "$name" <<<"$steam_used" && continue
        grep -qxF -- "${d##*/}" <<<"$umbral_used" && continue
        [[ -n "$ver" ]] && grep -qxF -- "$ver" <<<"$pfx_vers" && continue
        grep -qsaF -- "$d/" "${PROC_ROOT:-/proc}"/[0-9]*/cmdline 2>/dev/null && continue
        printf '%s\t%s\n' "$d" "$name"
    done < <(user_compat_tools)
}

# clean items, one field per line: id title desc count bytes details
clean_items() {
    local list n bytes out

    list="$(pacman -Qdtq 2>/dev/null)"
    n=0; bytes=0
    if [[ -n "$list" ]]; then
        n="$(wc -l <<<"$list")"
        # shellcheck disable=SC2086
        bytes="$(LC_ALL=C pacman -Qi $list 2>/dev/null | awk -F': ' '/^Installed Size/ {
            split($2, a, " "); m = 1
            if (a[2] ~ /^KiB/) m = 1024; else if (a[2] ~ /^MiB/) m = 1048576; else if (a[2] ~ /^GiB/) m = 1073741824
            s += a[1] * m } END { printf "%d", s }')"
    fi
    printf '%s\n' orphans "Orphan packages" "Dependencies no package needs any more (pacman -Rns)." \
        "$n" "$bytes" "$(tr '\n' ' ' <<<"$list")"

    if have paccache; then
        out="$(LC_ALL=C paccache -dk1 2>/dev/null; LC_ALL=C paccache -duk0 2>/dev/null)"
        n="$(grep -oE '[0-9]+ candidates' <<<"$out" | awk '{s += $1} END {print s + 0}')"
        bytes="$(grep -oE 'saved: [0-9.]+ [KMGT]iB' <<<"$out" | awk '{
            m = 1024; if ($3 == "MiB") m = 1048576; else if ($3 == "GiB") m = 1073741824; else if ($3 == "TiB") m = 1099511627776
            s += $2 * m } END { printf "%d", s }')"
        printf '%s\n' pkgcache "Pacman cache" "Old package versions (the latest one is kept: paccache -rk1)." \
            "$n" "$bytes" ""
    fi

    if have flatpak; then
        out="$(for i in --user --system; do echo n | LC_ALL=C flatpak uninstall --unused "$i" 2>/dev/null; done)"
        n="$(grep -cE '^[[:space:]]*[0-9]+\.[[:space:]]' <<<"$out")"
        printf '%s\n' flatpak "Unused Flatpak runtimes" "Runtimes and extensions no app needs." \
            "$n" "" ""
    fi

    local aurdirs=("$CACHE_HOME/yay" "$CACHE_HOME/paru/clone")
    bytes="$(dir_bytes "${aurdirs[@]}")"
    n="$(find "${aurdirs[@]}" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
    printf '%s\n' aurcache "AUR cache" "Sources and builds kept by yay/paru." "$n" "$bytes" ""

    bytes="$(dir_bytes "$DL_DIR")"
    n="$(find "$DL_DIR" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
    printf '%s\n' downloads "Control Deck downloads" "Files downloaded from GitHub/URLs." "$n" "$bytes" ""

    list="$(broken_launchers)"
    n=0; [[ -n "$list" ]] && n="$(wc -l <<<"$list")"
    printf '%s\n' broken "Broken launchers" "Menu entries whose program no longer exists (moved to a trash folder)." \
        "$n" "" "$(while IFS= read -r f; do [[ -n "$f" ]] && printf '%s · ' "$(dget "$f" Name)"; done <<<"$list")"

    # gaming: the same data as GAMING → SHADERS / PREFIXES
    local sc pfx
    sc="$(cmd_shadercache 2>/dev/null)"; [[ -n "$sc" ]] || sc='{"games":[],"global":[],"staleBytes":0,"orphanBytes":0}'
    printf '%s\n' shaders "Shader caches" \
        "Driver caches older than the last driver update, and caches of uninstalled games (rebuilt when needed)." \
        "$(jq '[.games[] | select(.stale or (.installed | not))] + [.global[] | select(.stale)] | length' <<<"$sc")" \
        "$(jq '.staleBytes + .orphanBytes' <<<"$sc")" ""

    pfx="$(cmd_prefixes 2>/dev/null)"; [[ -n "$pfx" ]] || pfx='{"prefixes":[]}'
    printf '%s\n' prefixes "Orphan prefixes" "Wine prefixes of uninstalled Steam games (each one is backed up first)." \
        "$(jq '[.prefixes[] | select(.orphan and (.running | not))] | length' <<<"$pfx")" \
        "$(jq '[.prefixes[] | select(.orphan and (.running | not)) | .size] | add // 0' <<<"$pfx")" \
        "$(jq -r '[.prefixes[] | select(.orphan and (.running | not)) | .name] | join(" · ")' <<<"$pfx")"

    list="$(unused_compat_tools "$pfx")"
    n=0; bytes=0
    if [[ -n "$list" ]]; then
        n="$(wc -l <<<"$list")"
        local dirs=(); mapfile -t dirs < <(cut -f1 <<<"$list")
        bytes="$(dir_bytes "${dirs[@]}")"
    fi
    printf '%s\n' protons "Unused Proton versions" \
        "Proton builds in compatibilitytools.d no Steam game, Umbral prefix or running game uses." \
        "$n" "$bytes" "$(cut -f2 <<<"$list" | paste -sd '|' | sed 's/|/ · /g')"
}

cmd_cleanscan() {
    clean_items | jq -Rn '[inputs] as $l | [range(0; $l|length; 6) as $i |
        {id:$l[$i], title:$l[$i+1], desc:$l[$i+2], count:($l[$i+3]|tonumber? // 0),
         bytes:($l[$i+4]|tonumber? // null), details:$l[$i+5]}]
        | map(. + {size:(if .bytes == null then "" else (.bytes |
            if . >= 1073741824 then "\((. / 1073741824 * 10 | floor) / 10) GiB"
            elif . >= 1048576 then "\((. / 1048576 * 10 | floor) / 10) MiB"
            elif . >= 1024 then "\(. / 1024 | floor) KiB" else "\(.) B" end) end)})'
}

clean_one() {
    local id="$1" list f
    case "$id" in
        orphans)
            list="$(pacman -Qdtq 2>/dev/null)"
            [[ -z "$list" ]] && { log "✔ No orphans."; return 0; }
            log "→ pkexec pacman -Rns $(tr '\n' ' ' <<<"$list")"
            # shellcheck disable=SC2086
            pk_pacman -Rns --noconfirm $list || { err "pacman -Rns failed"; return 4; }
            log "✔ Orphans removed." ;;
        pkgcache)
            have paccache || { err "install pacman-contrib (paccache)"; return 4; }
            log "→ pkexec paccache -rk1 · paccache -ruk0"
            pkexec sh -c 'paccache -rk1 && paccache -ruk0' || { err "paccache failed"; return 4; }
            log "✔ Pacman cache cleaned." ;;
        flatpak)
            log "→ flatpak uninstall --unused"
            flatpak uninstall --unused -y --noninteractive --user
            flatpak uninstall --unused -y --noninteractive --system || { err "flatpak failed"; return 4; }
            log "✔ Unused runtimes removed." ;;
        aurcache)
            local d
            for d in "$CACHE_HOME/yay" "$CACHE_HOME/paru/clone"; do
                [[ -d "$d" ]] && find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && log "→ emptied ${d/#$HOME/\~}"
            done
            log "✔ AUR cache cleaned." ;;
        downloads)
            [[ -d "$DL_DIR" ]] && find "$DL_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
            log "✔ Downloads deleted." ;;
        broken)
            local dest; dest="$TRASH_DIR/$(date +%Y%m%d-%H%M%S)"
            while IFS= read -r f; do
                [[ -z "$f" ]] && continue
                mkdir -p "$dest"; mv -f "$f" "$dest/"
                log "→ $(basename "$f") → trash"
            done < <(broken_launchers)
            refresh_menu
            log "✔ Broken launchers moved to ${dest/#$HOME/\~}" ;;
        shaders)
            local sc rc=0; sc="$(cmd_shadercache)"
            if [[ "$(jq '.orphanBytes' <<<"$sc")" != 0 ]]; then cmd_shaderclean orphans || rc=$?; fi
            if [[ "$(jq '.staleBytes' <<<"$sc")" != 0 ]]; then cmd_shaderclean stale || rc=$?; fi
            return $rc ;;
        prefixes)
            local p rc=0
            while IFS= read -r p; do
                [[ -n "$p" ]] || continue
                cmd_prefix delete "$p" || rc=$?
            done < <(cmd_prefixes | jq -r '.prefixes[] | select(.orphan and (.running | not)) | .path')
            ((rc == 0)) && log "✔ Orphan prefixes removed (backups in ${PREFIX_BACKUPS/#$HOME/\~})."
            return $rc ;;
        protons)
            local d name
            while IFS=$'\t' read -r d name; do
                [[ -n "$d" && "$d" == */compatibilitytools.d/* && "$d" == "$HOME"/* ]] || continue
                rm -rf -- "$d" && log "→ removed $name (${d/#$HOME/\~})"
            done < <(unused_compat_tools)
            log "✔ Unused Proton versions removed. Steam lists its tools at startup: restart it if it's open." ;;
        *) err "unknown clean-up: $id"; return 2 ;;
    esac
}

cmd_clean() {
    clean_one "$1"; local rc=$?
    history_add clean "$1" "$1" $rc
    return $rc
}

# ===========================================================================
# Backup: export / restore the set of installed apps
# ===========================================================================
cmd_export() {
    local out="${1:-$HOME/control-deck-backup-$(date +%F).json}"
    local flat appimgs launchers f
    flat="$(flatpak list --app --columns=application,origin,installation 2>/dev/null \
            | jq -Rs 'split("\n") | map(select(. != "") | split("\t") | {id:.[0], remote:.[1], installation:.[2]})')"
    [[ -z "$flat" ]] && flat="[]"
    appimgs="$(while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            jq -cn --arg n "$(dget "$f" Name)" --arg t "$(coarse_source "$f" "")" \
                   --arg g "$(dget "$f" X-ControlDeck-Github)" --arg a "$(dget "$f" X-ControlDeck-Asset)" \
                   --arg d "$(basename "$f")" '{name:$n, type:$t, github:$g, asset:$a, launcher:$d}'
        done < <(our_launchers) | jq -s '.')"
    # launchers edited in the deck (with their managed icon embedded)
    launchers="$(for f in "$DESKTOP_DIR"/*.desktop; do
            [[ -f "$f" && "$(dget "$f" X-ControlDeck-Edited)" == true ]] || continue
            [[ -n "$(dget "$f" X-ControlDeck-Type)" ]] && continue      # recreated on reinstall
            local ic b64=""; ic="$(dget "$f" Icon)"
            [[ "$ic" == "$ICON_DIR/"* && -f "$ic" ]] && b64="$(base64 -w0 "$ic")"
            jq -cn --arg file "$(basename "$f")" --rawfile c "$f" --arg icon "${ic##*/}" --arg b "$b64" \
                '{file:$file, content:$c, icon:(if $b == "" then null else {name:$icon, data:$b} end)}'
        done | jq -s '.')"
    jq -n --arg date "$(date -Is)" --arg host "$(uname -n)" \
          --argjson flat "$flat" --argjson appimgs "$appimgs" --argjson launchers "$launchers" \
          --arg repo "$(pacman -Qqen 2>/dev/null)" --arg aur "$(pacman -Qqem 2>/dev/null)" '
        {app:"control-deck", version:1, date:$date, host:$host,
         repo:($repo | split("\n") | map(select(. != ""))),
         aur:($aur | split("\n") | map(select(. != ""))),
         flatpak:$flat, appimages:$appimgs, launchers:$launchers}' > "$out" \
        || { err "could not write $out"; return 4; }
    log "✔ Backup saved to $out"
    log "  $(jq -r '"\(.repo|length) repo · \(.aur|length) AUR · \(.flatpak|length) flatpak · \(.appimages|length) AppImage/tar · \(.launchers|length) edited launchers"' "$out")"
    history_add export backup "$(basename "$out")" 0
}

cmd_restore() {
    local file="$1" fail=0
    [[ -f "$file" ]] || { err "not found: $file"; return 2; }
    jq -e '.app == "control-deck"' "$file" >/dev/null 2>&1 || { err "not a Control Deck backup"; return 3; }
    log "Restoring backup from $(jq -r '.host + " · " + .date' "$file")"
    log "═════════════════════════════════════════"

    # repo packages that are missing and still exist in the repos
    local missing
    missing="$(comm -23 <(jq -r '.repo[]' "$file" | sort -u) <(pacman -Qq | sort -u) \
               | comm -12 - <(pacman -Slq 2>/dev/null | sort -u))"
    if [[ -n "$missing" ]]; then
        log "→ Repos: $(wc -l <<<"$missing") package(s) to install"
        # shellcheck disable=SC2086
        pk_pacman -S --needed --noconfirm $missing || { err "pacman -S failed"; ((fail++)); }
    else log "✔ Repos: nothing to install"; fi

    # flatpak apps
    local id remote inst
    while IFS=$'\t' read -r id remote inst; do
        [[ -z "$id" ]] && continue
        flatpak info "$id" >/dev/null 2>&1 && continue
        log "→ Flatpak: $id"
        flatpak install "--${inst:-user}" -y --noninteractive "${remote:-flathub}" "$id" || ((fail++))
    done < <(jq -r '.flatpak[] | [.id, .remote, .installation] | @tsv' "$file")

    # AppImages / tarballs from GitHub are reinstalled; others are listed
    # ("-" placeholders: bash `read` would collapse empty tab-separated fields)
    local name repo asset rel url type launcher
    while IFS=$'\t' read -r name type repo asset launcher; do
        [[ -z "$name" || -f "$DESKTOP_DIR/$launcher" ]] && continue
        [[ "$asset" == - ]] && asset=""
        if [[ "$repo" != - ]]; then
            [[ -n "$(gh_launcher "$repo")" ]] && continue
            rel="$(gh_latest "$repo")" || { err "$repo: no releases"; ((fail++)); continue; }
            url="$(gh_pick_asset "$rel" "$asset" "$type")"
            [[ -z "$url" ]] && { err "$repo: no matching file"; ((fail++)); continue; }
            cmd_ghinstall "$url" "$repo@$(jq -r .tag_name <<<"$rel")" || ((fail++))
        else
            log "⚠ $name ($type) doesn't come from GitHub: reinstall it manually."
        fi
    done < <(jq -r '.appimages[] | [.name, .type, (.github | if . == "" then "-" else . end),
                        (.asset | if . == "" then "-" else . end), .launcher] | @tsv' "$file")

    # edited launchers (+ their icons)
    local n i lf ic
    n="$(jq '.launchers | length' "$file")"
    for ((i = 0; i < n; i++)); do
        lf="$DESKTOP_DIR/$(jq -r ".launchers[$i].file" "$file")"
        mkdir -p "$DESKTOP_DIR"
        jq -j ".launchers[$i].content" "$file" > "$lf"; chmod 755 "$lf"
        ic="$(jq -r ".launchers[$i].icon.name // empty" "$file")"
        if [[ -n "$ic" ]]; then
            mkdir -p "$ICON_DIR"
            jq -r ".launchers[$i].icon.data" "$file" | base64 -d > "$ICON_DIR/$ic"
            desktop_set "$lf" "$lf" "Icon=$ICON_DIR/$ic"
        fi
        log "→ Launcher restored: $(dget "$lf" Name)"
    done
    refresh_menu

    # AUR last: it needs an interactive terminal
    missing="$(comm -23 <(jq -r '.aur[]' "$file" | sort -u) <(pacman -Qq | sort -u))"
    if [[ -n "$missing" ]]; then
        # shellcheck disable=SC2086
        install_aur $missing || ((fail++))
    fi

    log "═════════════════════════════════════════"
    if [[ $fail -eq 0 ]]; then log "✔ Restore complete."
    else log "⚠ Restore finished with $fail error(s)."; fi
    history_add restore backup "$(basename "$file")" $fail
    notify "Restore" "$([[ $fail -eq 0 ]] && echo complete || echo "$fail error(s)")"
    [[ $fail -eq 0 ]]
}

# --- history: JSON, newest first --------------------------------------------
cmd_history() {
    [[ -f "$HISTORY_FILE" ]] || { echo "[]"; return; }
    tail -n 300 "$HISTORY_FILE" | jq -Rn '[inputs | split("\t") |
        {date:.[0], action:.[1], source:.[2], target:.[3], result:.[4]}] | reverse'
}

# ===========================================================================
# GAMING — game library, per-game profiles, Steam integration, ProtonDB
# ===========================================================================
# Profiles live in $GAMING_DIR/profiles.json as {"default": {...}, "steam:<appid>": {...}}.
# A profile is applied by the `run` wrapper, which Steam calls through the
# game's launch options (`…/control-deck run %command%`). Everything the
# wrapper changes either dies with the game (env, nice, ionice) or is handled
# by gamemode, whose daemon restores the CPU governor when the registered
# process exits — even if it is killed — so no revert step can be missed.

# --- Valve KeyValues (.vdf) --------------------------------------------------
# Steam rewrites localconfig.vdf / config.vdf on exit, so every write below
# refuses to run while Steam is open. Keys are matched case-insensitively,
# like Steam does. BLOCK paths are "/"-separated (Root/Software/Valve/…).
vdf_escape() { local v="${1//\\/\\\\}"; printf '%s' "${v//\"/\\\"}"; }

# vdf_get <file> <block path> <key>
vdf_get() {
    awk -v P="$2" -v K="$3" '
        BEGIN { n = split(tolower(P), want, "/") }
        function here(   i) { if (d != n) return 0; for (i = 1; i <= n; i++) if (st[i] != want[i]) return 0; return 1 }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ { match($0, /"[^"]*"/); pend = tolower(substr($0, RSTART + 1, RLENGTH - 2)); next }
        /^[ \t]*\{/ { st[++d] = pend; next }
        /^[ \t]*\}/ { d--; next }
        here() && match($0, /^[ \t]*"[^"]*"/) {
            k = substr($0, RSTART, RLENGTH); gsub(/^[ \t]*"|"$/, "", k)
            if (tolower(k) == tolower(K)) {
                v = substr($0, RLENGTH + 1); sub(/^[ \t]*"/, "", v); sub(/"[ \t]*$/, "", v)
                gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v); print v; exit
            }
        }' "$1"
}

# vdf_set <file> <block path> KEY=VALUE…  — creates missing blocks; writes in place
vdf_set() {
    local file="$1" path="$2" kv sets tmp; shift 2
    sets="$(mktemp)"; tmp="$(mktemp)"
    for kv in "$@"; do printf '%s\t%s\n' "${kv%%=*}" "$(vdf_escape "${kv#*=}")"; done > "$sets"
    awk -v P="$path" -v SETS="$sets" '
        BEGIN {
            n = split(P, wantc, "/"); for (i = 1; i <= n; i++) want[i] = tolower(wantc[i])
            while ((getline l < SETS) > 0) { i = index(l, "\t"); key[++m] = substr(l, 1, i - 1); val[m] = substr(l, i + 1) }
        }
        function tabs(k,   s) { s = ""; while (k-- > 0) s = s "\t"; return s }
        function prefix(k,   i) { for (i = 1; i <= k; i++) if (st[i] != want[i]) return 0; return 1 }
        function emit_keys(ind,   j) { for (j = 1; j <= m; j++) if (!done[j]) { print tabs(ind) "\"" key[j] "\"\t\t\"" val[j] "\""; done[j] = 1 } }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ { match($0, /"[^"]*"/); pend = tolower(substr($0, RSTART + 1, RLENGTH - 2)); print; next }
        /^[ \t]*\{/ { st[++d] = pend; print; next }
        /^[ \t]*\}/ {
            if (!finished && d == n && prefix(n)) { emit_keys(d); finished = 1 }
            else if (!finished && d < n && prefix(d)) {
                # the rest of the path doesn'"'"'t exist yet: create it here
                for (i = d + 1; i <= n; i++) { print tabs(i - 1) "\"" wantc[i] "\""; print tabs(i - 1) "{" }
                emit_keys(n)
                for (i = n; i > d; i--) print tabs(i - 1) "}"
                finished = 1
            }
            d--; print; next
        }
        d == n && prefix(n) && match($0, /^[ \t]*"[^"]*"/) {
            k = substr($0, RSTART, RLENGTH); gsub(/^[ \t]*"|"$/, "", k)
            for (j = 1; j <= m; j++) if (!done[j] && tolower(k) == tolower(key[j])) {
                print tabs(d) "\"" k "\"\t\t\"" val[j] "\""; done[j] = 1; next_line = 1
            }
            if (next_line) { next_line = 0; next }
        }
        { print }' "$file" > "$tmp" || { rm -f "$sets" "$tmp"; return 1; }
    rm -f "$sets"
    cat "$tmp" > "$file"; rm -f "$tmp"
}

# vdf_del <file> <block path> [key]  — remove a key, or the whole block
vdf_del() {
    local file="$1" tmp; tmp="$(mktemp)"
    awk -v P="$2" -v K="$3" '
        BEGIN { n = split(tolower(P), want, "/") }
        function here(k,   i) { if (d != k) return 0; for (i = 1; i <= k; i++) if (st[i] != want[i]) return 0; return 1 }
        skip { if ($0 ~ /^[ \t]*\{/) depth++; else if ($0 ~ /^[ \t]*\}/ && --depth == 0) skip = 0; next }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ {
            match($0, /"[^"]*"/); nm = tolower(substr($0, RSTART + 1, RLENGTH - 2))
            if (K == "" && here(n - 1) && nm == want[n]) { skip = 1; depth = 0; next }
            pend = nm; print; next
        }
        /^[ \t]*\{/ { st[++d] = pend; print; next }
        /^[ \t]*\}/ { d--; print; next }
        K != "" && here(n) && match($0, /^[ \t]*"[^"]*"/) {
            k = substr($0, RSTART, RLENGTH); gsub(/^[ \t]*"|"$/, "", k)
            if (tolower(k) == tolower(K)) next
        }
        { print }' "$file" > "$tmp" && cat "$tmp" > "$file"
    rm -f "$tmp"
}

# --- Steam -------------------------------------------------------------------
steam_root() { echo "${CONTROL_DECK_STEAM_ROOT:-$HOME/.local/share/Steam}"; }

steam_running() {
    if [[ -n "${CONTROL_DECK_STEAM_RUNNING:-}" ]]; then [[ "$CONTROL_DECK_STEAM_RUNNING" == 1 ]]; return; fi
    pgrep -x steam >/dev/null 2>&1
}

# library folders (the Steam root is always one)
steam_libs() {
    local r; r="$(steam_root)"
    { echo "$r"; grep -oP '"path"\s+"\K[^"]+' "$r/steamapps/libraryfolders.vdf" 2>/dev/null; } | awk '!seen[$0]++'
}

# the logged-in user's localconfig.vdf (most recently written one)
steam_localconfig() {
    ls -t "$(steam_root)"/userdata/*/config/localconfig.vdf 2>/dev/null | head -1
}

LOCALCONFIG_APPS="UserLocalConfigStore/Software/Valve/Steam/apps"
COMPAT_MAPPING="InstallConfigStore/Software/Valve/Steam/CompatToolMapping"

# tools, runtimes and redistributables are not games
steam_is_tool() {
    case "$2" in
        Proton*|"Steam Linux Runtime"*|"Steamworks Common Redistributables"|SteamVR*) return 0 ;;
    esac
    [[ "$1" == 228980 ]]
}

# appid<US>name<US>installdir<US>size<US>library for every installed game
steam_games() {
    local lib m id name dir size
    while IFS= read -r lib; do
        for m in "$lib"/steamapps/appmanifest_*.acf; do
            [[ -f "$m" ]] || continue
            id="$(vdf_get "$m" AppState appid)"; name="$(vdf_get "$m" AppState name)"
            dir="$(vdf_get "$m" AppState installdir)"; size="$(vdf_get "$m" AppState SizeOnDisk)"
            steam_is_tool "$id" "$name" && continue
            printf '%s\n' "$id" "$name" "$dir" "${size:-0}" "$lib"
        done
    done < <(steam_libs)
}

control_deck_bin() {
    if [[ -x "$HOME/.local/bin/control-deck" ]]; then echo "$HOME/.local/bin/control-deck"; else readlink -f "$0"; fi
}

# --- profiles ----------------------------------------------------------------
GAMING_DIR="$STATE_DIR/gaming"
PROFILES="$GAMING_DIR/profiles.json"
DEFAULT_PROFILE='{"gamemode":true,"mangohud":false,"overlay":false,"fx":false,"fxMode":"vkbasalt","ionice":false,"nice":0,"env":{},"prefix":"","args":""}'

profiles_json() { if [[ -s "$PROFILES" ]]; then cat "$PROFILES"; else echo '{}'; fi; }

# effective profile of a game: built-in default ← user "default" ← game
profile_get() {
    profiles_json | jq -c --arg k "$1" --argjson d "$DEFAULT_PROFILE" \
        '. as $all | $d + ($all.default // {}) + ($all[$k] // {}) + {custom: ($all | has($k))}' 2>/dev/null \
        || echo "$DEFAULT_PROFILE"
}

profile_write() {   # profile_write <key> <json object to merge>; "null" deletes it
    mkdir -p "$GAMING_DIR"
    local tmp; tmp="$(mktemp)"
    profiles_json | jq --arg k "$1" --argjson p "$2" \
        'if $p == null then del(.[$k]) else .[$k] = ((.[$k] // {}) + $p) end' > "$tmp" \
        && mv "$tmp" "$PROFILES"
}

valid_game_key() { [[ "$1" =~ ^(default|steam:[0-9]+|[a-z]+:[A-Za-z0-9._:-]+)$ ]]; }

# gprofile get <key> | set <key> FIELD=VALUE… | reset <key>
cmd_gprofile() {
    local sub="$1" key="$2"; shift 2 2>/dev/null
    valid_game_key "$key" || { err "not a game key: $key (e.g. steam:1422450 or default)"; return 2; }
    case "$sub" in
        get) profile_get "$key" ;;
        reset) profile_write "$key" null; log "✔ Profile of $key reset to the default." ;;
        set)
            local patch='{}' kv f v e
            for kv in "$@"; do
                f="${kv%%=*}"; v="${kv#*=}"
                case "$f" in
                    gamemode|mangohud|overlay|ionice)
                        [[ "$v" == true || "$v" == false ]] || { err "$f must be true or false"; return 2; }
                        patch="$(jq -c --arg f "$f" --argjson v "$v" '.[$f] = $v' <<<"$patch")" ;;
                    nice)
                        [[ "$v" =~ ^-?[0-9]+$ ]] && (( v >= -10 && v <= 0 )) || { err "nice must be between -10 and 0"; return 2; }
                        patch="$(jq -c --argjson v "$v" '.nice = $v' <<<"$patch")" ;;
                    env)
                        # "VAR=value VAR2=value" — names checked, values without spaces
                        local obj='{}'
                        for e in $v; do
                            [[ "$e" =~ ^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*$ ]] || { err "bad environment variable: $e"; return 2; }
                            obj="$(jq -c --arg k "${e%%=*}" --arg x "${e#*=}" '.[$k] = $x' <<<"$obj")"
                        done
                        patch="$(jq -c --argjson o "$obj" '.env = $o' <<<"$patch")" ;;
                    prefix|args|name)
                        [[ "$v" != *[\"\'\`\$\;\&\|\<\>]* ]] || { err "$f can't contain quotes or shell characters"; return 2; }
                        patch="$(jq -c --arg f "$f" --arg v "$v" '.[$f] = $v' <<<"$patch")" ;;
                    *) err "unknown profile field: $f"; return 2 ;;
                esac
            done
            profile_write "$key" "$patch"
            log "✔ Profile of $key saved."
            history_add "game profile" "${key%%:*}" "$key" 0 ;;
        *) err "use: gprofile get|set|reset <key> …"; return 2 ;;
    esac
}

# --- run: the wrapper Steam (or Lutris/Heroic) calls around the game ---------
#   control-deck run [--profile <key>] [--] <command…>
cmd_run() {
    local key=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile) key="$2"; shift 2 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    [[ $# -gt 0 ]] || { err "use: control-deck run [--profile KEY] -- <command>"; return 2; }
    if [[ -z "$key" ]]; then
        if [[ -n "${SteamAppId:-}" && "$SteamAppId" != 0 ]]; then key="steam:$SteamAppId"; else key=default; fi
    fi
    valid_game_key "$key" || key=default

    local p pre=() extra=() name val
    p="$(profile_get "$key")"
    mkdir -p "$STATE_DIR/logs"
    local rlog="$STATE_DIR/logs/run.log"
    printf '%s  %s  %s\n' "$(date '+%F %T')" "$key" "$*" >> "$rlog"
    p="$(bench_overlay "$key" "$p")"
    # (runs in a subshell above, so the benchmark's MangoHud logging is exported here)
    local mhc; mhc="$(jq -r '.mangohudConfig // empty' <<<"$p")"
    [[ -n "$mhc" ]] && export MANGOHUD_CONFIG="$mhc"

    while IFS=$'\t' read -r name val; do
        [[ -n "$name" ]] && export "$name=$val"
    done < <(jq -r '.env | to_entries[] | [.key, .value] | @tsv' <<<"$p")

    local n; n="$(jq -r '.nice' <<<"$p")"
    if [[ "$n" != 0 ]]; then
        renice -n "$n" -p $$ >/dev/null 2>&1 || echo "  nice $n not allowed (join the gamemode group)" >> "$rlog"
    fi
    if [[ "$(jq -r '.ionice' <<<"$p")" == true ]]; then
        ionice -c2 -n0 -p $$ >/dev/null 2>&1 || echo "  ionice failed" >> "$rlog"
    fi
    [[ "$(jq -r '.gamemode' <<<"$p")" == true ]] && { have gamemoderun && pre+=(gamemoderun) || echo "  gamemode not installed" >> "$rlog"; }
    [[ "$(jq -r '.mangohud' <<<"$p")" == true ]] && { have mangohud && pre+=(mangohud) || echo "  mangohud not installed" >> "$rlog"; }
    read -ra extra <<<"$(jq -r '.prefix' <<<"$p")"; pre+=("${extra[@]}")
    read -ra extra <<<"$(jq -r '.args' <<<"$p")"
    # visual shaders: vkBasalt layer with this game's config
    if [[ "$(jq -r '.fx' <<<"$p")" == true ]]; then
        if [[ "$(jq -r '.fxMode // "vkbasalt"' <<<"$p")" == reshade ]]; then
            local rst api; rst="$(reshade_state "$key")"
            if [[ -n "$rst" ]]; then
                api="$(jq -r .api <<<"$rst")"
                export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}d3dcompiler_47=n;$api=n,b"
            else echo "  ReShade on but not installed in the game folder" >> "$rlog"; fi
        else
            local fxc; fxc="$(fx_key_dir "$key")/vkBasalt.conf"
            if [[ -s "$fxc" ]]; then export ENABLE_VKBASALT=1 VKBASALT_CONFIG_FILE="$fxc"
            else echo "  visual shaders on but no config at $fxc" >> "$rlog"; fi
        fi
    fi
    # this process becomes the game (exec), so the overlay follows our pid
    [[ "$(jq -r '.overlay' <<<"$p")" == true ]] && { cmd_overlay $$ || echo "  overlay not started" >> "$rlog"; }
    exec "${pre[@]}" "$@" "${extra[@]}"
}

# --- Steam launch options ------------------------------------------------------
# turn an existing launch-options string into profile fields (JSON), so
# "VAR=1 mangohud gamemoderun %command% -novid" keeps working once wrapped
adopt_launch_options() {
    local s="$1" before after tok env='{}' gm=false mh=false prefix=() args=""
    if [[ "$s" == *%command%* ]]; then before="${s%%%command%*}"; after="${s#*%command%}"
    else before=""; after="$s"; fi
    for tok in $before; do
        case "$tok" in
            gamemoderun) gm=true ;;
            mangohud) mh=true ;;
            [A-Za-z_]*=*) [[ "$tok" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && env="$(jq -c --arg k "${tok%%=*}" --arg v "${tok#*=}" '.[$k] = $v' <<<"$env")" || prefix+=("$tok") ;;
            *) prefix+=("$tok") ;;
        esac
    done
    args="$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<<"$after")"
    jq -cn --argjson env "$env" --argjson gm "$gm" --argjson mh "$mh" \
          --arg prefix "${prefix[*]}" --arg args "$args" \
          '{env:$env, gamemode:$gm, mangohud:$mh, prefix:$prefix, args:$args}'
}

wrapper_line() { printf '%s run %%command%%' "$(control_deck_bin)"; }

# steamwrap <appid> on|off — make Steam launch the game through the wrapper
cmd_steamwrap() {
    local id="$1" mode="$2" lc cur orig key
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: steamwrap <appid> on|off"; return 2; }
    steam_running && { err "close Steam first: it rewrites its config when it exits"; return 3; }
    lc="$(steam_localconfig)"; [[ -f "$lc" ]] || { err "Steam user config not found"; return 4; }
    key="steam:$id"
    cur="$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions)"
    cp -f "$lc" "$lc.control-deck.bak"
    case "$mode" in
        on)
            if [[ "$cur" == *"control-deck run"* ]]; then log "✔ Already launched through Control Deck."; return 0; fi
            if [[ "$cur" == *[\"\'\`\;\&\|]* ]]; then
                err "these launch options use quoting/shell syntax the deck won't rewrite: $cur"
                err "set them in the profile by hand, then try again"; return 3
            fi
            # what the game used is merged into its profile (even one saved before):
            # env adds up (the profile wins), prefix/args only fill empty fields,
            # gamemode/mangohud turn on if the old line used them
            if [[ -n "$cur" ]]; then
                profile_write "$key" "$(jq -cn --argjson a "$(adopt_launch_options "$cur")" --argjson p "$(profiles_json | jq -c --arg k "$key" '.[$k] // {}')" '
                    {env: ($a.env + ($p.env // {})),
                     prefix: (if ($p.prefix // "") == "" then $a.prefix else $p.prefix end),
                     args: (if ($p.args // "") == "" then $a.args else $p.args end)}
                    + (if $a.gamemode then {gamemode:true} else {} end)
                    + (if $a.mangohud then {mangohud:true} else {} end)')"
                log "→ Existing options merged into the profile: $cur"
            fi
            profile_write "$key" "$(jq -cn --arg o "$cur" '{original_launch:$o}')"
            vdf_set "$lc" "$LOCALCONFIG_APPS/$id" "LaunchOptions=$(wrapper_line)" || { err "could not write $lc"; return 4; }
            log "✔ Steam now launches $id through Control Deck: $(wrapper_line)" ;;
        off)
            orig="$(profiles_json | jq -r --arg k "$key" '.[$k].original_launch // ""')"
            if [[ -n "$orig" ]]; then vdf_set "$lc" "$LOCALCONFIG_APPS/$id" "LaunchOptions=$orig"
            else vdf_del "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions; fi
            log "✔ Steam launch options of $id restored${orig:+: $orig}" ;;
        *) err "use: steamwrap <appid> on|off"; return 2 ;;
    esac
    log "  (backup of the previous file: $lc.control-deck.bak)"
    history_add "steam launch $mode" steam "$id" 0
}

# --- Proton version per game ------------------------------------------------------
# JSON [{name, display}] of the compatibility tools Steam can use
cmd_compattools() {
    local r d f n disp; r="$(steam_root)"
    {
        [[ -d "$r/steamapps/common/Proton - Experimental" ]] && printf '%s\n' proton_experimental "Proton Experimental"
        for f in "$r"/compatibilitytools.d/*/compatibilitytool.vdf; do
            [[ -f "$f" ]] || continue
            # internal name = first block inside "compat_tools" (lines may carry // comments)
            n="$(sed 's|//.*||' "$f" | awk '/"compat_tools"/ { f = 1; next }
                  f && /"[^"]+"/ { match($0, /"[^"]*"/); print substr($0, RSTART + 1, RLENGTH - 2); exit }')"
            disp="$(grep -oP '"display_name"\s+"\K[^"]+' "$f" | head -1)"
            [[ -n "$n" ]] && printf '%s\n' "$n" "${disp:-$n}"
        done
    } | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i | {name:$l[$i], display:$l[$i+1]}]'
}

# steamcompat <appid> <tool name|default>
cmd_steamcompat() {
    local id="$1" tool="$2" cfg
    [[ "$id" =~ ^[0-9]+$ && -n "$tool" ]] || { err "use: steamcompat <appid> <tool|default>"; return 2; }
    steam_running && { err "close Steam first: it rewrites its config when it exits"; return 3; }
    cfg="$(steam_root)/config/config.vdf"; [[ -f "$cfg" ]] || { err "Steam config.vdf not found"; return 4; }
    if [[ "$tool" != default ]] && ! cmd_compattools | jq -e --arg t "$tool" 'any(.[]; .name == $t)' >/dev/null; then
        err "unknown compatibility tool: $tool"; return 2
    fi
    cp -f "$cfg" "$cfg.control-deck.bak"
    if [[ "$tool" == default ]]; then
        vdf_del "$cfg" "$COMPAT_MAPPING/$id"
        log "✔ $id uses Steam's default Proton again."
    else
        vdf_set "$cfg" "$COMPAT_MAPPING/$id" "name=$tool" "config=" "priority=250" || { err "could not write config.vdf"; return 4; }
        log "✔ $id will run with $tool."
    fi
    history_add "proton $tool" steam "$id" 0
}

# --- Umbral (github.com/madkyp/umbral-project) ---------------------------------------
# Umbral is the user's launcher for Battle.net and games from no store. Its
# library lives in ~/.config/umbral/config.json ({prefixes:[…], games:[…]});
# games start with `umbral --launch <id>`. Read-only here: launch options of
# Umbral games are Umbral's business.
UMBRAL_CONFIG="${CONTROL_DECK_UMBRAL_CONFIG:-$CONFIG_HOME/umbral/config.json}"

umbral_json() { if [[ -s "$UMBRAL_CONFIG" ]]; then cat "$UMBRAL_CONFIG"; else echo '{}'; fi; }

# JSON list of Umbral's (non-hidden) games, in the same shape as cmd_games entries
umbral_games() {
    [[ -s "$UMBRAL_CONFIG" ]] || { echo '[]'; return; }
    local g sizes="" exe
    # size of each game's folder (the .exe's directory); none for the Battle.net client itself
    while IFS=$'\t' read -r g exe; do
        [[ -n "$exe" && -f "$exe" ]] && sizes+="$g"$'\t'"$(dir_bytes "$(dirname "$exe")")"$'\n'
    done < <(jq -r '.games[]? | select(.hidden != true) | [.id, (.exe // "")] | @tsv' "$UMBRAL_CONFIG")
    jq -c --arg sizes "$sizes" '
        ($sizes | split("\n") | map(select(. != "") | split("\t") | {key:.[0], value:(.[1]|tonumber)}) | from_entries) as $sz
        | (.prefixes // []) as $px
        | [.games[]? | select(.hidden != true) | . as $g
           | ($px | map(select(.id == $g.prefix_id)) | first // {}) as $p
           | {key:("umbral:" + .id), source:"umbral", id:.id, name:.name, umbralKind:.kind,
              installdir:(if .exe != "" then (.exe | sub("/[^/]*$"; "")) else "" end), exe:.exe,
              size:($sz[.id] // 0), library:"", launch:"", wrapped:false,
              compat:($p.runner // ""), prefix:(($p.path // "") != ""), prefixPath:($p.path // ""),
              prefixName:($p.name // ""), playtime:(.playtime // 0), lastPlayed:(.last_played // ""),
              cover:(.cover // "")}]' "$UMBRAL_CONFIG"
}

# Umbral games running now: a process with the game's .exe as an argument.
# Read in bash (no grep/pgrep with the name in its own command line, which
# would find itself); exact file-name match.
umbral_running() {
    local list f pid a id exe
    list="$(jq -r '.games[]? | select((.exe // "") != "") | [.id, (.exe | split("/") | last)] | @tsv' "$UMBRAL_CONFIG" 2>/dev/null)"
    [[ -n "$list" ]] || return 0
    declare -A want=() found=()
    while IFS=$'\t' read -r id exe; do want["$exe"]="$id"; done <<<"$list"
    for f in "${PROC_ROOT:-/proc}"/[0-9]*/cmdline; do
        pid="${f%/cmdline}"; pid="${pid##*/}"
        while IFS= read -r -d '' a; do
            a="${a##*[/\\]}"
            if [[ -n "${want[$a]:-}" && -z "${found[$a]:-}" ]]; then
                found["$a"]=1; printf 'umbral:%s\t%s\n' "${want[$a]}" "$pid"
            fi
        done < "$f" 2>/dev/null
    done
}

# gplay <key> — start a game from its own launcher
cmd_gplay() {
    local key="$1"
    case "$key" in
        steam:*)
            [[ "${key#steam:}" =~ ^[0-9]+$ ]] || { err "bad Steam key"; return 2; }
            setsid -f steam "steam://rungameid/${key#steam:}" >/dev/null 2>&1 ;;
        umbral:*)
            have umbral || { err "Umbral is not installed"; return 4; }
            umbral_json | jq -e --arg i "${key#umbral:}" 'any(.games[]?; .id == $i)' >/dev/null || { err "Umbral has no game $key"; return 2; }
            setsid -f umbral --launch "${key#umbral:}" >/dev/null 2>&1 ;;
        *) err "use: gplay steam:<appid> | umbral:<id>"; return 2 ;;
    esac
    log "▶ Launching $key"
    history_add play "${key%%:*}" "$key" 0
}

# --- library -------------------------------------------------------------------
# JSON list of installed games with their profile / launch / Proton state
cmd_games() {
    local lc cfg id name dir size lib launch compat
    lc="$(steam_localconfig)"; cfg="$(steam_root)/config/config.vdf"
    local profs; profs="$(profiles_json)"
    steam_games | while IFS= read -r id && IFS= read -r name && IFS= read -r dir && IFS= read -r size && IFS= read -r lib; do
        launch=""; [[ -f "$lc" ]] && launch="$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions)"
        compat=""; [[ -f "$cfg" ]] && compat="$(vdf_get "$cfg" "$COMPAT_MAPPING/$id" name)"
        printf '%s\n' "$id" "$name" "$dir" "$size" "$lib" "$launch" "$compat" \
            "$([[ -d "$lib/steamapps/compatdata/$id" ]] && echo 1 || echo 0)"
    done | jq -Rn --argjson profs "$profs" --argjson known "$(known_games_json)" '[inputs] as $l | [range(0; $l|length; 8) as $i |
        {key:("steam:" + $l[$i]), source:"steam", id:$l[$i], name:$l[$i+1], installdir:$l[$i+2],
         size:($l[$i+3]|tonumber? // 0), library:$l[$i+4], launch:$l[$i+5],
         wrapped:($l[$i+5] | contains("control-deck run")), compat:$l[$i+6], prefix:($l[$i+7] == "1"),
         profile:($profs | has("steam:" + $l[$i])),
         new:(($known != null) and (($known | index("steam:" + $l[$i])) == null))}]' \
    | jq -c --argjson u "$(umbral_games)" --argjson known "$(known_games_json)" '
        . + ($u | map(. as $g | $g + {profile:false, new:(($known != null) and (($known | index($g.key)) == null))}))
        | sort_by(.name | ascii_downcase)' \
    | tee >(jq -r '.[].key' | known_games_init)
}

# games already seen by the user (null on the very first run: nothing is "new" then)
KNOWN_GAMES="$GAMING_DIR/known-games.txt"
known_games_json() { if [[ -f "$KNOWN_GAMES" ]]; then jq -Rsc 'split("\n") | map(select(. != ""))' "$KNOWN_GAMES"; else echo null; fi; }
known_games_init() { mkdir -p "$GAMING_DIR"; [[ -f "$KNOWN_GAMES" ]] && { cat >/dev/null; return; }; cat > "$KNOWN_GAMES"; }

# gseen <key> — the user opened this game: it's no longer "new"
cmd_gseen() {
    valid_game_key "$1" || { err "not a game key: $1"; return 2; }
    mkdir -p "$GAMING_DIR"; grep -qxF "$1" "$KNOWN_GAMES" 2>/dev/null || echo "$1" >> "$KNOWN_GAMES"
}

# gtips <appid…> → {"<appid>": number of options RECOMMENDED for this PC}
cmd_gtips() {
    local id
    for id in "$@"; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        printf '%s\n%s\n' "$id" "$(cmd_gsuggest "$id" | jq '[.suggestions[]? | select(.recommended)] | length')"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i | {key:$l[$i], value:($l[$i+1]|tonumber)}] | from_entries'
}

# --- status: gamemode, governor, running games ---------------------------------------
# games running now, found through the SteamAppId variable Steam sets
# (one grep over every readable environ; other users' processes are skipped)
running_games() {
    grep -aoH 'SteamAppId=[0-9]\+' "${PROC_ROOT:-/proc}"/[0-9]*/environ 2>/dev/null \
        | sed -E 's|^.*/([0-9]+)/environ:SteamAppId=([0-9]+)$|\2\t\1|' \
        | awk -F'\t' '$1 != 0' | sort -t$'\t' -k1,1 -k2,2n | awk -F'\t' '!seen[$1]++'
}

cmd_gstatus() {
    local gm_inst=false gm_active=false ingroup=false added=false gov drv mmc run
    have gamemoded && gm_inst=true
    [[ $gm_inst == true ]] && gamemoded -s 2>/dev/null | grep -q 'is active' && gm_active=true
    id -nG | tr ' ' '\n' | grep -qx gamemode && ingroup=true
    # in the group database but not in this session yet (needs a new login)
    id -nG "$(id -un)" | tr ' ' '\n' | grep -qx gamemode && added=true
    gov="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
    drv="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null)"
    mmc="$(cat /proc/sys/vm/max_map_count 2>/dev/null || echo 0)"
    run="$( { running_games | sed 's/^/steam:/'; umbral_running; } | while IFS=$'\t' read -r key pid; do
            printf '%s\n%s\n' "$key" "$pid"; done | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i |
              {key:$l[$i], id:($l[$i] | sub("^[a-z]+:"; "")), pid:($l[$i+1]|tonumber)}]')"
    jq -n --argjson gi "$gm_inst" --argjson ga "$gm_active" --argjson grp "$ingroup" --argjson add "$added" \
          --arg gov "$gov" --arg drv "$drv" --argjson mmc "${mmc:-0}" --argjson run "$run" \
          --argjson mh "$(have mangohud && echo true || echo false)" \
          --argjson gs "$(have gamescope && echo true || echo false)" \
        '{gamemode:{installed:$gi, active:$ga, ingroup:$grp, pending:($add and ($grp | not))}, governor:$gov, cpufreq_driver:$drv,
          max_map_count:$mmc, max_map_count_ok:($mmc >= 1048576), mangohud:$mh, gamescope:$gs, running:$run}'
}

# join the gamemode group: lets gamemode switch the CPU governor without a
# password (its polkit rule) and allows nice down to -10 (limits.d). One-time.
cmd_gamejoin() {
    getent group gamemode >/dev/null || { err "the gamemode group doesn't exist (install gamemode)"; return 4; }
    id -nG | tr ' ' '\n' | grep -qx gamemode && { log "✔ You are already in the gamemode group."; return 0; }
    if id -nG "$(id -un)" | tr ' ' '\n' | grep -qx gamemode; then
        log "✔ You were already added: log out of your desktop session (or reboot) to activate it."; return 0
    fi
    log "→ pkexec usermod -aG gamemode $USER"
    pkexec usermod -aG gamemode "$USER" || { err "usermod failed"; return 4; }
    log "✔ Added to the gamemode group. Log out and back in for it to take effect."
    history_add "gamemode group" system "$USER" 0
}

# --- ProtonDB --------------------------------------------------------------------
# Only the public per-game summary (tier, score, report count) is used, one
# request per game, cached for a day. Launch-option advice is NOT available
# from it, so the deck never invents any: it links to the game's page.
PROTONDB_API="${CONTROL_DECK_PROTONDB_API:-https://www.protondb.com/api/v1/reports/summaries}"
PROTONDB_CACHE="$CACHE_HOME/control-deck/protondb"

protondb_one() {
    local id="$1" f="$PROTONDB_CACHE/$1.json" data
    mkdir -p "$PROTONDB_CACHE"
    if [[ -f "$f" ]] && (( $(date +%s) - $(stat -c %Y "$f") < 86400 )); then cat "$f"; return; fi
    if data="$(curl -fsS --max-time 8 -A "control-deck (+https://github.com/madkyp/control-deck)" "$PROTONDB_API/$id.json" 2>/dev/null)" \
       && jq -e '.tier' <<<"$data" >/dev/null 2>&1; then
        printf '%s' "$data" > "$f"; printf '%s' "$data"
    elif [[ -f "$f" ]]; then cat "$f"                   # stale beats nothing
    else echo '{"tier":"unknown"}'; fi
}

# protondb <appid…> → {"<appid>": {tier, trendingTier, score, total, confidence}}
cmd_protondb() {
    local id
    for id in "$@"; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        printf '%s\n%s\n' "$id" "$(protondb_one "$id" | jq -c .)"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i | {key:$l[$i], value:($l[$i+1]|fromjson)}] | from_entries'
}

# --- launch-option suggestions from ProtonDB's open data -------------------------
# ProtonDB publishes monthly dumps of every report (github.com/bdefore/protondb-data,
# ODbL). `pdbindex update` streams the newest one — never unpacked to disk, a few
# MB of RAM — into a small local index of the reports that list launch options,
# for EVERY game, so a game installed later gets suggestions without another
# download. `gsuggest` turns that into per-game statistics; nothing is applied
# automatically.
PDB_REPO_API="${CONTROL_DECK_PDB_REPO_API:-https://api.github.com/repos/bdefore/protondb-data/contents/reports}"
PDB_RAW="${CONTROL_DECK_PDB_RAW:-https://raw.githubusercontent.com/bdefore/protondb-data/master/reports}"
PDB_INDEX="$PROTONDB_CACHE/launch-index.jsonl"
PDB_META="$PROTONDB_CACHE/launch-index.meta"

# jq: GPU model string → "vendor:generation" (an ordinal, so "±1 generation" is
# a simple difference). GTX 16 = Turing like RTX 20; Steam Deck = RDNA2 like RX 6000.
JQ_GPU_GEN='def gpu_gen: ascii_downcase
    | if test("(rtx|gtx|gt|mx)\\s*-?\\s*[0-9]{3,4}") then
        (capture("(?:rtx|gtx|gt|mx)\\s*-?\\s*(?<n>[0-9]{3,4})").n | tonumber) as $n
        | ({"7":0,"9":1,"10":2,"16":3,"20":3,"30":4,"40":5,"50":6}[($n / 100 | floor | tostring)]) as $o
        | if $o == null then "" else "nvidia:\($o)" end
      elif test("rx\\s*[0-9]{4}") then
        ({"5":2,"6":3,"7":4,"9":5}[capture("rx\\s*(?<n>[0-9])[0-9]{3}").n]) as $o
        | if $o == null then "" else "amd:\($o)" end
      elif test("rx\\s*[0-9]{3}") then "amd:0"
      elif test("vega") then "amd:1"
      elif test("steam deck|vangogh|van gogh") then "amd:3"
      elif test("arc") then "intel:1"
      else "" end;'

# "reports_sep1_2026.tar.gz" → epoch of that date
pdb_dump_epoch() {
    local n="${1#reports_}"; n="${n%.tar.gz}"
    [[ "$n" =~ ^([a-z]+)([0-9]+)_([0-9]{4})$ ]] || { echo 0; return; }
    date -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}" +%s 2>/dev/null || echo 0
}

pdb_latest_dump() {
    local n best="" bestt=0 t
    while IFS= read -r n; do
        t="$(pdb_dump_epoch "$n")"; (( t > bestt )) && { best="$n"; bestt=$t; }
    done < <(curl -fsS --max-time 15 -H 'Accept: application/vnd.github+json' "$PDB_REPO_API" | jq -r '.[].name' 2>/dev/null)
    [[ -n "$best" ]] && echo "$best"
}

# the GPU vendor games will run on (a discrete NVIDIA/AMD card wins over Intel)
gpu_vendor() {
    [[ -n "${CONTROL_DECK_GPU_VENDOR:-}" ]] && { echo "$CONTROL_DECK_GPU_VENDOR"; return; }
    local v all=""
    for v in /sys/class/drm/card[0-9]*/device/vendor; do [[ -f "$v" ]] && all+=" $(cat "$v")"; done
    case "$all" in
        *0x10de*) echo nvidia ;; *0x1002*) echo amd ;; *0x8086*) echo intel ;; *) echo "" ;;
    esac
}

# name of the GPU games run on (nvidia-smi, else lspci)
gpu_name() {
    [[ -n "${CONTROL_DECK_GPU_NAME:-}" ]] && { echo "$CONTROL_DECK_GPU_NAME"; return; }
    have nvidia-smi && nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 && return
    lspci -mm 2>/dev/null | grep -E '"(VGA|3D|Display)' | sed -E 's/^[^"]*"[^"]*" "([^"]*)" "([^"]*)".*/\1 \2/' \
        | sort -r | head -1
}
# focused monitor resolution "WxH" (Hyprland), empty if unknown
screen_res() {
    [[ -n "${CONTROL_DECK_SCREEN+set}" ]] && { echo "$CONTROL_DECK_SCREEN"; return; }   # set, even empty = override
    have hyprctl && hyprctl monitors -j 2>/dev/null | jq -r 'map(select(.focused)) | first // empty | "\(.width)x\(.height)"'
}

# focused monitor refresh rate (rounded Hz), empty if unknown
screen_hz() {
    [[ -n "${CONTROL_DECK_SCREEN_HZ+set}" ]] && { echo "$CONTROL_DECK_SCREEN_HZ"; return; }
    have hyprctl && hyprctl monitors -j 2>/dev/null | jq -r 'map(select(.focused)) | first // empty | .refreshRate | round'
}

cmd_pdbindex() {
    case "${1:-status}" in
        update)
            local dump url tmp n
            dump="${CONTROL_DECK_PDB_DUMP:-$(pdb_latest_dump)}"
            [[ -n "$dump" ]] || { err "could not list ProtonDB's data dumps on GitHub"; return 4; }
            if [[ -f "$PDB_META" && "$(sed -n 's/^DUMP=//p' "$PDB_META")" == "$dump" && "$2" != --force ]]; then
                log "✔ The index is already built from $dump."; return 0
            fi
            mkdir -p "$PROTONDB_CACHE"; tmp="$PDB_INDEX.tmp"
            url="$PDB_RAW/$dump"
            log "→ Downloading and indexing $dump (about 70 MB, ~1 min)…"
            # stream: download → gunzip/untar → one report at a time
            if ! curl -fsSL --max-time 900 "$url" | tar xzO | jq -cn --stream "$JQ_GPU_GEN"'
                    fromstream(1 | truncate_stream(inputs))
                    | select((.responses.launchOptions? // "") | length > 0)
                    | [(.app.steam.appId // ""), (.timestamp // 0), (.responses.verdict // ""),
                       ((.systemInfo.gpu // "") | ascii_downcase
                        | if test("nvidia|geforce|rtx|gtx|quadro") then "nvidia"
                          elif test("amd|radeon|\\brx ") then "amd" elif test("intel") then "intel" else "" end),
                       .responses.launchOptions, ((.systemInfo.gpu // "") | gpu_gen)]' > "$tmp"; then
                rm -f "$tmp"; err "download or indexing failed"; return 4
            fi
            n="$(wc -l < "$tmp")"
            (( n > 0 )) || { rm -f "$tmp"; err "the dump had no usable reports"; return 4; }
            mv -f "$tmp" "$PDB_INDEX"
            printf 'DUMP=%s\nDATE=%s\nBUILT=%s\nREPORTS=%s\nGAMES=%s\n' "$dump" "$(pdb_dump_epoch "$dump")" \
                "$(date +%s)" "$n" "$(cut -d'"' -f2 "$PDB_INDEX" | sort -u | wc -l)" > "$PDB_META"
            log "✔ Indexed $n reports with launch options ($(sed -n 's/^GAMES=//p' "$PDB_META") games). Data: ProtonDB, ODbL."
            history_add "protondb data" steam "$dump" 0 ;;
        status)
            if [[ -f "$PDB_META" && -s "$PDB_INDEX" ]]; then
                jq -n --arg d "$(sed -n 's/^DUMP=//p' "$PDB_META")" --argjson t "$(sed -n 's/^DATE=//p' "$PDB_META")" \
                      --argjson r "$(sed -n 's/^REPORTS=//p' "$PDB_META")" --argjson g "$(sed -n 's/^GAMES=//p' "$PDB_META")" \
                      --argjson now "$(date +%s)" \
                    '{present:true, dump:$d, date:($t | strftime("%Y-%m-%d")), reports:$r, games:$g,
                      stale:(($now - $t) > 35 * 86400)}'
            else echo '{"present":false}'; fi ;;
        *) err "use: pdbindex update [--force] | status"; return 2 ;;
    esac
}

# gsuggest <appid> — what players who say the game works put in their launch options
cmd_gsuggest() {
    local id="$1" vendor since
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: gsuggest <appid>"; return 2; }
    [[ -s "$PDB_INDEX" ]] || { echo '{"index":false}'; return 0; }
    local gen cores res
    vendor="$(gpu_vendor)"; since=$(( $(date +%s) - 3 * 365 * 86400 ))
    local gname; gname="$(gpu_name)"
    gen="$(jq -Rr "$JQ_GPU_GEN"' gpu_gen' <<<"$gname")"
    cores="$(nproc 2>/dev/null || echo 0)"; res="$(screen_res)"; local hz; hz="$(screen_hz)"
    grep -F "[\"$id\"," "$PDB_INDEX" | jq -sc --arg v "$vendor" --argjson since "$since" \
        --arg gen "$gen" --arg gname "$gname" --argjson cores "${cores:-0}" --arg res "$res" --arg hz "$hz" '
        # hardware-dependent values are grouped and rewritten for this PC
        def adapt:
            ($res | split("x")) as $wh |
            if test("^-(threads|numthreads) [0-9]+$") then
                (if $cores > 0 then {key:"-threads #", token:("-" + (capture("^-(?<f>[a-z]+)").f) + " \($cores)"), adapted:true} else null end)
            elif test("^-(w|width|screen-width) [0-9]+$") then
                (if ($wh | length) == 2 then {key:"-w #", token:((split(" ")[0]) + " " + $wh[0]), adapted:true} else null end)
            elif test("^-(h|height|screen-height) [0-9]+$") then
                (if ($wh | length) == 2 then {key:"-h #", token:((split(" ")[0]) + " " + $wh[1]), adapted:true} else null end)
            elif test("^[-+](fps_max|fpsmax|maxfps|fps-max) [0-9]+$") then
                (if $hz != "" then {key:((split(" ")[0]) + " #"), token:((split(" ")[0]) + " " + $hz), adapted:true}
                 else {key:((split(" ")[0]) + " #"), token:., adapted:false} end)
            elif test("^[-+][A-Za-z0-9_]+ [0-9.]+$") then
                # same option, different numbers: grouped, the most common value is shown
                {key:((split(" ")[0]) + " #"), token:., adapted:false}
            else {key:., token:., adapted:false} end;
        # "RTX 20 / GTX 16 ±1" style label of the generations counted as similar
        def gen_label:
            if . == "" then "" else
            (split(":")[0]) as $vd | (split(":")[1] | tonumber) as $o
            | ({nvidia:["GTX 700","GTX 900","GTX 10","RTX 20 / GTX 16","RTX 30","RTX 40","RTX 50"],
                amd:["RX 400/500","Vega","RX 5000","RX 6000","RX 7000","RX 9000"], intel:["","Arc"]}[$vd] // []) as $names
            | [range([$o - 1, 0] | max; [$o + 2, ($names | length)] | min) | $names[.]] | map(select(. != "")) | join(", ")
            end;
        def similar($g): ($gen != "" and $g != null and $g != "")
            and (($g | split(":")[0]) == ($gen | split(":")[0]))
            and ((($g | split(":")[1] | tonumber) - ($gen | split(":")[1] | tonumber)) | fabs <= 1);
        def vendor_of: if test("^(RADV_|AMD_|ACO_|RADEONSI|ENABLE_LAYER_MESA|MESA_)") then "amd"
                       elif test("^(__GL_|__NV|PROTON_ENABLE_NVAPI|DXVK_ENABLE_NVAPI|PROTON_ENABLE_NGX|DXVK_NVAPI)") then "nvidia"
                       else null end;
        # one report → unique suggestion tokens: env VAR=value, wrapper, argument (+cvar value / -flag value)
        def tokens:
            [scan("(?:[^\\s\"]+|\"[^\"]*\")+")] as $t
            | ($t | index("%command%")) as $c
            | (if $c == null then [] else $t[:$c] end) as $pre
            | (if $c == null then $t else $t[$c+1:] end) as $post
            | ([$pre[] | select(test("^[A-Za-z_][A-Za-z0-9_]*="))
                 | gsub("\""; "") | {token:., kind:"env", vendor:(vendor_of)}]
               + [$pre[] | select(test("^[a-z][a-z0-9_.-]*$") and (test("^[0-9.]+$") | not))
                 | {token:., kind:"wrapper", vendor:null}]
               + [foreach range(0; $post | length) as $i ({skip:false, out:null};
                     if .skip then {skip:false, out:null}
                     else ($post[$i]) as $a | ($post[$i+1] // null) as $b
                        | if ($a | test("^[-+]")) then
                            (if $b != null and ($b | test("^[-+]") | not) then {skip:true, out:($a + " " + $b)}
                             else {skip:false, out:$a} end)
                          else {skip:false, out:null} end
                     end; .out) | select(. != null) | {token:., kind:"arg", vendor:null}])
            | map(select(.token | test("[/~$`;|&<>]") | not))
            | map(. as $x | ($x.token | adapt) as $a | select($a != null) | $x + $a)
            | unique_by(.key);
        map(select(.[2] == "yes")) as $works
        | ($works | map(select(.[1] >= $since))) as $recent
        | (if ($recent | length) >= 8 then {r:$recent, window:"3y"} else {r:$works, window:"all"} end) as $w
        | ($w.r | length) as $n
        | ($w.r | map(select(.[3] == $v)) | length) as $nv
        | ($w.r | map(select(similar(.[5]))) | length) as $ns
        | [$w.r[] | .[3] as $gpu | .[5] as $g | (.[4] | tokens[]) | . + {gpu:$gpu, sim:similar($g)}]
        | group_by(.key)
        | map({token:(group_by(.token) | max_by(length) | .[0].token), key:.[0].key, adapted:.[0].adapted,
               kind:.[0].kind, vendor:.[0].vendor, count:length,
               share:((length * 100 / ([$n,1]|max)) | floor),
               vcount:(map(select(.gpu == $v)) | length), scount:(map(select(.sim)) | length)}
              | .vshare = (if $nv > 0 then (.vcount * 100 / $nv | floor) else null end)
              | .sshare = (if $ns >= 5 then (.scount * 100 / $ns | floor) else null end))
        # judged within the players whose hardware is closest to this PC:
        # same GPU generation (±1) when there are enough of them, else same vendor
        | map(. + (if .sshare != null then {basis:"similar", pct:.sshare, n:.scount}
                   elif .vshare != null then {basis:"vendor", pct:.vshare, n:.vcount}
                   else {basis:"all", pct:.share, n:.count} end))
        | map(select(.count >= 2 and .pct >= 5))
        | map(. + {foryou:(.vendor == null or .vendor == $v)})
        # env vars: share of those players who do not set the variable at all
        # (i.e. keep the default) — "not setting it" is a choice too
        | map(if .kind == "env" then
                (.token | split("=")[0]) as $var
                | ((if .basis == "similar" then [$w.r[] | select(similar(.[5]))]
                    elif .basis == "vendor" then [$w.r[] | select(.[3] == $v)] else $w.r end)) as $c
                | . + {var:$var, unset:(([$c[] | select(.[4] | test("(^|\\s)" + $var + "=") | not)] | length) * 100 / ([$c | length, 1] | max) | floor)}
              else . end)
        # RECOMMENDED: ≥ 20 % of those players use it (at least 5 reports); an env var
        # must also be set by more players than leave it at its default
        | map(. + {recommended:(.foryou and .pct >= 20 and .n >= 5 and (.kind != "env" or .pct > .unset))})
        | sort_by(-(if .foryou then 1 else 0 end), -(if .recommended then 1 else 0 end), -.pct, -.count)
        | {index:true, vendor:$v, gpuGen:$gen, gpuName:$gname, similarLabel:($gen | gen_label),
           cores:$cores, screen:$res, window:$w.window,
           reports:$n, vendorReports:$nv, similarReports:(if $ns >= 5 then $ns else 0 end),
           suggestions:.[:16]}'
}

# --- shader caches -----------------------------------------------------------------
# Per game, Steam keeps steamapps/shadercache/<appid>/ with:
#   fozpipelinesv6/   Fossilize recordings of the game's pipelines — driver-independent,
#                     Steam compiles them ahead of time ("shader pre-caching")
#   nvidiav1/, mesa_shader_cache*/  the driver's compiled cache — tied to the driver
#                     version, useless after a driver update until rebuilt
#   DXVK_state_cache/  (DXVK < 2.0), transcoded_video.foz / fozmediav1/ (videos, not shaders)
# Globally the drivers keep ~/.cache/nvidia/GLCache and ~/.cache/mesa_shader_cache*.
DRIVER_PKG_RE='^(lib32-)?(nvidia(-[0-9]+xx)?-utils|nvidia-open-dkms|mesa|vulkan-(radeon|intel|nouveau)|amdvlk)$'

driver_pkgs() { pacman -Q 2>/dev/null | awk -v re="$DRIVER_PKG_RE" '$1 ~ re'; }

# last time pacman installed/upgraded a driver package (epoch, 0 if never logged)
last_driver_update() {
    local l
    l="$(grep -E '\[ALPM\] (upgraded|installed|downgraded|reinstalled) ' "$PACMAN_LOG" 2>/dev/null \
         | awk -v re="$DRIVER_PKG_RE" '{ if ($4 ~ re) last = $0 } END { print last }')"
    l="${l#\[}"; l="${l%%\]*}"
    [[ -n "$l" ]] && date -d "$l" +%s 2>/dev/null || echo 0
}

# which part of a shadercache entry is what
shader_part() {
    case "$1" in
        fozpipelines*) echo pipelines ;;
        nvidiav1|mesa_shader_cache*|radv*) echo driver ;;
        DXVK_state_cache*|*.dxvk-cache) echo dxvk ;;
        fozmedia*|transcoded_video*) echo video ;;
        *) echo other ;;
    esac
}

# a driver cache is stale when nothing in it was written after the last driver update
cache_stale() {   # dir since
    [[ -d "$1" && "$2" -gt 0 ]] || return 1
    [[ -z "$(find "$1" -type f -newermt "@$2" -print -quit 2>/dev/null)" ]] \
        && [[ -n "$(find "$1" -type f -print -quit 2>/dev/null)" ]]
}

# Steam compiling shaders in the background (the process name is truncated to 15 chars)
steam_processing_shaders() { pgrep -x fossilize_repla >/dev/null 2>&1; }

global_shader_caches() {   # id<TAB>label<TAB>path
    printf '%s\t%s\t%s\n' nvidia "NVIDIA driver (OpenGL/Vulkan)" "$CACHE_HOME/nvidia/GLCache" \
        nvidia-legacy "NVIDIA driver (old location)" "$HOME/.nv/GLCache" \
        mesa "Mesa (AMD/Intel)" "$CACHE_HOME/mesa_shader_cache" \
        mesa-db "Mesa single-file cache" "$CACHE_HOME/mesa_shader_cache_db"
}

cmd_shadercache() {
    local since lib d id name part f bytes installed running
    since="$(last_driver_update)"
    running="$(running_games | cut -f1)"
    local games; games="$(steam_games | awk 'NR % 5 == 1 { id = $0 } NR % 5 == 2 { print id "\t" $0 }')"
    {
        while IFS= read -r lib; do
            for d in "$lib"/steamapps/shadercache/*/; do
                d="${d%/}"; id="${d##*/}"; [[ "$id" =~ ^[0-9]+$ ]] || continue
                name="$(awk -F'\t' -v i="$id" '$1 == i { print $2; exit }' <<<"$games")"
                installed=0; [[ -n "$name" ]] && installed=1
                [[ -z "$name" ]] && name="$(vdf_get "$lib/steamapps/appmanifest_$id.acf" AppState name 2>/dev/null)"
                local p_pipe=0 p_drv=0 p_dxvk=0 p_vid=0 p_oth=0 st=0
                for f in "$d"/* "$d"/.[!.]*; do
                    [[ -e "$f" ]] || continue
                    bytes="$(dir_bytes "$f")"; part="$(shader_part "${f##*/}")"
                    case "$part" in
                        pipelines) p_pipe=$(( p_pipe + bytes )) ;;
                        driver) p_drv=$(( p_drv + bytes )); cache_stale "$f" "$since" && st=1 ;;
                        dxvk) p_dxvk=$(( p_dxvk + bytes )) ;;
                        video) p_vid=$(( p_vid + bytes )) ;;
                        *) p_oth=$(( p_oth + bytes )) ;;
                    esac
                done
                printf 'game\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "${name:-}" "$installed" "$d" \
                    "$p_pipe" "$p_drv" "$p_dxvk" "$p_vid" "$p_oth" "$st" \
                    "$(grep -qx "$id" <<<"$running" && echo 1 || echo 0)"
            done
        done < <(steam_libs)
        local gid label path
        while IFS=$'\t' read -r gid label path; do
            [[ -d "$path" ]] || continue
            st=0; cache_stale "$path" "$since" && st=1
            printf 'global\t%s\t%s\t%s\t%s\t%s\n' "$gid" "$label" "$path" "$(dir_bytes "$path")" "$st"
        done < <(global_shader_caches)
    } | jq -Rn --argjson since "$since" --arg drivers "$(driver_pkgs)" \
          --argjson busy "$(steam_processing_shaders && echo true || echo false)" '
        [inputs | split("\t")] as $rows
        | {lastDriverUpdate:$since, drivers:($drivers | split("\n") | map(select(. != "") | split(" ") | {name:.[0], version:.[1]})),
           steamProcessing:$busy,
           games:[$rows[] | select(.[0] == "game") |
                  {id:.[1], name:.[2], installed:(.[3] == "1"), path:.[4],
                   pipelines:(.[5]|tonumber), driver:(.[6]|tonumber), dxvk:(.[7]|tonumber), video:(.[8]|tonumber),
                   other:(.[9]|tonumber), stale:(.[10] == "1"), running:(.[11] == "1")}
                  | .total = (.pipelines + .driver + .dxvk + .video + .other)] | sort_by(-.total),
           global:[$rows[] | select(.[0] == "global") | {id:.[1], label:.[2], path:.[3], size:(.[4]|tonumber), stale:(.[5] == "1")}]}
        | .staleBytes = ([.games[] | select(.stale) | .driver] + [.global[] | select(.stale) | .size] | add // 0)
        | .orphanBytes = ([.games[] | select(.installed | not) | .total] | add // 0)'
}

# empty a directory (keep it: Steam/driver expect it) and report
empty_dir() {
    local d="$1" b; [[ -d "$d" ]] || return 0
    b="$(dir_bytes "$d")"
    find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && echo "$b"
}

# shaderclean steam:<appid> [driver|all] | orphans | stale | global:<id>
cmd_shaderclean() {
    local target="$1" part="${2:-driver}" info freed=0 b d id gid f
    info="$(cmd_shadercache)"
    if [[ "$target" != global:* ]] && steam_processing_shaders; then
        err "Steam is processing shaders right now (fossilize_replay): try again when it finishes"; return 3
    fi
    case "$target" in
        steam:*)
            id="${target#steam:}"; [[ "$id" =~ ^[0-9]+$ ]] || { err "bad app id"; return 2; }
            d="$(jq -r --arg i "$id" '.games[] | select(.id == $i) | .path' <<<"$info")"
            [[ -n "$d" ]] || { err "no shader cache for $id"; return 4; }
            [[ "$(jq -r --arg i "$id" '.games[] | select(.id == $i) | .running' <<<"$info")" == true ]] \
                && { err "the game is running: close it first"; return 3; }
            case "$part" in
                driver) for f in "$d"/*; do
                            [[ "$(shader_part "${f##*/}")" == driver ]] || continue
                            b="$(empty_dir "$f")"; freed=$(( freed + ${b:-0} ))
                        done ;;
                all)    b="$(dir_bytes "$d")"; find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; freed=${b:-0} ;;
                *) err "part must be driver or all"; return 2 ;;
            esac ;;
        orphans)
            while IFS= read -r d; do
                [[ -n "$d" ]] || continue
                b="$(dir_bytes "$d")"; rm -rf -- "$d" && freed=$(( freed + b )) && log "→ removed ${d##*/}"
            done < <(jq -r '.games[] | select(.installed | not) | .path' <<<"$info") ;;
        stale)
            [[ -n "$(running_games)" ]] && { err "a game is running: close it first"; return 3; }
            while IFS= read -r d; do
                for f in "$d"/*; do
                    [[ "$(shader_part "${f##*/}")" == driver ]] || continue
                    b="$(empty_dir "$f")"; freed=$(( freed + ${b:-0} ))
                done
            done < <(jq -r '.games[] | select(.stale) | .path' <<<"$info")
            while IFS= read -r d; do
                b="$(empty_dir "$d")"; freed=$(( freed + ${b:-0} ))
            done < <(jq -r '.global[] | select(.stale) | .path' <<<"$info") ;;
        global:*)
            gid="${target#global:}"
            d="$(jq -r --arg g "$gid" '.global[] | select(.id == $g) | .path' <<<"$info")"
            [[ -n "$d" ]] || { err "no such cache: $gid"; return 2; }
            [[ -n "$(running_games)" ]] && { err "a game is running: close it first"; return 3; }
            b="$(empty_dir "$d")"; freed=${b:-0} ;;
        *) err "use: shaderclean steam:<appid> [driver|all] | orphans | stale | global:<id>"; return 2 ;;
    esac
    log "✔ Freed $(human "$freed"). The first launches rebuild what's needed (some stutter is expected)."
    history_add "shader cache clean" gaming "$target${2:+ $2}" 0
}

# --- A/B benchmark ----------------------------------------------------------------
# Two launch variants of the same game, each run once through the wrapper with
# MangoHud logging every frame; the per-frame CSV (verified format, MangoHud
# 0.8.x: 2 system-info lines, a column header, one row per frame with
# frametime in ms) is turned into avg FPS, 1 % / 0.1 % lows and frametimes.
# MangoHud's own *_summary.csv is ignored: its values are unreliable.
BENCH_DIR="$GAMING_DIR/bench"
BENCH_ARMED="$BENCH_DIR/armed"            # key<TAB>variant<TAB>epoch — one launch only

bench_path() { echo "$BENCH_DIR/${1//:/_}"; }
bench_cfg() {
    local f; f="$(bench_path "$1")/config.json"
    if [[ -s "$f" ]]; then cat "$f"
    else echo '{"duration":60,"delay":15,"A":{"label":"A"},"B":{"label":"B"}}'; fi
}

# frame stats of one MangoHud per-frame CSV → JSON
bench_stats() {
    local f="$1"
    [[ -s "$f" ]] || { echo null; return; }
    awk -F, 'NR == 3 { for (i = 1; i <= NF; i++) col[$i] = i; next }
             NR > 3 && col["frametime"] { print $(col["frametime"]) "\t" $(col["cpu_load"]) "\t" $(col["gpu_load"]) "\t" $(col["gpu_temp"]) "\t" $(col["cpu_temp"]) }' "$f" |
    # frames over 5 s are pauses/loading (or MangoHud glitches), not performance
    jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | map(tonumber? // 0)) | map(select(.[0] > 0 and .[0] < 5000)) as $r
        | if ($r | length) < 10 then null else
          ($r | map(.[0])) as $ft | ($ft | length) as $n | ($ft | add / $n) as $avg
          | ($ft | sort) as $asc | ($asc | reverse) as $desc
          | def lowavg($p): ([($n * $p | ceil), 1] | max) as $k | 1000 / ($desc[:$k] | add / $k);
          {frames:$n, seconds:(($ft | add) / 1000 | floor),
           avgFps:(1000 / $avg * 10 | round / 10), low1:(lowavg(0.01) * 10 | round / 10), low01:(lowavg(0.001) * 10 | round / 10),
           p99ms:($asc[(($n - 1) * 0.99 | floor)] * 100 | round / 100), maxms:($desc[0] * 100 | round / 100),
           spikes:([$ft[] | select(. > $avg * 2.5)] | length),
           cpuLoad:(($r | map(.[1]) | add / $n) | round), gpuLoad:(($r | map(.[2]) | add / $n) | round),
           gpuTempMax:($r | map(.[3]) | max), cpuTempMax:($r | map(.[4]) | max),
           # frametime curve for the chart: ≤ 240 buckets, worst frame of each (keeps stutter visible)
           series:(([($n / 240 | ceil), 1] | max) as $b | [range(0; $n; $b) as $i | $ft[$i:$i+$b] | max * 100 | round / 100])}
          end'
}

# newest per-frame log of a variant (MangoHud names it <exe>_<date>.csv)
bench_log() {
    local f best="" bt=0 t
    for f in "$(bench_path "$1")/$2"/*.csv; do
        [[ -f "$f" && "$f" != *_summary.csv ]] || continue
        t="$(stat -c %Y "$f")"; (( t >= bt )) && { best="$f"; bt=$t; }
    done
    [[ -n "$best" ]] && echo "$best"
}

bench_get() {
    local key="$1" a b
    a="$(bench_stats "$(bench_log "$key" A)")"; b="$(bench_stats "$(bench_log "$key" B)")"
    bench_cfg "$key" | jq -c --argjson a "$a" --argjson b "$b" '. + {results:{A:$a, B:$b}}
        | if $a != null and $b != null then .compare = {
            avgFps:((($b.avgFps - $a.avgFps) / $a.avgFps * 1000 | round) / 10),
            low1:((($b.low1 - $a.low1) / $a.low1 * 1000 | round) / 10),
            p99ms:((($b.p99ms - $a.p99ms) / $a.p99ms * 1000 | round) / 10)} else . end'
}

# cmd_run hook: if a benchmark launch is armed for this game, overlay the
# variant on the profile, force MangoHud logging into the variant's folder,
# and disarm (a normal launch afterwards is untouched)
bench_overlay() {   # key profile-json → profile-json (+ .mangohudConfig for the wrapper to export)
    local key="$1" p="$2" akey variant when cfg dir
    [[ -f "$BENCH_ARMED" ]] || { echo "$p"; return; }
    IFS=$'\t' read -r akey variant when < "$BENCH_ARMED"
    if [[ "$akey" != "$key" ]] || (( $(date +%s) - ${when:-0} > 1800 )); then echo "$p"; return; fi
    rm -f "$BENCH_ARMED"
    cfg="$(bench_cfg "$key")"; dir="$(bench_path "$key")/$variant"
    mkdir -p "$dir"; find "$dir" -name '*.csv' -delete
    local mhc
    mhc="output_folder=$dir,autostart_log=$(jq -r '.delay' <<<"$cfg"),log_duration=$(jq -r '.duration' <<<"$cfg"),log_interval=0"
    echo "  benchmark $variant armed → $dir" >> "$STATE_DIR/logs/run.log"
    jq -c --arg mhc "$mhc" --argjson v "$(jq -c --arg x "$variant" '.[$x] // {}' <<<"$cfg")" '
        . + {mangohud:true, mangohudConfig:$mhc}
        + (if ($v.gamemode // "") != "" then {gamemode:($v.gamemode == "true")} else {} end)
        + (if ($v.args // "") != "" then {args:$v.args} else {} end)
        + (if ($v.prefix // "") != "" then {prefix:$v.prefix} else {} end)
        + {env:(.env + ($v.env // "" | split(" ") | map(select(test("^[A-Za-z_][A-Za-z0-9_]*=")) | {key:split("=")[0], value:(split("=")[1:] | join("="))}) | from_entries))}' <<<"$p"
}

# bench get|set|run|restore|clear <key> …
cmd_bench() {
    local sub="$1" key="$2"; shift 2 2>/dev/null
    [[ "$key" =~ ^steam:[0-9]+$ ]] || { err "use: bench get|set|run|restore|clear steam:<appid> …"; return 2; }
    local id="${key#steam:}" dir cfg; dir="$(bench_path "$key")"
    case "$sub" in
        get) bench_get "$key" ;;
        set)
            local kv f v var="" patch
            cfg="$(bench_cfg "$key")"
            for kv in "$@"; do
                f="${kv%%=*}"; v="${kv#*=}"
                case "$f" in
                    A|B) var="$f"; continue ;;
                    duration|delay)
                        [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 5 && v <= 900 )) || { err "$f must be 5–900 seconds"; return 2; }
                        cfg="$(jq -c --arg f "$f" --argjson v "$v" '.[$f] = $v' <<<"$cfg")"; continue ;;
                    label|env|args|prefix|gamemode|proton)
                        [[ -n "$var" ]] || { err "say which variant first: A or B"; return 2; }
                        [[ "$v" != *[\"\'\`\$\;\&\|\<\>]* ]] || { err "$f can't contain quotes or shell characters"; return 2; }
                        [[ "$f" == gamemode && -n "$v" && "$v" != true && "$v" != false ]] && { err "gamemode: true, false or empty"; return 2; }
                        if [[ "$f" == proton && -n "$v" ]] && ! cmd_compattools | jq -e --arg t "$v" 'any(.[]; .name == $t)' >/dev/null; then
                            err "unknown Proton: $v"; return 2; fi
                        patch="$(jq -cn --arg f "$f" --arg v "$v" '{($f): $v}')"
                        cfg="$(jq -c --arg x "$var" --argjson p "$patch" '.[$x] = ((.[$x] // {}) + $p)' <<<"$cfg")" ;;
                    *) err "unknown benchmark field: $f"; return 2 ;;
                esac
            done
            mkdir -p "$dir"; printf '%s\n' "$cfg" > "$dir/config.json"
            log "✔ Benchmark of $key saved." ;;
        run)
            local variant="$1" lc proton cur cfgv
            [[ "$variant" == A || "$variant" == B ]] || { err "use: bench run $key A|B"; return 2; }
            have mangohud || { err "MangoHud is needed to measure frames (pacman -S mangohud lib32-mangohud)"; return 4; }
            lc="$(steam_localconfig)"
            [[ -f "$lc" && "$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions)" == *"control-deck run"* ]] \
                || { err "the game must be launched through Control Deck: USE IN STEAM first"; return 3; }
            cfg="$(bench_cfg "$key")"; proton="$(jq -r --arg x "$variant" '.[$x].proton // ""' <<<"$cfg")"
            if [[ -n "$proton" ]]; then
                steam_running && { err "this variant changes Proton: close Steam first"; return 3; }
                cur="$(vdf_get "$(steam_root)/config/config.vdf" "$COMPAT_MAPPING/$id" name)"
                if [[ "$(jq -r 'has("originalProton")' <<<"$cfg")" != true ]]; then
                    cfg="$(jq -c --arg o "${cur:-default}" '.originalProton = $o' <<<"$cfg")"
                    mkdir -p "$dir"; printf '%s\n' "$cfg" > "$dir/config.json"
                fi
                [[ "$cur" != "$proton" ]] && { cmd_steamcompat "$id" "$proton" || return 4; }
            fi
            mkdir -p "$BENCH_DIR"
            printf '%s\t%s\t%s\n' "$key" "$variant" "$(date +%s)" > "$BENCH_ARMED"
            cfgv="$(jq -r '"logging starts after \(.delay) s and lasts \(.duration) s"' <<<"$cfg")"
            log "→ Launching $key for run $variant ($cfgv). Play the same scene for both runs, then quit the game."
            setsid -f steam "steam://rungameid/$id" >/dev/null 2>&1 || true
            history_add "benchmark $variant" steam "$key" 0 ;;
        restore)
            local orig; orig="$(bench_cfg "$key" | jq -r '.originalProton // ""')"
            [[ -z "$orig" ]] && { log "✔ Nothing to restore: no variant changed Proton."; return 0; }
            cmd_steamcompat "$id" "$orig" || return $?
            bench_cfg "$key" | jq -c 'del(.originalProton)' > "$dir/config.json"
            log "✔ Proton restored to $orig." ;;
        clear) rm -rf "$dir/A" "$dir/B" "$BENCH_ARMED"; log "✔ Benchmark results of $key cleared." ;;
        *) err "use: bench get|set|run|restore|clear <key> …"; return 2 ;;
    esac
}

# --- Wine/Proton prefixes (2.6) ------------------------------------------------------
# A prefix is any folder with system.reg + drive_c. Found in Steam's
# compatdata (every library), Heroic, Faugus, Bottles, ~/.wine, winetricks'
# ~/.local/share/wineprefixes and ~/Games (Lutris' and umu's usual home).
PREFIX_BACKUPS="${CONTROL_DECK_PREFIX_BACKUPS:-$HOME/control-deck-backups/prefixes}"

faugus_prefix_dir() {
    local c
    for c in "$HOME/.var/app/io.github.Faugus.faugus-launcher/config/faugus-launcher/config.json" "$CONFIG_HOME/faugus-launcher/config.json"; do
        [[ -f "$c" ]] && { jq -r '."default-prefix" // empty' "$c" 2>/dev/null; return; }
    done
}

# every prefix root (one per line, deduplicated)
prefix_roots() {
    local lib r
    {
        while IFS= read -r lib; do
            for r in "$lib"/steamapps/compatdata/*/pfx; do [[ -f "$r/system.reg" ]] && echo "$r"; done
        done < <(steam_libs)
        for r in "$HOME/.wine" "$DATA_HOME/wineprefixes" "$HOME/Games" "$(faugus_prefix_dir)" \
                 "$DATA_HOME/bottles/bottles" "$HOME/.var/app/com.usebottles.bottles/data/bottles/bottles"; do
            [[ -n "$r" && -d "$r" ]] || continue
            find "$r" -maxdepth 4 -name system.reg -printf '%h\n' 2>/dev/null
        done
    } | while IFS= read -r r; do [[ -d "$r/drive_c" ]] && readlink -f "$r"; done | awk '!seen[$0]++'
}

# processes using a prefix (WINEPREFIX / STEAM_COMPAT_DATA_PATH in their environment)
prefix_in_use() {
    local p="$1" c
    c="${p%/pfx}"
    grep -azlxE "(WINEPREFIX=$p/?|STEAM_COMPAT_DATA_PATH=$c/?)" "${PROC_ROOT:-/proc}"/[0-9]*/environ 2>/dev/null | head -1 | grep -q .
}

cmd_prefixes() {
    local games p owner id name kind root size used arch ver fdir
    games="$(steam_games | awk 'NR % 5 == 1 { id = $0 } NR % 5 == 2 { print id "\t" $0 }')"
    fdir="$(faugus_prefix_dir)"
    while IFS= read -r p; do
        owner=wine; id=""; name="${p##*/}"; kind=game; root="$p"
        if [[ "$p" =~ /steamapps/compatdata/([0-9]+)/pfx$ ]]; then
            owner=steam; id="${BASH_REMATCH[1]}"; root="${p%/pfx}"
            name="$(awk -F'\t' -v i="$id" '$1 == i { print $2; exit }' <<<"$games")"
            if [[ -z "$name" ]]; then
                local lib="${p%/steamapps/compatdata/*}" m
                m="$lib/steamapps/appmanifest_$id.acf"
                if [[ -f "$m" ]]; then name="$(vdf_get "$m" AppState name)"; kind=tool
                elif [[ "$id" == 0 ]]; then name="Steam (shared, non-Steam shortcuts)"; kind=shared
                else name="uninstalled app $id"; kind=orphan; fi
            fi
            ver="$(cat "$root/version" 2>/dev/null)"
        else
            local un; un="$(umbral_json | jq -r --arg p "$p" '(.prefixes // [])[] | select((.path | rtrimstr("/")) == $p) | .name' 2>/dev/null | head -1)"
            [[ -n "$un" ]] && { owner=umbral; name="$un"; }
            [[ -z "$un" ]] && case "$p" in
                */Heroic/Prefixes/*) owner=heroic ;;
                */bottles/bottles/*) owner=bottles ;;
                "$fdir"/*) [[ -n "$fdir" ]] && owner=faugus ;;
            esac
            ver="$(cat "$p/version" 2>/dev/null)"
        fi
        size="$(dir_bytes "$root")"
        used="$(stat -c %Y "$p/system.reg" 2>/dev/null || echo 0)"
        arch="$(grep -m1 -oE '^#arch=win(32|64)' "$p/system.reg" 2>/dev/null | cut -d= -f2)"
        printf '%s\n' "$p" "$root" "$owner" "$id" "$name" "$kind" "$size" "$used" "${arch:-?}" "$ver" \
            "$(prefix_in_use "$p" && echo 1 || echo 0)"
    done < <(prefix_roots) | jq -Rn '[inputs] as $l | [range(0; $l|length; 11) as $i |
        {path:$l[$i], root:$l[$i+1], owner:$l[$i+2], id:$l[$i+3], name:$l[$i+4], kind:$l[$i+5],
         size:($l[$i+6]|tonumber), lastUsed:($l[$i+7]|tonumber), arch:$l[$i+8], version:$l[$i+9],
         running:($l[$i+10] == "1"), orphan:($l[$i+5] == "orphan")}] | sort_by(-.size)
        | {prefixes:., total:(map(.size) | add // 0), orphanBytes:(map(select(.orphan) | .size) | add // 0)}'
}

# only prefixes the deck found can be acted on (never an arbitrary path)
prefix_lookup() {   # path → its JSON entry
    local p; p="$(readlink -f "$1" 2>/dev/null)"
    [[ -n "$p" ]] || return 1
    cmd_prefixes | jq -ce --arg p "$p" '.prefixes[] | select(.path == $p or .root == $p)'
}

prefix_backup() {   # entry-json → prints archive path
    local e="$1" root name out
    root="$(jq -r .root <<<"$e")"; name="$(jq -r '.owner + "-" + (.name | gsub("[^A-Za-z0-9._-]+"; "_"))' <<<"$e")"
    mkdir -p "$PREFIX_BACKUPS"
    out="$PREFIX_BACKUPS/$name-$(date +%Y%m%d-%H%M%S).tar.zst"
    log "→ Backing up $(human "$(jq -r .size <<<"$e")") to ${out/#$HOME/\~}…" >&2
    if have zstd; then tar -C "${root%/*}" -I 'zstd -T0 -3' -cf "$out" "${root##*/}"
    else out="${out%.zst}.gz"; tar -C "${root%/*}" -czf "$out" "${root##*/}"; fi || { err "backup failed"; rm -f "$out"; return 4; }
    echo "$out"
}

# prefix backup|clone|delete|restore …
cmd_prefix() {
    local sub="$1" e root out dest
    case "$sub" in
        backup|clone|delete)
            e="$(prefix_lookup "$2")" || { err "not a prefix Control Deck knows: $2"; return 2; }
            [[ "$(jq -r .running <<<"$e")" == true ]] && { err "the prefix is in use: close the game/app first"; return 3; }
            root="$(jq -r .root <<<"$e")" ;;
    esac
    case "$sub" in
        backup)
            out="$(prefix_backup "$e")" || return 4
            log "✔ Backup: ${out/#$HOME/\~} ($(human "$(stat -c %s "$out")"))"
            history_add "prefix backup" "$(jq -r .owner <<<"$e")" "$(jq -r .name <<<"$e")" 0 ;;
        clone)
            dest="${3:-$HOME/Games/prefixes/$(jq -r '.name | gsub("[^A-Za-z0-9._-]+"; "_")' <<<"$e")-clone}"
            [[ "$dest" == "$HOME"/* ]] || { err "clones go inside your home folder"; return 2; }
            [[ -e "$dest" ]] && { err "$dest already exists"; return 2; }
            mkdir -p "${dest%/*}"
            # a Steam prefix's Wine prefix is its pfx/ folder
            log "→ Cloning to ${dest/#$HOME/\~} (reflink: instant on Btrfs)…"
            cp -a --reflink=auto "$(jq -r .path <<<"$e")" "$dest" || { err "clone failed"; rm -rf "$dest"; return 4; }
            log "✔ Clone ready: WINEPREFIX=$dest"
            history_add "prefix clone" "$(jq -r .owner <<<"$e")" "$(jq -r .name <<<"$e")" 0 ;;
        delete)
            if [[ "$3" != --no-backup ]]; then out="$(prefix_backup "$e")" || return 4; log "→ Backup kept: ${out/#$HOME/\~}"; fi
            # Steam libraries may live on other drives: there only …/steamapps/compatdata/<appid>
            if [[ "$(jq -r .owner <<<"$e")" == steam ]]; then
                [[ "$root" =~ /steamapps/compatdata/[0-9]+$ ]] || { err "refusing to delete $root"; return 3; }
            else
                [[ "$root" == "$HOME"/* && "$root" != "$HOME" ]] || { err "refusing to delete outside your home"; return 3; }
            fi
            rm -rf -- "$root" || { err "delete failed"; return 4; }
            log "✔ Deleted ${root/#$HOME/\~} ($(human "$(jq -r .size <<<"$e")")).$([[ "$(jq -r .owner <<<"$e")" == steam ]] && echo " Steam recreates it the next time the game starts.")"
            history_add "prefix delete" "$(jq -r .owner <<<"$e")" "$(jq -r .name <<<"$e")" 0 ;;
        restore)
            local arch="$2"; dest="$3"
            [[ -f "$arch" && "$arch" == "$PREFIX_BACKUPS"/* ]] || { err "not a Control Deck prefix backup: $arch"; return 2; }
            [[ -n "$dest" && "$dest" == "$HOME"/* ]] || { err "use: prefix restore <backup> <new folder in your home>"; return 2; }
            [[ -e "$dest" ]] && { err "$dest already exists"; return 2; }
            mkdir -p "$dest"
            tar -xf "$arch" -C "$dest" --strip-components=1 || { err "restore failed"; rm -rf "$dest"; return 4; }
            log "✔ Restored into ${dest/#$HOME/\~}"
            history_add "prefix restore" wine "${arch##*/}" 0 ;;
        backups)
            find "$PREFIX_BACKUPS" -maxdepth 1 -type f -name '*.tar.*' -printf '%T@\t%s\t%p\n' 2>/dev/null | sort -rn \
                | jq -Rn '[inputs | split("\t") | {date:(.[0]|tonumber|floor), size:(.[1]|tonumber), path:.[2]}]' ;;
        *) err "use: prefix backup|clone|delete <path> · prefix restore <backup> <dest> · prefix backups"; return 2 ;;
    esac
}

# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
control-deck — app installer and manager (Arch/CachyOS)
Usage: control-deck <command> [args]

Install
  detect <file>                 Detected type and whether it can be installed
  install <file>                Install AppImage · pkg.tar.* · flatpak · tar.* · deb (debtap)
  installmany <files…>          Install several files in a queue
  fetch <url>                   Download a URL and print the local path
  search <text|github-repo>     Search repos · AUR · Flatpak (or a GitHub repo's releases)
  installpkg <src> <id> [rem]   Install a search result (repo|aur|flatpak|github)
  ghreleases <owner/repo>       Installable files of the latest release
  aurreview <pkg>               AUR metadata + PKGBUILD + security findings (JSON)
  aurscan <PKGBUILD> [.install] Security findings of a local PKGBUILD (JSON)

Manage
  list                          Menu apps (JSON)
  sizes                         Disk usage per app: program + user data (JSON)
  appinfo <.desktop>            Details of one app
  edit <.desktop> KEY=VAL…      NAME ICON EXEC CATEGORIES COMMENT NODISPLAY TERMINAL
  uninstall <.desktop> [--purge]  Uninstall (--purge also deletes its user data)
  leftovers <.desktop>          Data/config that --purge would delete
  rmpreview <.desktop>          What pacman -Rns would remove
  launch <.desktop>             Launch the app and diagnose it if it fails to start
  fix <.desktop> <fix>          repo:<package> · chmod · extractrun · nosandbox
  opendir|copyexec <.desktop>   Open its folder · copy its command
  autostart <.desktop> on|off|status   Start the app at login (opt-in)
  fpperms <appid>               Flatpak permissions (JSON)
  fpset <appid> <perm> on|off   network wayland x11 audio bluetooth devices home host downloads
  fpreset <appid>               Drop your permission overrides

Maintain
  updates                       Pending updates (JSON)
  update <src> <id>             Update one (repo = whole system)
  updateall                     Update everything
  timer on [hours]|off|status   Background update check with notifications (opt-in)
  cleanscan / clean <id>        Clean-up: orphans pkgcache flatpak aurcache downloads broken shaders prefixes protons
  export [file] / restore <file>   Backup of your apps
  history                       Operation history (JSON)
  news                          Recent Arch news; unread = since your last upgrade (JSON)
  snapstatus / snaplist [--root]   Snapper status / snapshots (JSON)
  snapcreate <description>      Create a snapshot (pkexec)
  snapdiff <number>             Packages changed since a snapshot
  snapdelete <n|from-to>…       Delete snapshots (pkexec)
  snapcleanup                   Apply snapper's cleanup rules now (pkexec)
  snaplimits                    Cleanup limits of the snapper config
  snapallow                     Let your user list snapshots without a password (opt-in)
  version / selfupdate          Installed version · update Control Deck itself

Gaming
  games                         Installed games (Steam) with profile/launch/Proton state (JSON)
  gstatus                       gamemode, CPU governor, vm.max_map_count, running games (JSON)
  gprofile get|set|reset <key>  Per-game profile: gamemode mangohud overlay ionice nice env prefix args
  run [--profile <key>] -- cmd  Launch a game with its profile (Steam: "control-deck run %command%")
  steamwrap <appid> on|off      Launch a Steam game through Control Deck (Steam must be closed)
  compattools                   Proton versions Steam can use (JSON)
  steamcompat <appid> <tool|default>   Proton version for a game (Steam must be closed)
  protondb <appid…>             ProtonDB summary per game, cached 24 h (JSON)
  gamejoin                      Join the gamemode group (one-time, pkexec)
  pdbindex update [--force]|status   Index ProtonDB's open data (all games' launch options)
  gsuggest <appid>              Launch options players use for a game, with shares (JSON)
  gtips <appid…> / gseen <key>  Suggestion counts per game · mark a new game as seen
  gplay <key>                   Start a game (steam:<appid> via Steam, umbral:<id> via Umbral)
  shadercache                   Shader caches per game + driver caches, stale/orphan detection (JSON)
  shaderclean <target> [part]   steam:<appid> [driver|all] · orphans · stale · global:<id>
  bench get|set|run|restore|clear steam:<appid> …   A/B benchmark with MangoHud frame logs
  prefixes                      Wine/Proton prefixes (Steam, Heroic, Faugus, Bottles, standalone) (JSON)
  prefix backup|clone|delete <path> [dest|--no-backup] · prefix restore <backup> <dest> · prefix backups
  fx status [key] | install | packages | package <idx> | search <name> | presets <sfx id> | key <Home|Insert|F10|F11|F12>
  fx scan [--cached] / fx autoinstall [key…]   Every game: best preset + ReShade compatibility; set up ReShade for the eligible ones
     fx set <key> builtin:<sharpen|sharpen-aa|fxaa|clarity> | sfx:<preset id> | off   Visual shaders (vkBasalt)
  temps [pid] / overlay [pid]   CPU/GPU °C · on-screen temperature line until <pid> exits (no pid: 10 s preview)
  health                        Gaming health: multilib, GPU driver, Vulkan, 32-bit libraries, with fix commands (JSON)
